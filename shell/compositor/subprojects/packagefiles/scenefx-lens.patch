+
+// Liquid Glass lens (Gill(OS)): near the edges, the glass bends what is behind it
+uniform float lens;   // width of the bending band in pixels (0 = off)
+uniform vec2 tex_px;  // one pixel in texture coordinates
 #endif
 
 uniform bool discard_transparent;
 
+vec2 lens_uv() {
+#if EFFECTS
+	if (lens > 0.0) {
+		vec2 rel = gl_FragCoord.xy - position;
+		float edge = min(min(rel.x, size.x - rel.x), min(rel.y, size.y - rel.y));
+		float band = min(lens, 0.5 * min(size.x, size.y));
+		if (edge >= 0.0 && edge < band) {
+			float t = 1.0 - edge / band;
+			vec2 to_centre = 0.5 * size - rel;
+			float len = max(length(to_centre), 1.0);
+			// pull the picture in from the edge, strongest right at the rim (a convex glass edge)
+			vec2 shift = to_centre / len * band * 0.45 * t * t;
+			return v_texcoord + vec2(shift.x, -shift.y) * tex_px;
+		}
+	}
+#endif
+	return v_texcoord;
+}
+
 vec4 sample_texture() {
+	vec2 uv = lens_uv();
 #if SOURCE == SOURCE_TEXTURE_RGBA || SOURCE == SOURCE_TEXTURE_EXTERNAL
-	return texture2D(tex, v_texcoord);
+	return texture2D(tex, uv);
 #elif SOURCE == SOURCE_TEXTURE_RGBX
-	return vec4(texture2D(tex, v_texcoord).rgb, 1.0);
+	return vec4(texture2D(tex, uv).rgb, 1.0);
 #endif
 }
 
