[Unit]
Description=Gill-OSaab cloud drive %i (shows in Files as Cloud/%i)
After=network-online.target

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/Cloud/%i
ExecStart=/usr/bin/rclone mount %i: %h/Cloud/%i --vfs-cache-mode full --vfs-cache-max-size 5G --dir-cache-time 1m
ExecStop=/usr/bin/fusermount3 -u %h/Cloud/%i
ExecStopPost=-/usr/bin/rmdir %h/Cloud/%i %h/Cloud
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
