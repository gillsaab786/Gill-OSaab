<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Gill(OS)</vendor>
  <action id="org.gillosaab.session-select">
    <description>Switch between the desktop and Game Mode</description>
    <message>Switching session</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/gill-osaab/gosaab-session-select-root</annotate>
  </action>
  <action id="org.gillosaab.android">
    <description>Install or remove Android (Waydroid)</description>
    <message>Setting up Android apps</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/gosaab-android-setup</annotate>
  </action>
</policyconfig>
