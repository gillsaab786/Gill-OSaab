#!/usr/bin/python3
"""Register this PC with Google so Play Store can sign in (one time, after Android is set up).

Google only lets "certified" devices sign in to Play Store. Waydroid isn't certified, but Google
lets you register your own device: this window starts Android, reads its device ID, copies it for
you, opens Google's page, and restarts Android when you're done."""
import subprocess
import sys
import time
from pathlib import Path

from PySide6.QtCore import QThread, Qt, Signal, QUrl
from PySide6.QtGui import QDesktopServices, QFont, QGuiApplication
from PySide6.QtWidgets import QApplication, QHBoxLayout, QLabel, QPushButton, QVBoxLayout, QWidget

URL = "https://www.google.com/android/uncertified"
DONE = Path.home() / ".config/gill-osaab/android-registered"
HELPER = "/usr/libexec/gill-osaab/gosaab-android-id"


def session_running():
    r = subprocess.run(["waydroid", "status"], capture_output=True, text=True, check=False)
    return "RUNNING" in r.stdout.split("Session", 1)[-1].splitlines()[0] if "Session" in r.stdout else False


def read_id():
    r = subprocess.run(["pkexec", HELPER], capture_output=True, text=True, check=False)
    value = r.stdout.strip()
    return value if value.isdigit() else ""


class Finder(QThread):
    """Start Android if needed, then wait for Google services to create the ID (first boot ~1 min)."""
    status = Signal(str)
    found = Signal(str)

    def run(self):
        if not session_running():
            self.status.emit("Starting Android…")
            subprocess.Popen(["waydroid", "session", "start"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        deadline = time.time() + 300
        while time.time() < deadline:
            value = read_id()
            if value:
                self.found.emit(value)
                return
            self.status.emit("Waiting for Google services to start (about a minute the first time)…")
            time.sleep(5)
        self.status.emit("Android didn't create its ID. Open Play Store once, then try again.")


class Window(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Register with Google Play")
        self.setMinimumWidth(520)
        self.setStyleSheet("QWidget { background: #1c1c1e; color: #f2f2f7; font-size: 15px; }"
                           "QPushButton { background: #2c2c2e; border-radius: 10px; padding: 10px 16px; }"
                           "QPushButton#primary { background: #0a84ff; color: white; }"
                           "QPushButton:disabled { color: #636366; }")
        lay = QVBoxLayout(self)
        lay.setContentsMargins(28, 24, 28, 24)
        lay.setSpacing(14)
        title = QLabel("Let Play Store sign in")
        title.setFont(QFont("Inter", 20, QFont.DemiBold))
        lay.addWidget(title)
        intro = QLabel("Google needs this PC's Android ID once. Copy it, paste it on Google's page "
                       "(sign in with the same Google account), then come back here.")
        intro.setWordWrap(True)
        lay.addWidget(intro)
        self.id_label = QLabel("…")
        self.id_label.setFont(QFont("JetBrains Mono, monospace", 22))
        self.id_label.setTextInteractionFlags(Qt.TextSelectableByMouse)
        self.id_label.setAlignment(Qt.AlignCenter)
        self.id_label.setStyleSheet("background: #2c2c2e; border-radius: 12px; padding: 14px;")
        lay.addWidget(self.id_label)
        self.status = QLabel("")
        self.status.setWordWrap(True)
        self.status.setStyleSheet("color: #8e8e93;")
        lay.addWidget(self.status)
        row = QHBoxLayout()
        self.copy_btn = QPushButton("1. Copy ID")
        self.copy_btn.clicked.connect(self.copy)
        self.open_btn = QPushButton("2. Open Google's page")
        self.open_btn.clicked.connect(lambda: QDesktopServices.openUrl(QUrl(URL)))
        self.done_btn = QPushButton("3. Done – restart Android")
        self.done_btn.setObjectName("primary")
        self.done_btn.clicked.connect(self.done)
        for b in (self.copy_btn, self.open_btn, self.done_btn):
            b.setEnabled(False)
            row.addWidget(b)
        lay.addLayout(row)
        self.android_id = ""
        self.finder = Finder()
        self.finder.status.connect(self.status.setText)
        self.finder.found.connect(self.found)
        self.finder.start()

    def found(self, value):
        self.android_id = value
        self.id_label.setText(value)
        self.status.setText("Copy the ID, paste it on Google's page and tap Register.")
        for b in (self.copy_btn, self.open_btn, self.done_btn):
            b.setEnabled(True)
        self.copy()

    def copy(self):
        QGuiApplication.clipboard().setText(self.android_id)
        self.status.setText("ID copied. Paste it on Google's page.")

    def done(self):
        DONE.parent.mkdir(parents=True, exist_ok=True)
        DONE.write_text(self.android_id + "\n")
        subprocess.run(["waydroid", "session", "stop"], check=False, capture_output=True)
        subprocess.Popen(["waydroid", "session", "start"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        self.status.setText("Android restarted. Google takes 10–30 minutes to accept the ID; then open Play "
                            "Store and sign in. If it still says the device isn't certified, restart Android "
                            "again later.")
        self.done_btn.setEnabled(False)


def main():
    if "--id" in sys.argv:  # for scripts: just print the ID
        print(read_id())
        return 0
    app = QApplication(sys.argv)
    app.setDesktopFileName("gosaab-android-register")
    w = Window()
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
