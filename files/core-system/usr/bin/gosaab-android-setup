#!/bin/sh
# One-time Android (Waydroid) setup for Gill(OS) Core: Android with Google Play, each app in
# its own resizable window, and ARM translation so phone-only (ARM) apps run on AMD/Intel.
if [ "$(id -u)" != 0 ]; then
  exec foot -T "Set up Android apps" -e sh -c 'pkexec /usr/bin/gosaab-android-setup; echo; read -p "Press Enter to close." x'
fi
# gosaab-android-setup --remove : uninstall Android and all Android apps and their data
if [ "${1:-}" = "--remove" ]; then
  user=$(id -nu "${PKEXEC_UID:-0}" 2>/dev/null)
  home=$(getent passwd "$user" | cut -d: -f6)
  case "$home" in /home/*|/var/home/*) ;; *) echo "unknown user"; exit 2 ;; esac
  waydroid session stop 2>/dev/null || true
  systemctl disable --now waydroid-container.service gosaab-android-folders.service 2>/dev/null || true
  umount "$home/Android" 2>/dev/null; umount "$home/.local/share/waydroid/data/media/0/Download" 2>/dev/null
  rm -rf /var/lib/waydroid /etc/waydroid-extra "$home/.local/share/waydroid" "$home/Android"
  rm -f "$home"/.local/share/applications/waydroid.*.desktop
  echo "Android removed"
  exit 0
fi
set -e
user=$(logname 2>/dev/null || echo "${SUDO_USER:-${PKEXEC_UID:+$(id -nu "$PKEXEC_UID")}}")
echo "1/4 Downloading Android (about 1 GB)..."
waydroid init -s GAPPS -f
systemctl enable gosaab-android-folders.service 2>/dev/null || true
systemctl enable --now waydroid-container.service
echo "2/4 Each Android app gets its own window"
cfg=/var/lib/waydroid/waydroid.cfg
grep -q '^\[properties\]' "$cfg" || printf '\n[properties]\n' >> "$cfg"
sed -i '/^persist.waydroid.multi_windows/d' "$cfg"
sed -i '/^\[properties\]/a persist.waydroid.multi_windows = true' "$cfg"
waydroid upgrade -o || true
echo "3/4 ARM translation for phone-only apps (libndk)"
tmp=$(mktemp -d)
# pinned to a reviewed version: this runs as admin, so never "whatever is newest" from the internet
WS_COMMIT=4a50dabd97fcb632a608b1421105258862a5b994
if git clone -q https://github.com/casualsnek/waydroid_script "$tmp/ws" 2>/dev/null && \
   git -C "$tmp/ws" checkout -q "$WS_COMMIT" 2>/dev/null; then
  python3 -m venv "$tmp/venv" && "$tmp/venv/bin/pip" -q install -r "$tmp/ws/requirements.txt" &&
    "$tmp/venv/bin/python" "$tmp/ws/main.py" install libndk || echo "   (skipped: translation could not be installed)"
fi
rm -rf "$tmp"
systemctl restart gosaab-android-folders.service || true
echo "4/4 Done. Android files: the Android folder in your home."
echo "Done. Open an .apk to install it, or open Play Store from Launchpad."
echo "Google Play needs a one-time device registration: https://www.google.com/android/uncertified"
