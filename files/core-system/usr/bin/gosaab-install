#!/usr/bin/python3
"""Install Gill(OS) on this PC's own drive, encrypted.

  gosaab-install                       guided install (asks which drive, then for a password)
  gosaab-install --list                drives you can install to (JSON)
  gosaab-install --live                exit 0 when running from a USB stick
  gosaab-install DISK [--no-encrypt] [--dry-run] [--yes] [--password-stdin]

The whole system drive is encrypted (LUKS2). It unlocks with this device's security chip (TPM2);
after the first start you add a start-up PIN and a recovery key (Settings > Apps & Security), so
someone who takes the drive or the device can't read your files.
Everything on DISK is erased.
"""
import ctypes
import getpass
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile
import threading
import time

MIN_BYTES = 30 * 10 ** 9
USER_FILE = "gill-osaab-user.json"  # read once on the first start, then deleted
LOG_DIR = "/var/log/gill-osaab"
LOG_NAME = "install.log"            # every command and its output
SUMMARY_NAME = "install.json"       # result, steps and times (Settings > Problems > Install summary)
DOWNLOAD_GUESS = 5.5e9              # compressed image, when the registry can't be asked
WRITE_GUESS = 13e9                  # installed size, when podman can't say


class Recorder:
    """Shows progress (\"@@progress PCT TEXT\" lines for the graphical installer, a bar in a terminal)
    and keeps the install log and summary so they can be read later in Settings > Problems."""

    def __init__(self, log_dir=LOG_DIR, dry=False):
        self.dry, self.started, self.steps, self.pct = dry, time.time(), [], -1
        self.summary = {"result": "running", "started": int(self.started)}
        self.log_dir = log_dir
        self.log = None
        try:
            os.makedirs(log_dir, exist_ok=True)
            self.log = open(os.path.join(log_dir, LOG_NAME), "w", buffering=1)
        except OSError:
            pass
        self.tty = sys.stdout.isatty()

    def line(self, text):
        if self.log:
            self.log.write(time.strftime("%H:%M:%S ") + text + "\n")
        if not self.tty:
            print(text, flush=True)

    def progress(self, pct, text):
        pct = max(0, min(100, int(pct)))
        if pct == self.pct and not text:
            return
        self.pct = pct
        if self.tty:
            bar = "█" * (pct // 4) + "░" * (25 - pct // 4)
            print(f"\r  {bar} {pct:3d}%  {text[:40]:<40}", end="", flush=True)
        else:
            print(f"@@progress {pct} {text}", flush=True)

    def step(self, name):
        self.end_step(True)
        self.steps.append({"name": name, "ok": None, "start": time.time()})
        self.line(f"== {name}")

    def end_step(self, ok):
        if self.steps and self.steps[-1]["ok"] is None:
            st = self.steps[-1]
            st["ok"], st["seconds"] = ok, round(time.time() - st.pop("start"))

    def finish(self, ok, error=""):
        self.end_step(ok)
        self.summary.update(result="ok" if ok else "failed", error=error, finished=int(time.time()),
                            seconds=round(time.time() - self.started),
                            steps=[{k: v for k, v in s.items() if k != "start"} for s in self.steps])
        self.save()
        if self.tty:
            print()

    def save(self, folder=None):
        try:
            with open(os.path.join(folder or self.log_dir, SUMMARY_NAME), "w") as fh:
                json.dump(self.summary, fh, indent=1)
        except OSError:
            pass


REC = None  # the current Recorder (set in main)


def say(text):
    if REC:
        REC.line(text)
    else:
        print(text, flush=True)


def sh(cmd, dry=False, watch=None, **kw):
    """Run cmd, keep its output in the log; watch=(measure, total, start%, end%, text) moves the bar."""
    say("+ " + " ".join(cmd))
    if dry:
        if watch:
            REC.progress(watch[3], watch[4])
        return 0
    if REC is None:
        return subprocess.run(cmd, check=False, **kw).returncode
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    reader = threading.Thread(target=lambda: [say(l.rstrip("\r\n").split("\r")[-1]) for l in proc.stdout],
                              daemon=True)
    reader.start()
    if watch:
        measure, total, lo, hi, text = watch
        base = measure()
        while proc.poll() is None:
            done = max(0, measure() - base)
            REC.progress(lo + (hi - lo) * min(done / max(total, 1), 0.98), text)
            time.sleep(1)
    rc = proc.wait()
    reader.join(5)
    say(f"(exit {rc})")
    return rc


# ------------------------------------------------------------------ measuring progress
def os_version():
    try:
        rel = dict(l.split("=", 1) for l in open("/usr/lib/os-release").read().splitlines() if "=" in l)
    except OSError:
        return ""
    return (rel.get("IMAGE_VERSION") or rel.get("VERSION") or "").strip('"')


def net_received():
    total = 0
    for nic in os.listdir("/sys/class/net") if os.path.isdir("/sys/class/net") else []:
        if nic == "lo":
            continue
        try:
            total += int(open(f"/sys/class/net/{nic}/statistics/rx_bytes").read())
        except (OSError, ValueError):
            pass
    return total


def disk_written(disk):
    """Bytes written to DISK since boot (/sys/block/NAME/stat, field 7 is sectors written)."""
    try:
        name = os.path.basename(os.path.realpath(disk))
        return int(open(f"/sys/block/{name}/stat").read().split()[6]) * 512
    except (OSError, ValueError, IndexError):
        return 0


def download_size(image):
    try:
        info = json.loads(out(["skopeo", "inspect", f"docker://{image}"]))
        return sum(l.get("Size") or 0 for l in info.get("LayersData") or []) or DOWNLOAD_GUESS
    except ValueError:
        return DOWNLOAD_GUESS


def image_size(image):
    try:
        return int(out(["podman", "image", "inspect", "--format", "{{.Size}}", image])) or WRITE_GUESS
    except ValueError:
        return WRITE_GUESS


def out(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, check=False).stdout.strip()
    except OSError:
        return ""


# ------------------------------------------------------------------ drives
def boot_disk():
    """The drive Gill(OS) is running from right now (never offered)."""
    src = out(["findmnt", "-no", "SOURCE", "/sysroot"]) or out(["findmnt", "-no", "SOURCE", "/"])
    src = src.split("[")[0]
    if not src:
        return ""
    if src.startswith("/dev/mapper/"):
        status = out(["cryptsetup", "status", src])
        m = re.search(r"device:\s+(\S+)", status)
        src = m.group(1) if m else src
    parent = out(["lsblk", "-no", "PKNAME", src]).splitlines()
    return "/dev/" + parent[0] if parent and parent[0] else src


def candidate_disks(lsblk_json, booted):
    try:
        devs = json.loads(lsblk_json).get("blockdevices", [])
    except ValueError:
        return []
    disks = []
    for d in devs:
        path = d.get("path") or "/dev/" + d.get("name", "")
        if d.get("type") != "disk" or re.match(r"/dev/(loop|zram|sr|ram)", path) or path == booted:
            continue
        size = int(d.get("size") or 0)
        disks.append({"path": path, "size": size, "model": (d.get("model") or "").strip(),
                      "transport": d.get("tran") or "", "removable": bool(int(d.get("rm") or 0)),
                      "big_enough": size >= MIN_BYTES})
    return disks


def list_disks():
    return candidate_disks(out(["lsblk", "-J", "-b", "-d", "-o", "NAME,PATH,SIZE,MODEL,TRAN,RM,TYPE"]), boot_disk())


def has_tpm():
    return os.path.exists("/dev/tpmrm0") or os.path.exists("/sys/class/tpm/tpm0")


# ------------------------------------------------------------------ the account to carry over
def hash_password(password):
    lib = ctypes.CDLL("libcrypt.so.2")
    lib.crypt_gensalt.restype = ctypes.c_char_p
    lib.crypt_gensalt.argtypes = [ctypes.c_char_p, ctypes.c_ulong, ctypes.c_char_p, ctypes.c_int]
    lib.crypt.restype = ctypes.c_char_p
    lib.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
    salt = lib.crypt_gensalt(b"$y$", 0, None, 0)
    return lib.crypt(password.encode(), salt).decode()


def account_record(name, password_hash):
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", name) or not password_hash.startswith("$"):
        raise ValueError("bad account")
    try:
        gecos = pwd.getpwnam(name).pw_gecos.split(",")[0]
    except KeyError:
        gecos = name
    return {"name": name, "hash": password_hash, "full_name": gecos}


def image_ref(nvidia=None):
    """The edition to install: this one, or the Nvidia edition when an RTX/GTX 16 card is present."""
    try:
        st = json.loads(out(["bootc", "status", "--json"]))
        ref = st["status"]["booted"]["image"]["image"]["image"]
    except (ValueError, KeyError, TypeError):
        ref = "ghcr.io/gillsaab786/gill-osaab-core:latest"
    if nvidia is None:
        try:
            sys.path.insert(0, "/usr/libexec/gill-osaab")
            import gosaab_gpu
            nvidia = gosaab_gpu.nvidia_needs_driver(gosaab_gpu.gpus())
        except Exception:
            nvidia = False
    return nvidia_variant(ref) if nvidia else ref


def nvidia_variant(ref):
    head, _, tag = ref.rpartition(":")
    if not head or "/" in tag:
        head, tag = ref, "latest"
    return ref if head.endswith("-nvidia") else f"{head}-nvidia:{tag}"


def install_command(image, disk, encrypt):
    cmd = ["podman", "run", "--rm", "--pull=never", "--privileged", "--pid=host", "-v", "/dev:/dev",
           "-v", "/var/lib/containers:/var/lib/containers", "--security-opt", "label=type:unconfined_t",
           image, "bootc", "install", "to-disk", "--wipe", "--filesystem", "btrfs"]
    if encrypt:
        cmd += ["--block-setup", "tpm2-luks"]
    return cmd + [disk]


def write_account(disk, record, dry=False):
    """Put the account where the new system finds it on its first start (the unencrypted /boot, briefly),
    with the install log and summary (moved to /var/log/gill-osaab on that start)."""
    if dry:
        say(f"+ write /boot/{USER_FILE} on {disk} for {record['name']}")
        return 0
    sh(["udevadm", "settle"])
    parts = out(["lsblk", "-lno", "PATH,LABEL", disk]).splitlines()
    boot = next((p.split()[0] for p in parts if p.split()[1:] == ["boot"]), "")
    if not boot:
        print("couldn't find the new /boot partition", file=sys.stderr)
        return 1
    with tempfile.TemporaryDirectory() as mnt:
        if sh(["mount", boot, mnt]) != 0:
            return 1
        try:
            path = os.path.join(mnt, USER_FILE)
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as fh:
                json.dump(record, fh)
            if REC:
                REC.finish(True)
                REC.save(mnt)
                if REC.log:
                    REC.log.flush()
                    with open(os.path.join(REC.log_dir, LOG_NAME), "rb") as src, \
                            open(os.path.join(mnt, "gill-osaab-" + LOG_NAME), "wb") as dst:
                        dst.write(src.read())
                os.rename(os.path.join(mnt, SUMMARY_NAME), os.path.join(mnt, "gill-osaab-" + SUMMARY_NAME))
        finally:
            sh(["umount", mnt])
    return 0


# ------------------------------------------------------------------ guided
def ask_disk():
    disks = [d for d in list_disks() if d["big_enough"]]
    if not disks:
        print("No drive big enough (30 GB or more) was found besides the one Gill(OS) is running from.")
        return ""
    print("Drives you can install Gill(OS) on (EVERYTHING ON IT WILL BE ERASED):\n")
    for i, d in enumerate(disks, 1):
        kind = "removable" if d["removable"] else (d["transport"] or "internal")
        print(f"  {i}. {d['path']}  {d['size'] / 1e9:.0f} GB  {d['model']}  ({kind})")
    choice = input("\nNumber of the drive (Enter to cancel): ").strip()
    if not choice.isdigit() or not 1 <= int(choice) <= len(disks):
        return ""
    return disks[int(choice) - 1]["path"]


def ask_password(user):
    print(f"\nChoose the password for {user} on the installed system (at least 8 characters).")
    while True:
        p1 = getpass.getpass("Password: ")
        if len(p1) < 8 or p1.lower() in ("gill", "password", "12345678", user):
            print("Too easy to guess – try another.")
            continue
        if getpass.getpass("Again: ") == p1:
            return p1
        print("They didn't match.")


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv and argv[0] == "--live":  # running from a USB stick (offer to install)?
        disk = boot_disk()
        info = out(["lsblk", "-dno", "TRAN,RM", disk]).split() if disk else []
        return 0 if info and (info[0] == "usb" or info[-1] == "1") else 1
    if argv and argv[0] == "--list":
        print(json.dumps(list_disks()))
        return 0
    dry, yes, encrypt = "--dry-run" in argv, "--yes" in argv, "--no-encrypt" not in argv
    disk = next((a for a in argv if a.startswith("/dev/")), "")
    if os.geteuid() != 0 and not dry:
        os.execvp("pkexec", ["pkexec", os.path.realpath(__file__), *argv])
    if encrypt and not has_tpm() and not dry:
        print("This device has no security chip (TPM2), which the encrypted install needs.\n"
              "Turn on fTPM/PTT in the BIOS, or install without encryption: gosaab-install --no-encrypt")
        return 3
    if not disk:
        disk = ask_disk()
        if not disk:
            return 1
    if disk not in [d["path"] for d in list_disks()] and not dry:
        print(f"{disk} can't be used (it's the drive Gill(OS) is running from, or not a drive).")
        return 2
    user = os.environ.get("PKEXEC_UID") and pwd.getpwuid(int(os.environ["PKEXEC_UID"])).pw_name or \
        os.environ.get("SUDO_USER") or "gill"
    if not yes:
        if input(f"\nErase {disk} and install Gill(OS){' (encrypted)' if encrypt else ''}? Type YES: ") != "YES":
            return 1
    if "--password-stdin" in argv:  # the graphical installer passes it this way (never on the command line)
        password = sys.stdin.readline().rstrip("\n")
        if len(password) < 8:
            print("password too short")
            return 2
    else:
        password = "dry-run" if dry else ask_password(user)
    record = account_record(user, "$y$dry$run" if dry else hash_password(password))
    # a dry run never touches the real install log (Settings > Problems shows that one)
    return install(disk, encrypt, record, dry, tempfile.mkdtemp(prefix="gosaab-install-") if dry else LOG_DIR)


def install(disk, encrypt, record, dry=False, log_dir=LOG_DIR):
    global REC
    REC = Recorder(log_dir, dry)
    image = image_ref()
    model = next((d["model"] for d in list_disks() if d["path"] == disk), "")
    REC.summary.update(image=image, disk=disk, model=model, size=out(["lsblk", "-dnbo", "SIZE", disk]),
                       encrypted=encrypt, version=os_version())
    REC.save()

    def fail(msg):
        REC.finish(False, msg)
        say(msg)
        print(f"\n{msg} Nothing else was changed. See Settings > Problems > Install summary.", flush=True)
        return 1

    REC.step("Getting ready")
    REC.progress(1, "Getting ready")
    REC.step("Downloading Gill(OS)")
    total = 1 if dry else download_size(image)
    if sh(["podman", "pull", image], dry, watch=(net_received, total, 2, 40, "Downloading Gill(OS)")) != 0:
        return fail("Couldn't download Gill(OS) (check the internet).")
    REC.step("Encrypting the drive and writing Gill(OS)" if encrypt else "Writing Gill(OS) to the drive")
    total = 1 if dry else image_size(image)
    text = "Writing to the drive" + (" (encrypted)" if encrypt else "")
    if sh(install_command(image, disk, encrypt), dry, watch=(lambda: disk_written(disk), total, 40, 96, text)) != 0:
        return fail("Writing Gill(OS) to the drive failed.")
    REC.step("Setting up your account")
    REC.progress(97, "Setting up your account")
    if write_account(disk, record, dry) != 0:
        return fail("Couldn't set up your account on the new drive.")
    if dry:
        REC.finish(True)
    REC.progress(100, "Done")
    print("\nDone. Remove the USB stick and restart. After signing in, open Settings > Apps & Security and "
          "add a start-up PIN and a recovery key.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
