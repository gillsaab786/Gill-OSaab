#!/usr/bin/python3 -I
"""Gill(OS) button shortcuts, in Desktop and in Game Mode.

Watches keyboards and controllers (built-in ROG Ally / Legion Go / GPD buttons too) and, when a
combo from hotkeys.conf is pressed, runs its action as the person signed in at the screen.

Privacy: nothing typed is stored or logged; only complete combos are compared with the list, and
"record" (Settings > Buttons & Shortcuts) answers only the person at the screen, once.
"""
import os
import pwd
import select
import socket
import struct
import subprocess
import sys
import time

sys.path.insert(0, "/usr/libexec/gill-osaab")
import gosaab_hotkeys as hk  # noqa: E402

try:
    import evdev
    from evdev import ecodes
except ImportError:  # pragma: no cover
    print("python3-evdev is missing", file=sys.stderr)
    sys.exit(0)

RESCAN = 3.0


def active_user():
    """(name, uid, home) of the graphical session in front of the screen, or None."""
    def prop(*args):
        out = subprocess.run(["loginctl", *args], capture_output=True, text=True, check=False)
        return out.stdout.strip()
    sid = prop("show-seat", "seat0", "-p", "ActiveSession", "--value")
    if not sid:
        return None
    uid = prop("show-session", sid, "-p", "User", "--value")
    try:
        pw = pwd.getpwuid(int(uid))
    except (ValueError, KeyError):
        return None
    return pw.pw_name, pw.pw_uid, pw.pw_dir


class Daemon:
    def __init__(self):
        self.devices = {}
        self.matcher = hk.Matcher()
        self.user = None
        self.conf_sig = None
        self.recorder = None  # (socket, deadline)
        self.last_scan = 0
        self.server = self.listen()

    def listen(self):
        try:
            os.unlink(hk.SOCKET)
        except FileNotFoundError:
            pass
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.bind(hk.SOCKET)
        os.chmod(hk.SOCKET, 0o666)  # anyone may ask; only the person at the screen gets an answer
        s.listen(4)
        s.setblocking(False)
        return s

    # ------------------------------------------------------------ devices and config
    def scan(self):
        self.last_scan = time.monotonic()
        paths = set(evdev.list_devices())
        for path in list(self.devices):
            if path not in paths:
                self.drop(path)
        for path in paths - set(self.devices):
            try:
                dev = evdev.InputDevice(path)
            except OSError:
                continue
            keys = dev.capabilities().get(ecodes.EV_KEY, [])
            if not keys or dev.name.startswith("gosaab"):  # no buttons, or our own virtual devices
                dev.close()
                continue
            self.devices[path] = dev
        self.reload()

    def drop(self, path):
        dev = self.devices.pop(path, None)
        if dev:
            try:
                dev.close()
            except OSError:
                pass

    def reload(self):
        user = active_user()
        user_text = hk.read_user_conf(user[2], user[1]) if user else ""
        try:
            sys_text = hk.SYSTEM_CONF.read_text()
        except OSError:
            sys_text = ""
        sig = (user, sys_text, user_text)
        if sig != self.conf_sig:
            self.conf_sig, self.user = sig, user
            self.matcher.bindings = hk.effective(hk.parse_config(sys_text), hk.parse_config(user_text))

    # ------------------------------------------------------------ actions
    def fire(self, action):
        if not self.user:
            return
        name, uid, _home = self.user
        # runs as that person, in their own session (never as admin)
        subprocess.Popen(["systemd-run", "--user", f"--machine={name}@.host", "--collect", "--quiet",
                          "--", "/usr/bin/gosaab-hotkeys", "run", action],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # ------------------------------------------------------------ record (Settings)
    def accept(self):
        try:
            conn, _ = self.server.accept()
        except OSError:
            return
        creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
        _pid, uid, _gid = struct.unpack("3i", creds)
        user = active_user()
        if not user or uid != user[1] or self.recorder:
            conn.close()
            return
        conn.settimeout(1)
        try:
            request = conn.recv(64).decode(errors="ignore").strip()
        except OSError:
            request = ""
        if request != "record":
            conn.close()
            return
        self.matcher.held.clear()
        self.matcher.peak.clear()
        self.recorder = (conn, time.monotonic() + 8)

    def finish_record(self, combo):
        conn, _ = self.recorder
        self.recorder = None
        try:
            conn.sendall((combo + "\n").encode())
        except OSError:
            pass
        conn.close()

    # ------------------------------------------------------------ loop
    def handle(self, event):
        if event.type != ecodes.EV_KEY or event.value == 2:  # ignore key repeat
            return
        names = ecodes.KEY.get(event.code) or ecodes.BTN.get(event.code)
        if names is None:
            return
        name = names[0] if isinstance(names, (list, tuple)) else names
        if event.value == 1:
            action = self.matcher.press(name)
            if action and not self.recorder:
                self.fire(action)
        else:
            combo = self.matcher.release(name)
            if combo and self.recorder:
                self.finish_record(combo)

    def run(self):
        self.scan()
        while True:
            fds = {dev.fd: path for path, dev in self.devices.items()}
            try:
                ready, _, _ = select.select([self.server, *fds], [], [], 1.0)
            except (OSError, ValueError):
                self.scan()
                continue
            for fd in ready:
                if fd is self.server:
                    self.accept()
                    continue
                path = fds[fd]
                try:
                    for event in self.devices[path].read():
                        self.handle(event)
                except (OSError, KeyError):
                    self.drop(path)
            if self.recorder and time.monotonic() > self.recorder[1]:
                self.finish_record("")
            if time.monotonic() - self.last_scan > RESCAN:
                self.scan()


if __name__ == "__main__":
    Daemon().run()
