#!/usr/bin/python3 -I
"""(first start after gosaab-install) Create the account carried over from the USB, then forget it;
keep the install log and summary in /var/log/gill-osaab (Settings > Problems > Install summary)."""
import json
import os
import re
import shutil
import subprocess
import sys

PATH = "/boot/gill-osaab-user.json"
LOGS = {"/boot/gill-osaab-install.log": "install.log", "/boot/gill-osaab-install.json": "install.json"}
LOG_DIR = "/var/log/gill-osaab"


def keep_install_log(boot_files=LOGS, log_dir=LOG_DIR):
    for src, name in boot_files.items():
        if os.path.exists(src):
            try:
                os.makedirs(log_dir, exist_ok=True)
                shutil.move(src, os.path.join(log_dir, name))
            except OSError:
                pass


def main():
    keep_install_log()
    try:
        with open(PATH) as fh:
            rec = json.load(fh)
    except (OSError, ValueError):
        return 0
    name, pw_hash = rec.get("name", ""), rec.get("hash", "")
    full = re.sub(r"[:,\n]", " ", rec.get("full_name", ""))[:64]
    ok = re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", name) and re.fullmatch(r"\$[A-Za-z0-9./$]+", pw_hash)
    if ok and subprocess.run(["id", name], capture_output=True, check=False).returncode != 0:
        subprocess.run(["useradd", "-m", "-G", "wheel", "-c", full or name, "-p", pw_hash, name], check=False)
    # never leave the password hash on the unencrypted /boot
    try:
        size = os.path.getsize(PATH)
        with open(PATH, "r+b") as fh:
            fh.write(b"\0" * size)
            fh.flush()
            os.fsync(fh.fileno())
    except OSError:
        pass
    os.unlink(PATH)
    return 0


if __name__ == "__main__":
    sys.exit(main())
