#!/bin/sh
# Game Mode: Steam's big-picture UI in gamescope, like SteamOS.
export STEAM_MULTIPLE_XWAYLANDS=1 STEAM_GAMESCOPE_VRR_SUPPORTED=1 STEAM_USE_MANGOAPP=1
export STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND=1 STEAM_GAMESCOPE_HDR_SUPPORTED=1
# best FPS settings for this graphics chip (DLSS / FSR 4 / XeSS upgrades, Smooth Motion): see gosaab-fps
gosaab-fps apply >/dev/null 2>&1
fps_env="$HOME/.config/environment.d/60-gill-osaab-fps.conf"
[ -f "$fps_env" ] && { set -a; . "$fps_env"; set +a; }
# two graphics chips: Game Mode (Steam and its games) runs on the dedicated one
eval "$(gosaab-gpu env-sh 2>/dev/null)"
# a Game Mode <-> Desktop switch signs in automatically once; put sign-in back to the boot choice
(sleep 5; pkexec /usr/libexec/gill-osaab/gosaab-session-select-root --restore "$USER" >/dev/null 2>&1) &
/usr/libexec/gill-osaab/gosaab-activity watch &
/usr/libexec/gill-osaab/gosaab-haptic serve & # controller buzz for switches and sliders
# notifications + progress for the Decky plugin (Steam's Game Mode has no notification panel)
/usr/libexec/gill-osaab/gosaab-notify-hub --force &
# Gill(OS) startup movie (Steam plays uioverrides/movies/deck_startup.webm as Game Mode starts).
# A movie you picked yourself (a different file) is left alone.
movies="$HOME/.local/share/Steam/config/uioverrides/movies"
ours=/usr/share/gill-osaab/media/deck_startup.webm
if [ -f "$ours" ] && { [ ! -e "$movies/deck_startup.webm" ] || [ -e "$movies/.gill-os" ]; }; then
  mkdir -p "$movies" && cp -f "$ours" "$movies/deck_startup.webm" && touch "$movies/.gill-os"
fi
# the switch chime, as the screen changes over
command -v pw-play >/dev/null && pw-play /usr/share/gill-osaab/media/mode-switch.wav >/dev/null 2>&1 &
# Settings > Optional Features (all off unless you turn them on)
feature() { grep -qE "^$1[[:space:]]*=[[:space:]]*(on|true|1|yes)" /etc/gill-osaab/features.conf 2>/dev/null; }
# shared game library: Windows, Android and Linux games + emulators in Steam (Steam isn't running yet)
feature shared_game_library && /usr/libexec/gill-osaab/gosaab-library sync >/dev/null 2>&1
# phone link: your phone's notifications, files and clipboard
feature phone_link && [ -x /usr/libexec/kdeconnectd ] && /usr/libexec/kdeconnectd >/dev/null 2>&1 &
vrr=""
feature vrr && vrr="--adaptive-sync"   # FreeSync / VRR on screens that support it
exec gamescope -e -f $vrr --mangoapp -- steam -gamepadui -steamos3 -steampal -steamdeck
