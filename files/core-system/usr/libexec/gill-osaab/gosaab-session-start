#!/bin/sh
# Runs inside gosaab-wm once the desktop is up: services, wallpaper, the shell UI.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP \
  XDG_SESSION_TYPE QT_QPA_PLATFORM 2>/dev/null || \
  systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
WALL=/usr/share/wallpapers/GillOSaab/contents/images_dark/3840x2160.png
[ -f "$HOME/.config/gill-osaab/wallpaper" ] && WALL=$(cat "$HOME/.config/gill-osaab/wallpaper")
swaybg -i "$WALL" -m fill &
# password prompts for system changes
for agent in /usr/libexec/lxqt-policykit-agent /usr/bin/lxqt-policykit-agent /usr/libexec/polkit-gnome-authentication-agent-1; do
  [ -x "$agent" ] && { "$agent" & break; }
done
# dim after 4 min, lock after 5 (games/videos that ask to stay awake are respected)
swayidle -w \
  timeout 240 'brightnessctl -s -q set 30%' resume 'brightnessctl -r -q' \
  timeout 300 'qs -c gill-osaab ipc call lock lock' \
  timeout 120 '/usr/libexec/gill-osaab/gosaab-activity idle on' resume '/usr/libexec/gill-osaab/gosaab-activity idle off' \
  before-sleep 'qs -c gill-osaab ipc call lock lock' &
# download/copy/install progress from any app -> notifications with progress bars
/usr/libexec/gill-osaab/gosaab-notify-hub --desktop &
# Android app notifications (incl. Play Store download progress) while Android is running
command -v waydroid >/dev/null && /usr/libexec/gill-osaab/gosaab-android-notify &
# first sign-in: Android with Play Store, Flathub, Bottles (progress in notifications)
/usr/libexec/gill-osaab/gosaab-first-setup &
# the handheld's controller works as mouse + keys on the desktop (View+Menu toggles it)
/usr/libexec/gill-osaab/gosaab-gamepad &
# best FPS settings for this graphics chip (DLSS / FSR 4 / XeSS upgrades, Smooth Motion): see gosaab-fps
gosaab-fps apply >/dev/null 2>&1
gosaab-gpu apply >/dev/null 2>&1 # games start on the dedicated graphics (PCs with two graphics chips)
for f in "$HOME/.config/environment.d/61-gill-osaab-gpu.conf"; do [ -f "$f" ] && { set -a; . "$f"; set +a; }; done
# a Game Mode <-> Desktop switch signs in automatically once; put sign-in back to the boot choice
(sleep 5; pkexec /usr/libexec/gill-osaab/gosaab-session-select-root --restore "$USER" >/dev/null 2>&1) &
/usr/libexec/gill-osaab/gosaab-activity watch & # Smart TDP: video/idle; pop-up when graphics change
/usr/libexec/gill-osaab/gosaab-haptic serve & # controller buzz for switches and sliders
mkdir -p "$HOME/.config/gill-osaab"
# Settings > Optional Features (all off unless you turn them on)
feature() { grep -qE "^$1[[:space:]]*=[[:space:]]*(on|true|1|yes)" /etc/gill-osaab/features.conf 2>/dev/null; }
feature phone_link && [ -x /usr/libexec/kdeconnectd ] && /usr/libexec/kdeconnectd >/dev/null 2>&1 &
feature shared_game_library && (pgrep -x steam >/dev/null || /usr/libexec/gill-osaab/gosaab-library sync >/dev/null 2>&1) &
# Netflix & co in Brave: protected streaming (Widevine) on, once
/usr/libexec/gill-osaab/gosaab-widevine ensure 2>/dev/null
# where this PC is, from Wi-Fi (BeaconDB) or the weather city: live wallpapers follow the real sun
( sleep 20; while true; do /usr/libexec/gill-osaab/gosaab-location >/dev/null 2>&1; sleep 10800; done ) &
# clipboard history for Spotlight (text only, kept in memory, password-manager copies skipped)
wl-paste --type text --watch /usr/libexec/gill-osaab/gosaab-clipboard store &
fps_env="$HOME/.config/environment.d/60-gill-osaab-fps.conf"
[ -f "$fps_env" ] && { set -a; . "$fps_env"; set +a; }
# the menu bar, Dock, notifications, Control Centre, Spotlight, Launchpad, lock screen
while :; do
  qs -c gill-osaab
  sleep 1 # restart the shell if it ever crashes; the desktop keeps running
done
