#!/bin/sh
# (root, at boot before the login screen) Apply "Start up in" from Settings:
# Game Mode, Desktop, or ask at the login screen. Handhelds default to Game Mode, PCs to Desktop.
STATE=/etc/gill-osaab
mode=$(cat "$STATE/boot-mode" 2>/dev/null)
user=$(cat "$STATE/boot-user" 2>/dev/null)
[ -n "$user" ] || user=$(awk -F: '$3>=1000 && $3<60000 {print $1; exit}' /etc/passwd)
if [ -z "$mode" ]; then
  product=$(cat /sys/class/dmi/id/product_name /sys/class/dmi/id/board_name 2>/dev/null | tr '\n' ' ')
  case "$product" in
    *"ROG Ally"*|*RC71L*|*RC72L*|*"G1618"*|*"G1619"*|*"Win Max"*|*"Win 4"*|*"Win Mini"*|*Jupiter*|*Galileo*|*"Legion Go"*|*"Claw"*) mode=game ;;
    *) mode=desktop ;;
  esac
fi
# handheld controls (TDP, fans, buttons) for that user
[ -n "$user" ] && systemctl list-unit-files 'hhd@.service' >/dev/null 2>&1 && systemctl enable --now "hhd@$user" 2>/dev/null
[ -n "$user" ] || exit 0
exec /usr/libexec/gill-osaab/gosaab-session-select-root --boot "$user" "$mode"
