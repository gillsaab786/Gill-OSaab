#!/bin/sh
# (root, via pkexec) Login-screen control for Gill(OS) Core.
#   gosaab-session-select-root USER gill-osaab|gill-osaab-gamemode   sign USER into that session next
#   gosaab-session-select-root --boot USER game|desktop|ask          what to start at every boot
#   gosaab-session-select-root --restore USER    after a Game Mode <-> Desktop switch has signed in:
#       put sign-in back to the boot choice, so the switch's automatic sign-in is one-time only
#       (otherwise anyone restarting the PC would land in your desktop without a password)
set -eu
CONF=/etc/sddm.conf.d/zz-gill-osaab-autologin.conf
STATE=/etc/gill-osaab
# Only for yourself: through pkexec (no password asked) you may change sign-in for your own account,
# never someone else's (or root's).
own_user_only() {
  uid=$(id -u "$1" 2>/dev/null) || { echo "unknown user" >&2; exit 2; }
  [ "$uid" -ge 1000 ] || { echo "not a regular user" >&2; exit 2; }
  if [ -n "${PKEXEC_UID:-}" ] && [ "$uid" != "$PKEXEC_UID" ]; then echo "only your own account" >&2; exit 2; fi
}
autologin() { # user session
  mkdir -p /etc/sddm.conf.d
  printf '[Autologin]\nUser=%s\nSession=%s.desktop\nRelogin=true\n' "$1" "$2" > "$CONF"
}
if [ "${1:-}" = "--restore" ]; then
  user=$2
  own_user_only "$user"
  mode=$(cat "$STATE/boot-mode" 2>/dev/null || echo ask)
  boot_user=$(cat "$STATE/boot-user" 2>/dev/null || echo "")
  case "$mode" in
    game) [ "$boot_user" = "$user" ] && autologin "$user" gill-osaab-gamemode || rm -f "$CONF" ;;
    desktop) [ "$boot_user" = "$user" ] && autologin "$user" gill-osaab || rm -f "$CONF" ;;
    *) rm -f "$CONF" ;;
  esac
  exit 0
fi
if [ "${1:-}" = "--boot" ]; then
  user=$2 mode=$3
  own_user_only "$user"
  case "$mode" in game|desktop|ask) ;; *) echo "unknown mode" >&2; exit 2 ;; esac
  mkdir -p "$STATE"
  echo "$mode" > "$STATE/boot-mode"
  echo "$user" > "$STATE/boot-user"
  case "$mode" in
    game) autologin "$user" gill-osaab-gamemode ;;
    desktop) autologin "$user" gill-osaab ;;
    ask) rm -f "$CONF" ;;
  esac
  exit 0
fi
user=$1 session=$2
case "$session" in gill-osaab|gill-osaab-gamemode) ;; *) echo "unknown session" >&2; exit 2 ;; esac
own_user_only "$user"
autologin "$user" "$session"
