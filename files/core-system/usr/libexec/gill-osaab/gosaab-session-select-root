#!/bin/sh
# (root, via pkexec) Login-screen control for Gill-OSaab Core.
#   gosaab-session-select-root USER gill-osaab|gill-osaab-gamemode   sign USER into that session next
#   gosaab-session-select-root --boot USER game|desktop|ask          what to start at every boot
set -eu
CONF=/etc/sddm.conf.d/zz-gill-osaab-autologin.conf
STATE=/etc/gill-osaab
autologin() { # user session
  mkdir -p /etc/sddm.conf.d
  printf '[Autologin]\nUser=%s\nSession=%s.desktop\nRelogin=true\n' "$1" "$2" > "$CONF"
}
if [ "${1:-}" = "--boot" ]; then
  user=$2 mode=$3
  id "$user" >/dev/null 2>&1 || { echo "unknown user" >&2; exit 2; }
  case "$mode" in game|desktop|ask) ;; *) echo "unknown mode" >&2; exit 2 ;; esac
  mkdir -p "$STATE"
  echo "$mode" > "$STATE/boot-mode"
  echo "$user" > "$STATE/boot-user"
  case "$mode" in
    game) autologin "$user" gill-osaab-gamemode ;;
    desktop) autologin "$user" gill-osaab ;;
    ask) rm -f "$CONF" ;;
  esac
  exit 0
fi
user=$1 session=$2
case "$session" in gill-osaab|gill-osaab-gamemode) ;; *) echo "unknown session" >&2; exit 2 ;; esac
id "$user" >/dev/null 2>&1 || { echo "unknown user" >&2; exit 2; }
autologin "$user" "$session"
