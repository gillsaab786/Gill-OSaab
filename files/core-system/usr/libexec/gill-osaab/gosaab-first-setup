#!/bin/sh
# First sign-in: finish setting up apps that are too big to ship inside the system image,
# with a progress notification (Liquid Glass ring in the shell). Runs once per user, retries
# next sign-in if it was interrupted (e.g. no internet).
# running from the USB stick: offer to install on the PC (every sign-in, until installed)
if gosaab-install --live 2>/dev/null; then
  notify-send -a "Gill(OS)" -i system-software-install "Install Gill(OS) on this PC?" \
    "You're running from the USB stick. Open \"Install Gill(OS)\" in Launchpad to put it on the PC's drive, encrypted." || true
fi
DONE="$HOME/.config/gill-osaab/first-setup.done"
[ -f "$DONE" ] && exit 0
mkdir -p "$(dirname "$DONE")"
id=0
progress() { # percent, title, text
  id=$(notify-send --print-id ${id:+--replace-id "$id"} -a "Gill(OS)" -i system-software-install \
       -h "int:value:$1" "$2" "$3" 2>/dev/null || echo "$id")
}
# wait for the internet (up to 10 min)
for _ in $(seq 1 120); do nm-online -q -t 5 2>/dev/null && break; sleep 5; done
nm-online -q -t 5 2>/dev/null || exit 0

progress 5 "Setting up your apps" "Adding the Flathub app store"
flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

progress 10 "Setting up your apps" "Installing Bazaar, the Linux app store (Flathub)"
flatpak install --user --noninteractive -y flathub io.github.kolunmi.Bazaar >/dev/null 2>&1 || true
progress 20 "Setting up your apps" "Installing Bottles (Windows app installers)"
flatpak install --user --noninteractive -y flathub com.usebottles.bottles >/dev/null 2>&1 || true

progress 25 "Setting up your games" "Installing GE-Proton (DLSS 4 / FSR 4 / XeSS upgrades for Windows games)"
gosaab-fps install-proton >/dev/null 2>&1 || true

# encrypted drive without a start-up PIN or recovery key: open the place to add them
if gosaab-encryption status 2>/dev/null | grep -q '"encrypted": true' && \
   gosaab-encryption status | grep -q '"recovery": false'; then
  gosaab-settings security >/dev/null 2>&1 &
fi

android=$(sed -n 's/^android=//p' /etc/gill-osaab/features.conf 2>/dev/null)
if [ "${android:-on}" = on ] && ! waydroid status 2>/dev/null | grep -qi "initialized: *yes\|Session:.*RUNNING\|Container:"; then
  progress 30 "Setting up Android" "Downloading Android with Google Play (about 1 GB)"
  pkexec /usr/bin/gosaab-android-setup --auto 2>&1 | while IFS= read -r line; do
    case "$line" in
      *"1/4"*) progress 35 "Setting up Android" "Downloading Android with Google Play" ;;
      *"2/4"*) progress 75 "Setting up Android" "Giving each Android app its own window" ;;
      *"3/4"*) progress 85 "Setting up Android" "Adding support for phone-only (ARM) apps" ;;
      *"4/4"*) progress 98 "Setting up Android" "Almost done" ;;
    esac
  done
fi
progress 100 "Your apps are ready" "Play Store (Android), Bazaar (Linux apps), Bottles (Windows apps), Brave, VLC, Steam and GE-Proton are set up."
touch "$DONE"
