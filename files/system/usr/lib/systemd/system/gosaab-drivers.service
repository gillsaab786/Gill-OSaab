[Unit]
Description=Gill(OS): record every part and its driver (installs only at the very first start; later on the update schedule)
Wants=network-online.target
After=network-online.target fwupd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/gosaab-drivers auto
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
