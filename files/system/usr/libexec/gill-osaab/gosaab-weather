#!/usr/bin/python3
"""Current weather for the desktop widget, from Open-Meteo (free, no account, no key).

  gosaab-weather CITY   ->  {"city", "temp", "high", "low", "code", "text", "day"} as JSON

The last good answer is kept in ~/.cache/gill-osaab/weather.json and printed when offline.
"""
import json
import os
import sys
import urllib.parse
import urllib.request

CACHE = os.path.expanduser("~/.cache/gill-osaab/weather.json")
TEXT = {0: "Clear", 1: "Mostly Clear", 2: "Partly Cloudy", 3: "Cloudy", 45: "Fog", 48: "Fog",
        51: "Drizzle", 53: "Drizzle", 55: "Drizzle", 56: "Freezing Drizzle", 57: "Freezing Drizzle",
        61: "Rain", 63: "Rain", 65: "Heavy Rain", 66: "Freezing Rain", 67: "Freezing Rain",
        71: "Snow", 73: "Snow", 75: "Heavy Snow", 77: "Snow", 80: "Showers", 81: "Showers",
        82: "Heavy Showers", 85: "Snow Showers", 86: "Snow Showers", 95: "Thunderstorm",
        96: "Thunderstorm", 99: "Thunderstorm"}


def describe(code):
    return TEXT.get(int(code), "—")


def get(url, params):
    with urllib.request.urlopen(url + "?" + urllib.parse.urlencode(params), timeout=10) as r:
        return json.load(r)


def fetch(city):
    places = get("https://geocoding-api.open-meteo.com/v1/search", {"name": city, "count": 1}).get("results") or []
    if not places:
        return {"error": f"Couldn't find {city}"}
    p = places[0]
    w = get("https://api.open-meteo.com/v1/forecast", {
        "latitude": p["latitude"], "longitude": p["longitude"], "timezone": "auto", "forecast_days": 1,
        "current": "temperature_2m,weather_code,is_day", "daily": "temperature_2m_max,temperature_2m_min"})
    cur, daily = w["current"], w["daily"]
    return {"city": p["name"], "temp": round(cur["temperature_2m"]), "code": cur["weather_code"],
            "text": describe(cur["weather_code"]), "day": bool(cur.get("is_day", 1)),
            "high": round(daily["temperature_2m_max"][0]), "low": round(daily["temperature_2m_min"][0])}


def main(argv):
    city = " ".join(argv).strip()
    if not city:
        print(json.dumps({"error": "Set your city in Settings > Appearance > Widgets"}))
        return 0
    try:
        out = fetch(city)
        if "error" not in out:
            os.makedirs(os.path.dirname(CACHE), exist_ok=True)
            with open(CACHE, "w") as f:
                json.dump(out, f)
    except Exception:  # offline: show the last answer we had
        try:
            with open(CACHE) as f:
                out = json.load(f)
        except Exception:
            out = {"error": "Weather unavailable offline"}
    print(json.dumps(out))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
