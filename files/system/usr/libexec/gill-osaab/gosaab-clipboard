#!/usr/bin/python3
"""Clipboard history for Spotlight (Super+Space, then the Clipboard button).

  wl-paste --type text --watch gosaab-clipboard store   # run by the session
  gosaab-clipboard list | copy N | clear

Kept in memory-backed $XDG_RUNTIME_DIR (gone at sign-out), last 25 text items. Copies that
password managers mark as secret are never kept. Off when appearance.json has
"clipboardHistory": false.
"""
import json
import os
import subprocess
import sys

RUN = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
HISTORY = os.path.join(RUN, "gill-osaab-clipboard.json")
APPEARANCE = os.path.expanduser("~/.config/gill-osaab/appearance.json")
LIMIT, MAX_CHARS = 25, 4000
SECRET_TYPES = ("x-kde-passwordManagerHint", "application/x-kde-passwordmanagerhint")


def enabled():
    try:
        with open(APPEARANCE) as f:
            return json.load(f).get("clipboardHistory", True) is not False
    except (OSError, ValueError):
        return True


def load():
    try:
        with open(HISTORY) as f:
            items = json.load(f)
        return [i for i in items if isinstance(i, str)]
    except (OSError, ValueError):
        return []


def save(items):
    tmp = HISTORY + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(items, f)
    os.replace(tmp, HISTORY)


def is_secret():
    try:
        types = subprocess.run(["wl-paste", "--list-types"], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return any(t in types for t in SECRET_TYPES)


def add(items, text):
    text = text[:MAX_CHARS]
    if not text.strip():
        return items
    return ([text] + [i for i in items if i != text])[:LIMIT]


def main(argv):
    cmd = argv[0] if argv else "list"
    if cmd == "store":
        text = sys.stdin.read(MAX_CHARS * 4)  # a huge copy is cut, never loaded whole
        if not enabled():
            if os.path.exists(HISTORY):
                os.remove(HISTORY)
            return 0
        if not is_secret():
            save(add(load(), text))
    elif cmd == "list":
        print(json.dumps(load()))
    elif cmd == "copy" and len(argv) == 2 and argv[1].isdigit():
        items = load()
        n = int(argv[1])
        if n >= len(items):
            return 1
        subprocess.run(["wl-copy"], input=items[n], text=True, check=False)
    elif cmd == "clear":
        save([])
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
