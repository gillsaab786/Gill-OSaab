QPushButton#primary:hover { background: #27c7db; }
QPushButton#segLeft, QPushButton#segRight { background: #34343a; padding: 6px 18px; border-radius: 0; }
QPushButton#segLeft { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
QPushButton#segRight { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
QPushButton#segLeft:checked, QPushButton#segRight:checked { background: #1fb6c9; color: #ffffff; }
QSpinBox { background: #34343a; border: none; border-radius: 8px; padding: 4px 8px; min-width: 70px; }
QScrollArea { background: transparent; }
QScrollBar:vertical { width: 8px; background: transparent; }
QScrollBar::handle:vertical { background: #44444a; border-radius: 4px; }
"""


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Gill-OSaab Settings")
    app.setDesktopFileName("gosaab-settings")
    app.setStyleSheet(STYLE)
    w = Settings()
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
