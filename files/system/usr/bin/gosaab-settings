#!/usr/bin/env python3
"""Gill-OSaab Settings: every Gill-OSaab switch and update in one place."""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/libexec/gill-osaab")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "../libexec/gill-osaab"))
from gosaab_common import ETC, is_on, read_conf  # noqa: E402

from PySide6.QtCore import (QEasingCurve, QProcess, QPropertyAnimation, QRectF, QSize, Qt,  # noqa: E402
                            Property, Signal)
from PySide6.QtGui import QColor, QFont, QIcon, QPainter, QPainterPath, QPixmap  # noqa: E402
from PySide6.QtWidgets import (QAbstractButton, QApplication, QButtonGroup, QFrame,  # noqa: E402
                               QGraphicsOpacityEffect, QHBoxLayout, QLabel, QLineEdit, QListWidget,
                               QListWidgetItem, QMainWindow, QMessageBox, QPushButton, QScrollArea, QSpinBox,
                               QStackedWidget, QVBoxLayout, QWidget)

ACCENT = QColor(31, 182, 201)
VERSION_FILE = Path("/usr/share/gill-osaab/version")
UPDATER = "gosaab-update-component"
RESULT_TEXT = {0: "Updated", 4: "Up to date", 3: "Not available", 1: "Failed – retry"}


# ------------------------------------------------------------------ backend
class Backend:
    """Everything that touches the system lives here (tests swap in a fake)."""

    def __init__(self):
        self.etc = ETC

    def features(self):
        return read_conf(self.etc / "features.conf")

    def updates(self):
        return read_conf(self.etc / "updates.conf")

    def set_value(self, filename, key, value):
        cmd = ["gosaab-config", "set", filename, key, value]
        if os.geteuid() != 0 and shutil.which("pkexec"):
            cmd = ["pkexec", "/usr/bin/gosaab-config", "set", filename, key, value]
        return subprocess.run(cmd, check=False).returncode == 0

    def run(self, cmd, wait=True):
        if wait:
            return subprocess.run(cmd, check=False).returncode == 0
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True

    def run_async(self, cmd, parent, done):
        """Run without freezing the window; done(exit_code) is called at the end."""
        proc = QProcess(parent)
        proc.finished.connect(lambda code, _status: done(code))
        proc.errorOccurred.connect(lambda _err: done(1) if proc.state() == QProcess.NotRunning else None)
        proc.start(cmd[0], cmd[1:])
        return proc

    def versions(self):
        try:
            out = subprocess.run([UPDATER, "--versions"], capture_output=True, text=True, timeout=10, check=False)
            return json.loads(out.stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return {}

    def hardware(self):
        try:
            import gosaab_hw
            return gosaab_hw.summary()
        except Exception:
            return {"model": {}, "cpu": "", "gpus": [], "network": [], "nvidia": False, "support_page": ""}

    def have(self, tool):
        return shutil.which(tool) is not None

    def service_active(self, unit):
        if not shutil.which("systemctl"):
            return False
        return subprocess.run(["systemctl", "is-active", "--quiet", unit], check=False).returncode == 0

    def module_loaded(self, name):
        try:
            return any(line.split()[0] == name for line in Path("/proc/modules").read_text().splitlines())
        except OSError:
            return False

    # ---- Game Mode (Core edition)
    BOOT_STATE = Path("/etc/gill-osaab/boot-mode")
    LSFG_CONF = Path.home() / ".config/lsfg-vk/conf.toml"

    def boot_mode(self):
        try:
            return self.BOOT_STATE.read_text().strip() or "auto"
        except OSError:
            return "auto"

    def set_boot_mode(self, mode):
        user = os.environ.get("USER", "")
        return self.run(["pkexec", "/usr/libexec/gill-osaab/gosaab-session-select-root", "--boot", user, mode])

    def frame_gen_enabled(self):
        return self.LSFG_CONF.exists()

    def set_frame_gen(self, on, multiplier=2):
        if on:
            self.LSFG_CONF.parent.mkdir(parents=True, exist_ok=True)
            self.LSFG_CONF.write_text(
                "# Gill-OSaab frame generation. Games opt in with the Steam launch option:\n"
                "#   LSFG_PROCESS=gosaab %command%\n"
                "version = 1\n\n[[game]]\nexe = \"gosaab\"\n"
                f"multiplier = {multiplier}\nflow_scale = 0.8\nperformance_mode = true\n")
        elif self.LSFG_CONF.exists():
            self.LSFG_CONF.unlink()
        return 0

    INPUT_CONF = Path.home() / ".config/gill-osaab/input.conf"

    def input_setting(self, key, default=True):
        try:
            for line in self.INPUT_CONF.read_text().splitlines():
                if line.startswith(key + "="):
                    return line.split("=", 1)[1].strip() == "on"
        except OSError:
            pass
        return default

    def set_input_setting(self, key, on):
        lines = []
        try:
            lines = [ln for ln in self.INPUT_CONF.read_text().splitlines() if not ln.startswith(key + "=")]
        except OSError:
            pass
        lines.append(f"{key}={'on' if on else 'off'}")
        self.INPUT_CONF.parent.mkdir(parents=True, exist_ok=True)
        self.INPUT_CONF.write_text("\n".join(lines) + "\n")
        subprocess.run(["pkill", "-RTMIN+2", "-x", "gosaab-wm"], check=False)  # apply now
        return 0

    def decky_plugin_installed(self):
        return (Path.home() / "homebrew/plugins/gill-osaab-notify/plugin.json").exists()

    def kde_night_light(self):
        out = subprocess.run(["kreadconfig6", "--file", "kwinrc", "--group", "NightColor", "--key", "Active"],
                             capture_output=True, text=True, check=False) if self.have("kreadconfig6") else None
        return bool(out and out.stdout.strip() == "true")

    def color_scheme(self):
        if not self.have("kreadconfig6"):
            return "GillOSaabDark"
        out = subprocess.run(["kreadconfig6", "--group", "General", "--key", "ColorScheme"],
                             capture_output=True, text=True, check=False)
        return out.stdout.strip() or "GillOSaabDark"


# ------------------------------------------------------------------ HD icon tiles
def tile_icon(color, glyph, letter):
    """iOS-style icon: white glyph on a rounded colour square, drawn at 1x/2x/3x so it
    stays sharp on high-resolution screens."""
    icon = QIcon()
    theme = QIcon.fromTheme(glyph)
    for scale in (1, 2, 3):
        size = 28 * scale
        pm = QPixmap(size, size)
        pm.fill(Qt.transparent)
        p = QPainter(pm)
        p.setRenderHint(QPainter.Antialiasing)
        path = QPainterPath()
        path.addRoundedRect(QRectF(0, 0, size, size), size * 0.23, size * 0.23)
        p.fillPath(path, QColor(color))
        inner = int(size * 0.62)
        glyph_pm = theme.pixmap(inner, inner) if not theme.isNull() else QPixmap()
        if not glyph_pm.isNull():
            white = QPixmap(glyph_pm.size())
            white.fill(Qt.transparent)
            gp = QPainter(white)
            gp.drawPixmap(0, 0, glyph_pm)
            gp.setCompositionMode(QPainter.CompositionMode_SourceIn)
            gp.fillRect(white.rect(), QColor("white"))
            gp.end()
            off = (size - inner) // 2
            p.drawPixmap(QRectF(off, off, inner, inner), white, QRectF(white.rect()))
        else:
            font = QFont("Inter")
            font.setPixelSize(int(size * 0.5))
            font.setWeight(QFont.DemiBold)
            p.setFont(font)
            p.setPen(QColor("white"))
            p.drawText(QRectF(0, 0, size, size), Qt.AlignCenter, letter)
        p.end()
        icon.addPixmap(pm)
    return icon


# ------------------------------------------------------------------ widgets
class Switch(QAbstractButton):
    """iOS-style toggle switch with a sliding knob."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setCheckable(True)
        self.setCursor(Qt.PointingHandCursor)
        self.setFixedSize(52, 30)
        self._pos = 0.0
        self._anim = QPropertyAnimation(self, b"knob", self)
        self._anim.setDuration(180)
        self._anim.setEasingCurve(QEasingCurve.OutCubic)
        self.toggled.connect(self._animate)

    def _animate(self, checked):
        self._anim.stop()
        self._anim.setStartValue(self._pos)
        self._anim.setEndValue(1.0 if checked else 0.0)
        self._anim.start()

    def set_quiet(self, checked):
        self.blockSignals(True)
        self.setChecked(checked)
        self._pos = 1.0 if checked else 0.0
        self.blockSignals(False)
        self.update()

    def get_knob(self):
        return self._pos

    def set_knob(self, value):
        self._pos = value
        self.update()

    knob = Property(float, get_knob, set_knob)

    def sizeHint(self):
        return QSize(52, 30)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        off = QColor(72, 72, 78)
        t = self._pos
        track = QColor(int(off.red() + (ACCENT.red() - off.red()) * t),
                       int(off.green() + (ACCENT.green() - off.green()) * t),
                       int(off.blue() + (ACCENT.blue() - off.blue()) * t))
        if not self.isEnabled():
            track.setAlpha(90)
        p.setPen(Qt.NoPen)
        p.setBrush(track)
        p.drawRoundedRect(QRectF(0, 0, 52, 30), 15, 15)
        p.setBrush(QColor(0, 0, 0, 40))
        x = 3 + t * 22
        p.drawEllipse(QRectF(x, 4, 24, 24))  # soft knob shadow
        p.setBrush(QColor(255, 255, 255, 255 if self.isEnabled() else 150))
        p.drawEllipse(QRectF(x, 3, 24, 24))


class UpdateButton(QPushButton):
    """Runs one updater part in the background and shows the result."""

    def __init__(self, window, part, label="Update"):
        super().__init__(label)
        self.window, self.part, self.label = window, part, label
        self.setObjectName("pill")
        self.setCursor(Qt.PointingHandCursor)
        self.clicked.connect(self.start)
        self.proc = None
        self.last_code = None

    def start(self):
        self.setEnabled(False)
        self.setText("Updating…")
        self.proc = self.window.backend.run_async([UPDATER, self.part], self, self.finished)

    def finished(self, code):
        self.last_code = code
        self.setEnabled(True)
        self.setText(RESULT_TEXT.get(code, RESULT_TEXT[1]))
        self.window.on_update_finished(self.part, code)


class Row(QWidget):
    """A settings row: title, optional subtitle, control on the right."""

    def __init__(self, title, subtitle="", control=None):
        super().__init__()
        self.title_text = title
        lay = QHBoxLayout(self)
        lay.setContentsMargins(16, 11, 16, 11)
        text = QVBoxLayout()
        text.setSpacing(2)
        t = QLabel(title)
        t.setObjectName("rowTitle")
        text.addWidget(t)
        self.subtitle = None
        if subtitle:
            self.subtitle = QLabel(subtitle)
            self.subtitle.setObjectName("rowSubtitle")
            self.subtitle.setWordWrap(True)
            text.addWidget(self.subtitle)
        lay.addLayout(text, 1)
        if control is not None:
            lay.addWidget(control, 0, Qt.AlignVCenter)


class Card(QFrame):
    """Rounded group of rows, like an iOS settings section."""

    def __init__(self, rows):
        super().__init__()
        self.setObjectName("card")
        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 4, 0, 4)
        lay.setSpacing(0)
        for i, row in enumerate(rows):
            if i:
                line = QFrame()
                line.setObjectName("divider")
                line.setFixedHeight(1)
                lay.addWidget(line)
            lay.addWidget(row)


class Page(QScrollArea):
    def __init__(self, title):
        super().__init__()
        self.title = title
        self.keywords = [title.lower()]
        self.setWidgetResizable(True)
        self.setFrameShape(QFrame.NoFrame)
        body = QWidget()
        body.setObjectName("page")
        self.lay = QVBoxLayout(body)
        self.lay.setContentsMargins(32, 26, 32, 26)
        self.lay.setSpacing(10)
        h = QLabel(title)
        h.setObjectName("pageTitle")
        self.lay.addWidget(h)
        self.setWidget(body)

    def section(self, label, rows, note=""):
        if label:
            lab = QLabel(label.upper())
            lab.setObjectName("sectionLabel")
            self.lay.addSpacing(10)
            self.lay.addWidget(lab)
            self.keywords.append(label.lower())
        for r in rows:
            self.keywords.append(r.title_text.lower())
            if r.subtitle is not None:
                self.keywords.append(r.subtitle.text().lower())
        self.lay.addWidget(Card(rows))
        if note:
            n = QLabel(note)
            n.setObjectName("note")
            n.setWordWrap(True)
            self.lay.addWidget(n)

    def button(self, text, primary=False):
        b = QPushButton(text)
        b.setCursor(Qt.PointingHandCursor)
        if primary:
            b.setObjectName("primary")
        self.lay.addWidget(b, 0, Qt.AlignLeft)
        self.keywords.append(text.lower())
        return b

    def finish(self):
        self.lay.addStretch(1)


# ------------------------------------------------------------------ window
PAGES = [
    # title, tile colour, symbolic glyph, letter
    ("Updates", "#0A84FF", "system-software-update-symbolic", "U"),
    ("Device & Drivers", "#30D158", "computer-symbolic", "D"),
    ("Apps & Security", "#5E5CE6", "security-high-symbolic", "S"),
    ("Notifications", "#FF453A", "preferences-system-notifications-symbolic", "N"),
    ("Screen Off", "#FF9F0A", "video-display-symbolic", "O"),
    ("Appearance", "#1FB6C9", "preferences-desktop-appearance-symbolic", "A"),
    ("Game Mode", "#32D74B", "input-gaming-symbolic", "G"),
    ("Optional Features", "#BF5AF2", "view-more-symbolic", "+"),
    ("About", "#8E8E93", "help-about-symbolic", "i"),
]


class Settings(QMainWindow):
    changed = Signal(str, str, str)

    def __init__(self, backend=None):
        super().__init__()
        self.backend = backend or Backend()
        self.setWindowTitle("Gill-OSaab Settings")
        self.setWindowIcon(QIcon.fromTheme("gill-osaab"))
        self.resize(1000, 680)
        self.switches = {}
        self.update_buttons = {}
        self.versions = self.backend.versions()
        self.hw = self.backend.hardware()

        root = QWidget()
        layout = QHBoxLayout(root)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)

        side = QWidget()
        side.setObjectName("side")
        side.setFixedWidth(250)
        sl = QVBoxLayout(side)
        sl.setContentsMargins(12, 16, 12, 12)
        sl.setSpacing(10)
        self.search = QLineEdit()
        self.search.setObjectName("search")
        self.search.setPlaceholderText("Search")
        self.search.setClearButtonEnabled(True)
        self.search.textChanged.connect(self.filter_pages)
        self.nav = QListWidget()
        self.nav.setObjectName("nav")
        self.nav.setIconSize(QSize(28, 28))
        sl.addWidget(self.search)
        sl.addWidget(self.nav, 1)

        self.stack = QStackedWidget()
        layout.addWidget(side)
        layout.addWidget(self.stack, 1)
        self.setCentralWidget(root)

        builders = [self.page_updates, self.page_device, self.page_security, self.page_notifications,
                    self.page_screen, self.page_appearance, self.page_gamemode, self.page_optional, self.page_about]
        self.pages = []
        for (name, color, glyph, letter), builder in zip(PAGES, builders):
            item = QListWidgetItem(tile_icon(color, glyph, letter), name)
            item.setSizeHint(QSize(220, 44))
            self.nav.addItem(item)
            page = builder()
            self.pages.append(page)
            self.stack.addWidget(page)
        self.nav.currentRowChanged.connect(self.show_page)
        self.nav.setCurrentRow(0)
        self.refresh()

    # -------------------------------------------------------- navigation
    def show_page(self, index):
        if index < 0:
            return
        self.stack.setCurrentIndex(index)
        page = self.stack.currentWidget()
        effect = QGraphicsOpacityEffect(page)
        page.setGraphicsEffect(effect)
        anim = QPropertyAnimation(effect, b"opacity", page)
        anim.setDuration(160)
        anim.setStartValue(0.0)
        anim.setEndValue(1.0)
        anim.setEasingCurve(QEasingCurve.OutCubic)
        anim.finished.connect(lambda: page.setGraphicsEffect(None))
        anim.start()
        self._page_anim = anim

    def filter_pages(self, text):
        text = text.strip().lower()
        first = None
        for i, page in enumerate(self.pages):
            match = not text or any(text in k for k in page.keywords)
            self.nav.item(i).setHidden(not match)
            if match and first is None:
                first = i
        if first is not None and self.nav.item(self.nav.currentRow()).isHidden():
            self.nav.setCurrentRow(first)

    # -------------------------------------------------------- helpers
    def switch(self, filename, key, default=True, enabled=True):
        sw = Switch()
        sw.setEnabled(enabled)
        sw.toggled.connect(lambda on, f=filename, k=key, s=sw: self.on_toggle(f, k, on, s))
        self.switches[(filename, key)] = (sw, default)
        return sw

    def update_button(self, part, label="Update"):
        b = UpdateButton(self, part, label)
        self.update_buttons[part] = b
        return b

    def on_toggle(self, filename, key, on, sw):
        value = "on" if on else "off"
        if self.backend.set_value(filename, key, value):
            self.changed.emit(filename, key, value)
            if filename == "updates.conf":
                self.update_master_state()
        else:
            sw.set_quiet(not on)
            QMessageBox.warning(self, "Not changed", "The setting couldn't be saved (permission was not given).")

    def on_update_finished(self, part, code):
        if part == "bios" and code == 3:
            self.bios_not_available()
        self.versions = self.backend.versions() or self.versions

    def refresh(self):
        confs = {"features.conf": self.backend.features(), "updates.conf": self.backend.updates()}
        for (filename, key), (sw, default) in self.switches.items():
            if sw.isEnabled():
                sw.set_quiet(is_on(confs[filename], key, default))
        self.update_master_state()

    def update_master_state(self):
        master = self.switches.get(("updates.conf", "all"))
        if not master:
            return
        on = master[0].isChecked()
        for key in ("os", "apps", "containers"):
            self.switches[("updates.conf", key)][0].setEnabled(on)

    def v(self, key, prefix=""):
        value = self.versions.get(key, "")
        return f"{prefix}{value}" if value else "Not installed"

    # -------------------------------------------------------- pages
    def page_updates(self):
        p = Page("Updates")
        everything = self.update_button("all", "Update everything")
        everything.setObjectName("primary")
        p.section("", [Row("Everything", "System, Android, Proton-GE, Windows app setups, apps, containers "
                                                "and Game Mode plugins. The BIOS is never updated automatically.",
                           everything)])
        base = "Fedora" if "gill-osaab-core" in self.versions.get("image", "") or not self.versions.get("image") \
            and Path("/usr/share/wayland-sessions/gill-osaab.desktop").exists() else "Bazzite"
        p.section("Update now", [
            Row("Gill-OSaab system", f"{self.v('gill_osaab', 'Gill-OSaab ')} · {base} {self.v('os')} · "
                                     f"kernel {self.v('kernel')}. Includes graphics and Wi-Fi drivers and Wine.",
                self.update_button("os")),
            Row("Android system", f"Waydroid {self.v('waydroid')} · Android image {self.v('android_image')}",
                self.update_button("android")),
            Row("Proton-GE", f"{self.v('proton')} · for Steam games", self.update_button("proton")),
            Row("Windows app setups", f"{self.v('wine')} · refreshes each Windows app's private setup",
                self.update_button("wine")),
            Row("Apps and emulators", "Flatpak apps", self.update_button("apps")),
            Row("Linux containers", "Apps installed from .deb and .rpm", self.update_button("containers")),
            Row("Game Mode plugins", "Gill-OSaab Notifications", self.update_button("decky")),
        ], note="Drivers, device firmware and the BIOS are in Device & Drivers.")
        p.section("Automatic updates", [
            Row("All updates", "Master switch. Off stops every automatic update below.",
                self.switch("updates.conf", "all")),
            Row("OS updates", "System, drivers, Wine, Android support", self.switch("updates.conf", "os")),
            Row("Apps and emulators", "Flatpak apps", self.switch("updates.conf", "apps")),
            Row("Linux containers", "Apps installed from .deb and .rpm", self.switch("updates.conf", "containers")),
        ], note="Steam updates itself and isn't controlled here.")
        p.finish()
        return p

    def page_device(self):
        p = Page("Device & Drivers")
        hw = self.hw
        model = hw.get("model", {})
        info = [Row("Model", model.get("name") or "Unknown"),
                Row("BIOS", " · ".join(x for x in (model.get("bios_version"), model.get("bios_date")) if x)
                    or "Unknown"),
                Row("Processor", hw.get("cpu") or "Unknown")]
        for g in hw.get("gpus", []):
            info.append(Row("Graphics", f"{g['vendor']} {g['device']}", self.driver_label(g)))
        for n in hw.get("network", []):
            info.append(Row(n.get("kind", "Network"), f"{n['vendor']} {n['device']}", self.driver_label(n)))
        p.section("This device", info)

        actions = [
            Row("Update all drivers", "Kernel, graphics, Wi-Fi, Bluetooth and audio drivers plus device firmware, "
                                      "matched to this device.", self.update_button("drivers")),
            Row("Device firmware", "Controllers, SSDs, docks and other parts that publish updates (LVFS).",
                self.update_button("firmware")),
            Row("BIOS", "Installed only when the maker publishes it for your exact model. Plug in the charger "
                        "first.", self.update_button("bios")),
        ]
        if hw.get("nvidia") and "nvidia" not in self.versions.get("image", ""):
            actions.insert(0, Row("Nvidia graphics found", "Switch to the Gill-OSaab Nvidia edition for full "
                                                           "Nvidia driver support. Restart after.",
                                  self.update_button("nvidia", "Switch")))
        p.section("Drivers and firmware", actions)
        p.finish()
        return p

    def driver_label(self, dev):
        lab = QLabel(f"●  {dev['driver']}" if dev.get("driver") else "●  No driver")
        lab.setObjectName("ok" if dev.get("driver") else "bad")
        return lab

    def page_security(self):
        p = Page("Apps & Security")
        p.section("Windows apps", [
            Row("Sandbox Windows apps",
                "Each app gets its own private folder and can't see your files. Turn off only for apps "
                "that must open your documents.", self.switch("features.conf", "sandbox_windows_apps")),
        ])
        p.finish()
        return p

    def page_notifications(self):
        p = Page("Notifications")
        installed = self.backend.decky_plugin_installed()
        status = QLabel("●  Ready" if installed else "●  Not set up")
        status.setObjectName("ok" if installed else "bad")
        p.section("Game Mode", [
            Row("Pop-ups and live progress", "Downloads, copies and installs show percentages in Game Mode "
                                             "(Quick Access › Gill-OSaab Notifications).", status),
        ], note="Desktop mode uses the notification panel in the top bar.")
        if not installed:
            b = p.button("Set up Game Mode notifications", primary=True)
            b.clicked.connect(lambda: self.backend.run(
                ["konsole", "-e", "ujust", "gosaab-setup-notifications"], wait=False))
        p.finish()
        return p

    def page_screen(self):
        p = Page("Screen Off")
        self.idle = QSpinBox()
        self.idle.setRange(5, 600)
        self.idle.setSuffix(" s")
        self.idle.setValue(int(self.backend.features().get("screen_off_idle_seconds", "15") or 15))
        self.idle.editingFinished.connect(
            lambda: self.backend.set_value("features.conf", "screen_off_idle_seconds", str(self.idle.value())))
        p.section("", [
            Row("Overnight / Work", "When the task finishes, show “Done” for 10 seconds, then sleep.",
                self.switch("features.conf", "screen_off_overnight", default=False)),
            Row("Wake after idle", "Seconds with no download or copy before the screen turns back on.", self.idle),
        ])
        btn = p.button("Turn screen off now", primary=True)
        btn.clicked.connect(lambda: self.backend.run(["gosaab-screen-off"], wait=False))
        p.finish()
        return p

    def page_appearance(self):
        p = Page("Appearance")
        mode = QWidget()
        ml = QHBoxLayout(mode)
        ml.setContentsMargins(0, 0, 0, 0)
        ml.setSpacing(0)
        self.mode_group = QButtonGroup(self)
        for i, (label, scheme) in enumerate([("Dark", "GillOSaabDark"), ("Light", "GillOSaabLight")]):
            b = QPushButton(label)
            b.setCheckable(True)
            b.setObjectName("segLeft" if i == 0 else "segRight")
            b.setChecked(self.backend.color_scheme() == scheme)
            b.clicked.connect(lambda _=False, s=scheme: self.apply_scheme(s))
            self.mode_group.addButton(b)
            ml.addWidget(b)
        self.night = Switch()
        self.night.set_quiet(self.backend.kde_night_light())
        self.night.toggled.connect(self.apply_night_light)
        auto = Switch()
        auto.setEnabled(False)
        p.section("", [
            Row("Mode", "Dark is the default.", mode),
            Row("Night light", "Warmer screen in the evening.", self.night),
            Row("Auto dark mode at sunset", "Coming in a later update.", auto),
        ])
        rows = []
        for key, title, sub in [("tap_to_click", "Tap to click", "Tap the touchpad instead of pressing it."),
                                ("natural_scroll", "Natural scrolling", "Content follows your fingers, like a phone.")]:
            sw = Switch()
            sw.set_quiet(self.backend.input_setting(key))
            sw.toggled.connect(lambda on, k=key: self.backend.set_input_setting(k, on))
            rows.append(Row(title, sub, sw))
        p.section("Touchpad", rows, "Pinch to zoom works in apps. Three fingers: swipe sideways to change "
                  "space, up for Mission Control.")
        reset = p.button("Apply Gill-OSaab look (top bar + dock)")
        reset.clicked.connect(self.apply_look)
        p.finish()
        return p

    def page_gamemode(self):
        p = Page("Game Mode")
        b = self.backend
        start = QWidget()
        sl = QHBoxLayout(start)
        sl.setContentsMargins(0, 0, 0, 0)
        sl.setSpacing(0)
        self.boot_group = QButtonGroup(self)
        current = b.boot_mode()
        choices = [("Game Mode", "game"), ("Desktop", "desktop"), ("Ask", "ask")]
        for i, (label, mode) in enumerate(choices):
            btn = QPushButton(label)
            btn.setCheckable(True)
            btn.setObjectName("segLeft" if i == 0 else "segRight" if i == len(choices) - 1 else "segMid")
            btn.setChecked(current == mode)
            btn.clicked.connect(lambda _=False, m=mode: b.set_boot_mode(m))
            self.boot_group.addButton(btn)
            sl.addWidget(btn)
        p.section("Start up", [
            Row("Start up in", "What opens when you turn it on. Handhelds start in Game Mode, PCs on the "
                "desktop, until you choose.", start),
        ])
        self.fg = Switch()
        self.fg.set_quiet(b.frame_gen_enabled())
        self.fg.toggled.connect(lambda on: b.set_frame_gen(on))
        fg_ready = Path("/usr/share/vulkan/implicit_layer.d").exists() and any(
            "lsfg" in f.name for f in Path("/usr/share/vulkan/implicit_layer.d").glob("*.json"))
        p.section("Performance", [
            Row("TDP, fans and buttons", "In Game Mode press the ··· (Quick Access) button: Handheld Daemon "
                "sets TDP, fan curve and charge limit." if b.have("hhd") else "Handheld Daemon is not installed.",
                QLabel("●  Ready" if b.have("hhd") else "●  Not found")),
            Row("Frame generation", "Off by default. Doubles frames in games you choose: add the Steam launch "
                "option  LSFG_PROCESS=gosaab %command%. Needs Lossless Scaling from Steam."
                + ("" if fg_ready else "  (Not installed on this system.)"), self.fg),
        ])
        decky = p.button("Install Decky Loader (Game Mode plugins, notifications)")
        decky.clicked.connect(lambda: b.run(["foot", "-e", "sh", "-c",
            "curl -L https://github.com/SteamDeckHomebrew/decky-installer/releases/latest/download/"
            "install_release.sh | sh; echo; read -p 'Done. Press Enter to close.' x"], wait=False))
        switch = p.button("Switch to Game Mode now", primary=True)
        switch.clicked.connect(lambda: b.run(["gosaab-game-mode"], wait=False))
        p.finish()
        return p

    def page_optional(self):
        p = Page("Optional Features")
        rows = []
        for key, title in [("phone_link", "Phone link"), ("shared_game_library", "Shared game library"),
                           ("vpn", "VPN"), ("cloud_drives", "Cloud drives"), ("vrr", "VRR (FreeSync)"),
                           ("suspend_then_hibernate", "Suspend, then hibernate"), ("undervolt", "Undervolting"),
                           ("smart_updates", "Smart updates"),
                           ("pause_downloads_while_gaming", "Pause downloads while gaming")]:
            rows.append(Row(title, "Coming in a later update. Off by default.",
                            self.switch("features.conf", key, default=False, enabled=False)))
        p.section("Off by default", rows)
        p.finish()
        return p

    def page_about(self):
        p = Page("About")
        version = VERSION_FILE.read_text().strip() if VERSION_FILE.exists() else "dev"
        p.section("", [Row("Gill-OSaab", f"Version {version}  ·  Developer: GILL-Saab")])
        b = self.backend
        checks = [
            ("Windows apps (Wine)", b.have("wine")), ("App sandbox (bubblewrap)", b.have("bwrap")),
            ("Android apps (Waydroid)", b.have("waydroid")), ("Linux packages (distrobox)", b.have("distrobox")),
            ("Firmware updates (fwupd)", b.have("fwupdmgr")),
            ("Gaming CPU scheduler", b.service_active("scx_loader.service")),
            ("NTSYNC", b.module_loaded("ntsync")),
            ("Gill-OSaab updater", b.service_active("gosaab-update.timer")),
            ("Game Mode notifications (Decky)", b.decky_plugin_installed()),
        ]
        rows = []
        for name, ok in checks:
            dot = QLabel("●  Ready" if ok else "●  Not found")
            dot.setObjectName("ok" if ok else "bad")
            rows.append(Row(name, "", dot))
        p.section("Status", rows)
        p.finish()
        return p

    # -------------------------------------------------------- actions
    def bios_not_available(self):
        url = self.hw.get("support_page", "")
        name = self.hw.get("model", {}).get("name", "this device")
        box = QMessageBox(self)
        box.setWindowTitle("BIOS")
        box.setText(f"{name} doesn't publish BIOS updates to the Linux firmware service.")
        if url:
            box.setInformativeText("Open the maker's support page to download the BIOS for your exact model?")
            open_btn = box.addButton("Open support page", QMessageBox.AcceptRole)
            box.addButton(QMessageBox.Close)
            box.exec()
            if box.clickedButton() is open_btn:
                self.backend.run(["xdg-open", url], wait=False)
        else:
            box.exec()

    def apply_scheme(self, scheme):
        icons = "Papirus-Dark" if scheme.endswith("Dark") else "Papirus-Light"
        self.backend.run(["plasma-apply-colorscheme", scheme])
        self.backend.run(["/usr/libexec/plasma-changeicons", icons])

    def apply_night_light(self, on):
        self.backend.run(["kwriteconfig6", "--file", "kwinrc", "--group", "NightColor", "--key", "Active",
                          "true" if on else "false"])
        self.backend.run(["dbus-send", "--session", "--dest=org.kde.KWin", "/KWin", "org.kde.KWin.reconfigure"])

    def apply_look(self):
        answer = QMessageBox.question(self, "Apply Gill-OSaab look",
                                      "This resets your panels to the Gill-OSaab top bar and dock. Continue?")
        if answer == QMessageBox.Yes:
            self.backend.run(["plasma-apply-lookandfeel", "--apply", "org.gillosaab.desktop", "--resetLayout"])


