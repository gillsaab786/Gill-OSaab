    def page_screen(self):
        p = Page("Screen Off")
        self.idle = QSpinBox()
        self.idle.setRange(5, 600)
        self.idle.setSuffix(" s")
        self.idle.setValue(int(self.backend.features().get("screen_off_idle_seconds", "15") or 15))
        self.idle.editingFinished.connect(
            lambda: self.backend.set_value("features.conf", "screen_off_idle_seconds", str(self.idle.value())))
        p.section("", [
            Row("Overnight / Work", "When the task finishes, show “Done” for 10 seconds, then sleep.",
                self.switch("features.conf", "screen_off_overnight", default=False)),
            Row("Wake after idle", "Seconds with no download or copy before the screen turns back on.", self.idle),
        ])
        btn = p.button("Turn screen off now", primary=True)
        btn.clicked.connect(lambda: self.backend.run(["gosaab-screen-off"], wait=False))
        p.finish()
        return p

    def page_appearance(self):
        p = Page("Appearance")
        ap = self.backend.appearance()
        th = self.backend.wallpaper_thumb
        light, dark = th("GillOSaab", False), th("GillOSaab", True)

        def set_mode(mode):
            self.backend.set_appearance("mode", mode)
            if mode in ("light", "dark") and self.backend.have("plasma-apply-colorscheme"):
                self.apply_scheme("GillOSaabDark" if mode == "dark" else "GillOSaabLight")
        self.mode_picker = picker([(m, PreviewTile(m.capitalize(), paint_mode(light, dark, m)))
                                   for m in ("auto", "light", "dark")], ap.get("mode", "dark"), set_mode, 14)
        self.accent_picker = picker([(c, ColorDot(c, n)) for c, n in ACCENTS], ap.get("accent", DEFAULT_ACCENT),
                                    lambda c: (self.backend.set_appearance("accent", c), apply_accent(c)), 4)
        p.section("Appearance", [
            Row("", "", self.mode_picker),
            Row("Accent colour", "Buttons, switches and selections.", self.accent_picker),
        ], "Auto is light in the day and dark from 7 pm; the Tide wallpaper changes with it.")

        self.icon_picker = picker([(st, PreviewTile(st.capitalize(), paint_icon_style(st), 104, 66))
                                   for st in ("default", "dark", "clear", "tinted")], ap.get("iconStyle", "default"),
                                  lambda v: self.backend.set_appearance("iconStyle", v), 8)
        self.glass_seg = segmented([("clear", "Clear"), ("tinted", "Tinted")], ap.get("glass", "clear"),
                                   lambda v: self.backend.set_appearance("glass", v))
