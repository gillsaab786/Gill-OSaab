    def fill_shortcuts(self):
        while self.shortcut_lay.count():
            w = self.shortcut_lay.takeAt(0).widget()
            if w:
                w.deleteLater()
        rows = []
        for combo, info in sorted(self.backend.hotkeys().items()):
            rm = QPushButton("Remove")
            rm.setObjectName("pill")
            rm.clicked.connect(lambda _=False, c=combo: (self.backend.remove_hotkey(c), self.fill_shortcuts()))
            rows.append(Row(info.get("keys", combo), info.get("label", info.get("action", "")), rm))
        if not rows:
            rows = [Row("No shortcuts yet", "Add one below.")]
        box = QWidget()
        bl = QVBoxLayout(box)
        bl.setContentsMargins(0, 0, 0, 0)
        lab = QLabel("YOUR SHORTCUTS")
        lab.setObjectName("sectionLabel")
        bl.addWidget(lab)
        bl.addWidget(Card(rows))
        self.shortcut_lay.addWidget(box)

    def add_group_item(self, kind, value, label):
        if not value or "|" in value or "\n" in value or len(self.group) >= 12:
            return
        if kind == "open" and not (value.startswith("/") or value.startswith(("http://", "https://"))):
            QMessageBox.warning(self, "Shortcut", "Websites start with https://")
            return
        if any(v == value for _, v, _ in self.group):
            return
        self.group.append((kind, value, label))
        if kind == "open" and not value.startswith("/"):
            self.group_url.clear()
        self.show_group()

    def add_group_folder(self):
        from PySide6.QtWidgets import QFileDialog
        path = QFileDialog.getExistingDirectory(self, "Folder to open", str(Path.home() / "Desktop"))
        if path:
            self.add_group_item("open", path, Path(path).name)

    def show_group(self):
        self.group_label.setText(", ".join(label for _, _, label in self.group) or "Nothing added yet")

    def record_shortcut(self):
        self.record_btn.setEnabled(False)
        self.record_btn.setText("Hold the buttons now…")
        proc = QProcess(self)

        def done(_code, _status=None):
            combo = bytes(proc.readAllStandardOutput()).decode().strip()
            self.recorded_combo = combo
            self.record_btn.setEnabled(True)
            self.record_btn.setText(combo.replace("+", " + ") if combo else "Nothing pressed – try again")
        proc.finished.connect(done)
        proc.start("gosaab-hotkeys", ["record"])
        self._record_proc = proc

    def add_shortcut(self):
        if not self.recorded_combo:
            QMessageBox.warning(self, "Shortcut", "Press the buttons first (step 1).")
            return
        cmd = self.command_edit.text().strip()
        if cmd:
            action = f"run:{cmd}"
        elif self.group:
            action = "group:" + "|".join(f"{k}:{v}" for k, v, _ in self.group)
        else:
            action = self.action_pick.currentData()
        if not self.backend.set_hotkey(self.recorded_combo, action):
            QMessageBox.warning(self, "Shortcut", "That combo would fire while typing. Add Windows, Ctrl or Alt, "
                                                  "or use a controller/handheld button.")
            return
        self.recorded_combo = ""
        self.command_edit.clear()
        self.group.clear()
        self.show_group()
        self.record_btn.setText("Press buttons…")
        self.fill_shortcuts()

