def accent_style(color):
    """The Settings style sheet in an accent colour (buttons, switches, links, sliders, selections)."""
    c = QColor(color) if isinstance(color, str) and QColor.isValidColorName(color) else QColor(DEFAULT_ACCENT)
    return (STYLE.replace("#1fb6c9", c.name()).replace("#27c7db", c.lighter(115).name())
            .replace("#5ad2e2", c.lighter(140).name() if c.lightness() < 150 else c.name()))


def apply_accent(color):
    """Use an accent colour now: Settings and everything it draws follow at once (the desktop
    follows through appearance.json)."""
    global ACCENT
    ACCENT = QColor(color) if isinstance(color, str) and QColor.isValidColorName(color) else QColor(DEFAULT_ACCENT)
    app = QApplication.instance()
    if app:
        app.setStyleSheet(accent_style(ACCENT.name()))
        for w in app.allWidgets():
            w.update()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Gill(OS) Settings")
    app.setDesktopFileName("gosaab-settings")
    # the accent colour picked in Appearance tints Settings too
    apply_accent(Backend().appearance().get("accent", DEFAULT_ACCENT))
    w = Settings()
    # open a page directly: gosaab-settings vpn | about | game | folders | glasses ...
    want = (sys.argv[1] if len(sys.argv) > 1 else "").lower()
    if want:
        for i, page in enumerate(PAGES):
            if want.rstrip("s") in page[0].lower() or (want == "game" and page[0] == "Game Mode"):
                w.nav.setCurrentRow(i)
                break
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
