class Settings(QMainWindow):
    changed = Signal(str, str, str)

    def __init__(self, backend=None):
        super().__init__()
        self.backend = backend or Backend()
        self.setWindowTitle("Gill(OS) Settings")
        self.setWindowIcon(QIcon.fromTheme("gill-osaab"))
        self.resize(1000, 680)
        self.switches = {}
        self.update_buttons = {}
        self.versions = self.backend.versions()
        self.hw = self.backend.hardware()

        root = QWidget()
        layout = QHBoxLayout(root)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)

        side = QWidget()
        side.setObjectName("side")
        side.setFixedWidth(250)
        sl = QVBoxLayout(side)
        sl.setContentsMargins(12, 16, 12, 12)
        sl.setSpacing(10)
        self.search = QLineEdit()
        self.search.setObjectName("search")
        self.search.setPlaceholderText("Search")
        self.search.setClearButtonEnabled(True)
        self.search.textChanged.connect(self.filter_pages)
        self.nav = QListWidget()
        self.nav.setObjectName("nav")
        self.nav.setIconSize(QSize(28, 28))
        self.nav.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)  # no stray scroll bar under the list
        self.nav.setVerticalScrollMode(QListWidget.ScrollPerPixel)  # smooth, like macOS
        sl.addWidget(self.search)
        sl.addWidget(self.nav, 1)

        self.stack = QStackedWidget()
        layout.addWidget(side)
        layout.addWidget(self.stack, 1)
        self.setCentralWidget(root)

        builders = [self.page_device, self.page_security, self.page_folders,
                    self.page_vpn_cloud, self.page_glasses, self.page_notifications, self.page_screen,
                    self.page_appearance, self.page_gamemode, self.page_lights, self.page_shortcuts, self.page_optional,
                    self.page_updates, self.page_translation, self.page_drivers, self.page_problems, self.page_about]
        self.pages = []
        for (name, color, glyph, letter), builder in zip(PAGES, builders):
            item = QListWidgetItem(tile_icon(color, glyph, letter), name)
            item.setSizeHint(QSize(220, 44))
            self.nav.addItem(item)
            page = builder()
            self.pages.append(page)
            self.stack.addWidget(page)
        # pages for hardware this PC doesn't have stay out of the list (and out of search)
        self.unavailable = set() if self.backend.lights_status().get("ally") else {"Controller Lights"}
        for i, page in enumerate(self.pages):
            self.nav.item(i).setHidden(page.title in self.unavailable)
        self.nav.currentRowChanged.connect(self.show_page)
        self.nav.setCurrentRow(0)
        self.refresh()

    # -------------------------------------------------------- navigation
    def go_to(self, title):
        for i, page in enumerate(self.pages):
            if page.title == title:
                self.nav.setCurrentRow(i)
                return

    def show_page(self, index):
        if index < 0:
            return
        self.stack.setCurrentIndex(index)
        page = self.stack.currentWidget()
        effect = QGraphicsOpacityEffect(page)
        page.setGraphicsEffect(effect)
        anim = QPropertyAnimation(effect, b"opacity", page)
        anim.setDuration(160)
        anim.setStartValue(0.0)
        anim.setEndValue(1.0)
        anim.setEasingCurve(QEasingCurve.OutCubic)
        anim.finished.connect(lambda: page.setGraphicsEffect(None))
        anim.start()
        self._page_anim = anim

    def filter_pages(self, text):
        text = text.strip().lower()
        first = None
        for i, page in enumerate(self.pages):
            match = page.title not in self.unavailable and (not text or any(text in k for k in page.keywords))
            self.nav.item(i).setHidden(not match)
            if match and first is None:
                first = i
        if first is not None and self.nav.item(self.nav.currentRow()).isHidden():
            self.nav.setCurrentRow(first)

    # -------------------------------------------------------- helpers
    def switch(self, filename, key, default=True, enabled=True):
        sw = Switch()
        sw.setEnabled(enabled)
        sw.toggled.connect(lambda on, f=filename, k=key, s=sw: self.on_toggle(f, k, on, s))
        self.switches[(filename, key)] = (sw, default)
        return sw

    def update_button(self, part, label="Update"):
        b = UpdateButton(self, part, label)
        self.update_buttons[part] = b
        return b

    def on_toggle(self, filename, key, on, sw):
        value = "on" if on else "off"
        if self.backend.set_value(filename, key, value):
            haptic("toggle")
            self.changed.emit(filename, key, value)
            if filename == "updates.conf":
                self.update_master_state()
        else:
            sw.set_quiet(not on)
            QMessageBox.warning(self, "Not changed", "The setting couldn't be saved (permission was not given).")

    def on_update_finished(self, part, code):
        if part == "bios" and code == 3:
            self.bios_not_available()
        self.versions = self.backend.versions() or self.versions

    def refresh(self):
        confs = {"features.conf": self.backend.features(), "updates.conf": self.backend.updates()}
        for (filename, key), (sw, default) in self.switches.items():
            if sw.isEnabled():
                sw.set_quiet(is_on(confs[filename], key, default))
        self.update_master_state()

    def choice(self, filename, key, current, options):
        """A drop-down that saves straight to a Gill(OS) setting (reverts if saving isn't allowed)."""
        box = QComboBox()
        for value, label in options:
            box.addItem(label, value)
        values = [v for v, _ in options]
        box.setCurrentIndex(values.index(current) if current in values else 0)
        box.last = box.currentIndex()

        def changed(i):
            if self.backend.set_value(filename, key, box.itemData(i)):
                box.last = i
            else:
                box.blockSignals(True)
                box.setCurrentIndex(box.last)
                box.blockSignals(False)
        box.currentIndexChanged.connect(changed)
        return box

    def update_master_state(self):
        master = self.switches.get(("updates.conf", "all"))
        if not master:
            return
        on = master[0].isChecked()
        for key in ("os", "apps", "containers"):
            self.switches[("updates.conf", key)][0].setEnabled(on)

    def v(self, key, prefix=""):
        value = self.versions.get(key, "")
        return f"{prefix}{value}" if value else "Not installed"

