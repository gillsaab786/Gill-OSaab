    def page_problems(self):
        p = Page("Problems")
        p.keywords += ["errors", "glitches", "crash", "report", "missing driver", "log"]
        intro = QLabel("Errors, crashes, failed services and missing drivers found on this device. Copy the "
                       "report and paste it to get them fixed – names, addresses and serial numbers are removed.")
        intro.setObjectName("note")
        intro.setWordWrap(True)
        p.lay.addWidget(intro)
        bar = QHBoxLayout()
        copy = QPushButton("Copy report")
        copy.setObjectName("primary")
        copy.clicked.connect(lambda: self.copy_report(copy))
        save = QPushButton("Save report…")
        save.clicked.connect(self.save_report)
        check = QPushButton("Check now")
        check.clicked.connect(lambda: self.check_problems(check))
        clear = QPushButton("Clear list")
        clear.clicked.connect(lambda: (self.backend.run(["gosaab-diagnose", "--clear"]), self.fill_problems()))
        for b in (copy, save, check, clear):
            b.setCursor(Qt.PointingHandCursor)
            bar.addWidget(b)
        bar.addStretch(1)
        p.lay.addLayout(bar)
        self.problems_holder = QWidget()
        self.problems_lay = QVBoxLayout(self.problems_holder)
        self.problems_lay.setContentsMargins(0, 0, 0, 0)
        p.lay.addWidget(self.problems_holder)
        self.fill_problems()
        p.finish()
        return p

    def fill_problems(self):
        while self.problems_lay.count():
            w = self.problems_lay.takeAt(0).widget()
            if w:
                w.deleteLater()
        items = self.backend.problems()
        if not items:
            ok = QLabel("●  No problems found")
            ok.setObjectName("ok")
            self.problems_lay.addWidget(Card([Row("All good", "Nothing has gone wrong that needs fixing.", ok)]))
            return
        names = {"security": "Security", "crash": "Crash", "missing-driver": "Missing driver",
                 "missing-firmware": "Missing firmware", "failed-service": "Failed service",
                 "update-failed": "Update failed", "limited-driver": "Limited driver", "error": "Error",
                 "app-error": "App error"}
        rows = []
        for it in items[:80]:
            lab = QLabel(names.get(it["kind"], it["kind"]) + (f" · {it['count']}×" if it.get("count", 1) > 1 else ""))
            lab.setObjectName("bad" if it["kind"] in ("security", "crash", "missing-driver") else "note")
            rows.append(Row(it["title"], it["detail"][:300], lab))
        self.problems_lay.addWidget(Card(rows))
        nav = self.nav.item([t for t, *_ in PAGES].index("Problems")) if hasattr(self, "nav") and self.nav.count() > 0 else None
        if nav:
            nav.setText(f"Problems ({len(items)})")

    def copy_report(self, button):
        QApplication.clipboard().setText(self.backend.problem_report())
        button.setText("Copied ✓")

    def save_report(self):
        from PySide6.QtWidgets import QFileDialog
        path, _ = QFileDialog.getSaveFileName(self, "Save problem report",
                                              str(Path.home() / "Gill(OS) problem report.txt"))
        if path:
            Path(path).write_text(self.backend.problem_report())

    def check_problems(self, button):
        button.setEnabled(False)
        button.setText("Checking…")

        def done(_code):
            button.setEnabled(True)
            button.setText("Check now")
            self.fill_problems()
        self.backend.run_async(["gosaab-diagnose", "--collect"], button, done)

