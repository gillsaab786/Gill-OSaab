def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Gill-OSaab Settings")
    app.setDesktopFileName("gosaab-settings")
    app.setStyleSheet(STYLE)
    w = Settings()
    w.show()
    return app.exec()


