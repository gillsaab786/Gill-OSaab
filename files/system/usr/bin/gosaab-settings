    def page_device(self):
        p = Page("Device")
        hw = self.hw
        model = hw.get("model", {})
        info = [Row("Model", model.get("name") or "Unknown"),
                Row("BIOS", " · ".join(x for x in (model.get("bios_version"), model.get("bios_date")) if x)
                    or "Unknown"),
                Row("Processor", hw.get("cpu") or "Unknown")]
        for g in hw.get("gpus", []):
            info.append(Row("Graphics", f"{g['vendor']} {g['device']}", self.driver_label(g)))
        for n in hw.get("network", []):
            info.append(Row(n.get("kind", "Network"), f"{n['vendor']} {n['device']}", self.driver_label(n)))
        p.section("This device", info)
        self.memory_holder = QWidget()
        self.memory_lay = QVBoxLayout(self.memory_holder)
        self.memory_lay.setContentsMargins(0, 0, 0, 0)
        p.lay.addWidget(self.memory_holder)
        p.keywords += ["memory", "ram", "free up ram", "zram", "compressed memory", "force close"]
        self.fill_memory()
        parts = [Row(d["kind"], f"{d['vendor']} {d['device']}", self.driver_label(d)) for d in hw.get("parts", [])]
        parts += [Row("USB", name, QLabel("●  Connected")) for name in hw.get("usb", [])]
        if parts:
            p.section("Every part and its driver", parts, "Drivers for these come built in and update with the "
                      "system. Printers, scanners, controllers, webcams and USB/Thunderbolt docks work as soon "
                      "as they are plugged in; firmware for them is checked automatically.")

        drivers = QPushButton("Drivers Update ›")
        drivers.setObjectName("pill")
        drivers.clicked.connect(lambda: self.go_to("Drivers Update"))
        p.section("", [Row("Drivers and firmware", "Update, choose, search or roll back drivers.", drivers)])
        limit = QComboBox()
        choices = [("Off (charge to 100%)", "100"), ("90%", "90"), ("80% – best for battery life", "80"),
                   ("60% – always on the charger", "60")]
        for label, value in choices:
            limit.addItem(label, value)
        cur = self.backend.features().get("charge_limit", "100")
        limit.setCurrentIndex(max(0, [v for _, v in choices].index(cur)) if cur in [v for _, v in choices] else 0)
        limit.currentIndexChanged.connect(
            lambda i: self.backend.set_value("features.conf", "charge_limit", limit.itemData(i)))
        p.section("Battery", [Row("Charge limit", "Stops charging early so the battery lasts more years "
                                  "(handhelds and laptops that support it).", limit)])
        p.finish()
        return p

    def fill_memory(self, note=""):
        while self.memory_lay.count():
            w = self.memory_lay.takeAt(0).widget()
            if w:
                w.deleteLater()
        m = self.backend.memory()
        if not m.get("total"):
            return
        gb = lambda b: f"{b / 1024 ** 3:.1f} GB"  # noqa: E731
        bar = QProgressBar()
        bar.setRange(0, 1000)
        bar.setValue(int(m["used"] / m["total"] * 1000))
        bar.setTextVisible(False)
        bar.setFixedWidth(220)
        free_btn = QPushButton("Free up RAM")
        free_btn.setObjectName("pill")
        free_btn.clicked.connect(self.free_memory)
        rows = [Row("Memory in use", f"{gb(m['used'])} of {gb(m['total'])} · {gb(m['available'])} free", bar)]
        z = m.get("zram")
        if z:
            rows.append(Row("Compressed memory", f"{gb(z['stored'])} of idle memory kept in {gb(z['ram'])} – "
                            f"saves {gb(z['saved'])}", QLabel("●  On")))
        else:
            rows.append(Row("Compressed memory", "Starts working after the next restart."))
        rows.append(Row("Hand back cached memory", note or "Memory the system kept as cache for speed goes back "
                        "to free memory.", free_btn))
        p_rows = []
        for a in m.get("apps", [])[:10]:
            if a.get("canClose"):
                b = QPushButton("Force Close")
                b.setObjectName("pill")
                b.clicked.connect(lambda _=False, k=a["key"], n=a["name"]: self.close_app_memory(k, n))
            else:
                b = QLabel("System")
                b.setObjectName("note")
            p_rows.append(Row(a["name"], f"{gb(a['bytes'])} · {a['kind']}", b))
        box = QWidget()
        bl = QVBoxLayout(box)
        bl.setContentsMargins(0, 0, 0, 0)
        for title, rws in (("MEMORY", rows), ("USING THE MOST MEMORY", p_rows)):
            if not rws:
                continue
            lab = QLabel(title)
            lab.setObjectName("sectionLabel")
            bl.addWidget(lab)
            bl.addWidget(Card(rws))
        self.memory_lay.addWidget(box)

    def free_memory(self):
        freed = self.backend.memory_free()
        haptic("success")
        self.fill_memory(f"Freed {freed / 1024 ** 3:.1f} GB." if freed > 50 * 1024 ** 2 else "Nothing more to free.")

    def close_app_memory(self, key, name):
        if QMessageBox.question(self, "Force Close", f"Close {name} now? Unsaved work in it will be lost.") \
                != QMessageBox.Yes:
            return
        self.backend.memory_close(key)
        self.fill_memory()

    def driver_search_section(self, p):
        box = QWidget()
        bl = QVBoxLayout(box)
        bl.setContentsMargins(0, 0, 0, 0)
        self.driver_query = QLineEdit()
        self.driver_query.setObjectName("search")
        self.driver_query.setPlaceholderText("Search any driver: Wi-Fi, Realtek, amdgpu, touchscreen, firmware…")
        self.driver_query.setClearButtonEnabled(True)
        self.driver_query.returnPressed.connect(self.run_driver_search)
        self.driver_query.textChanged.connect(lambda t: self.run_driver_search() if len(t.strip()) >= 3 or not t
                                              else None)
        bl.addWidget(self.driver_query)
        self.driver_results = QWidget()
        self.driver_results_lay = QVBoxLayout(self.driver_results)
        self.driver_results_lay.setContentsMargins(0, 0, 0, 0)
        bl.addWidget(self.driver_results)
        p.lay.addWidget(box)

    def run_driver_search(self):
        while self.driver_results_lay.count():
            w = self.driver_results_lay.takeAt(0).widget()
            if w:
                w.deleteLater()
        q = self.driver_query.text().strip()
        if len(q) < 2:
            return
        results = self.backend.search_drivers(q)
        if not results:
            self.driver_results_lay.addWidget(Card([Row(f"Nothing found for “{q}”", "Not on this device and not "
                                                        "built in. Copy the report in Problems to ask for it.")]))
            return
        rows = []
        for r in results[:40]:
            lab = QLabel(f"●  {r['status']}")
            lab.setObjectName("bad" if r["status"] == "missing" else "ok" if r["status"] in ("in use", "loaded")
                             else "note")
            rows.append(Row(f"{r['name']}", f"{r['type']} · {r['detail']}", lab))
        self.driver_results_lay.addWidget(Card(rows))

    def driver_history_section(self, p):
        hist = self.backend.driver_history()
        if not hist:
            p.section("Driver changes", [Row("Nothing to undo yet", "Each driver or firmware update is listed "
                                             "here, so you can go back if it doesn't work right.")])
            return
        rows = []
        for e in hist[:15]:
            when = __import__("time").strftime("%-d %b %Y", __import__("time").localtime(e.get("time", 0)))
            undo = UpdateButton(self, "undo-" + e["id"], "Go back",
                                command=lambda i=e["id"]: ["gosaab-drivers", "rollback", i])
            undo.setObjectName("pill")
            rows.append(Row(e["name"], f"{when} · {str(e.get('from', ''))[:20]} → {str(e.get('to', ''))[:20]}", undo))
        p.section("Driver changes", rows, "“Go back” puts the version from before that update back.")

    def driver_section(self, p):
        info = self.backend.drivers()
        p.keywords += ["driver", "drivers", "firmware", "rollback", "search driver"] + \
            [f"{x['name']} {x['driver']}".lower() for x in info.get("parts", [])]
        missing = [x for x in info.get("problems", []) if x.get("kind") in ("missing-driver", "missing-firmware")]
        if missing:
            rows = []
            for m in missing:
                lab = QLabel("●  Missing")
                lab.setObjectName("bad")
                rows.append(Row(m["name"], m["detail"], lab))
            p.section("Missing drivers", rows, "Copy the report in Problems and send it to get these added.")
        self.driver_pick = {}
        rows = []
        keys = info.get("keys", {})
        for cat in info.get("categories", []):
            parts = [x for x in info.get("parts", []) if x["category"] == cat]
            names = ", ".join(sorted({x["name"] for x in parts}))
            drivers = ", ".join(sorted({x["driver"] for x in parts if x["driver"]})) or "no driver"
            sw = Switch()
            sw.setChecked(True)
            self.driver_pick[keys.get(cat) or cat.lower().replace(" & ", "-").replace(" ", "-")] = sw
            rows.append(Row(cat, f"{names[:140]} · driver: {drivers}", sw))
        v = info.get("versions", {})
        self.driver_builtin = Switch()
        rows.append(Row("Built-in drivers too", f"Kernel {v.get('kernel') or '?'} · Mesa {v.get('mesa') or '?'} · "
                        f"firmware files {v.get('firmware') or '?'}. Wi-Fi, sound and most drivers live here; "
                        "this updates the system and needs a restart.", self.driver_builtin))
        go = UpdateButton(self, "drivers", "Update selected", command=self.driver_command)
        go.setObjectName("primary")
        self.update_buttons["drivers"] = go
        rows.append(Row("Update the drivers chosen above", "Graphics updates the Mesa/Vulkan drivers games and "
                        "emulators use; every part gets its firmware updates.", go))
        p.section("Choose drivers to update", rows)

    def driver_command(self):
        keys = [k for k, sw in self.driver_pick.items() if sw.isChecked()]
        if not keys and not self.driver_builtin.isChecked():
            return None
        cmd = ["gosaab-drivers", "update", ",".join(keys) if keys else "--builtin"]
        if keys and self.driver_builtin.isChecked():
            cmd.append("--builtin")
        return cmd

    def driver_label(self, dev):
        lab = QLabel(f"●  {dev['driver']}" if dev.get("driver") else "●  No driver")
        lab.setObjectName("ok" if dev.get("driver") else "bad")
        return lab

    def page_security(self):
        p = Page("Apps & Security")
        p.section("Windows apps", [
            Row("Sandbox Windows apps",
                "Each app gets its own private folder and can't see your files. Turn off only for apps "
                "that must open your documents.", self.switch("features.conf", "sandbox_windows_apps")),
        ])
        android = self.switch("features.conf", "android", default=True)
        android.toggled.connect(self.android_toggled)
        p.section("Android apps", [
            Row("Android (with Google Play)", "On: Android is installed and Android apps run in their own windows. "
                "Off: Android and all Android apps and their data are removed (about 3 GB freed).", android),
        ])
        self.security_section(p)
        win = QPushButton("Get Windows apps (Bottles)…")
        win.clicked.connect(lambda: self.backend.run(["flatpak", "run", "com.usebottles.bottles"], wait=False))
        p.lay.addWidget(win)
        p.finish()
        return p

    def security_section(self, p):
        sec = self.backend.security()
        user = os.environ.get("USER", "")

        def state(good, good_text, bad_text, neutral=False):
            lab = QLabel(f"●  {good_text if good else bad_text}")
            lab.setObjectName("ok" if good else ("note" if neutral else "bad"))
            return lab
        weak = user in sec.get("weak_password_users", [])
        change = QPushButton("Change password…")
        change.setObjectName("primary" if weak else "pill")
        change.clicked.connect(lambda: self.backend.run(["foot", "-T", "Change password", "-e", "passwd"], wait=False))
        rows = [Row("Password", "The test build's default password must be changed." if weak else
                    "Your own password is set.", change),
                Row("Firewall", "Blocks connections from other devices unless you allow them.",
                    state(sec.get("firewall", {}).get("active", True), "On", "Off")),
                Row("Remote login (SSH)", "Off unless you need to control this PC from another one.",
                    state(not sec.get("ssh", {}).get("active", False), "Off", "On")),
                Row("Apps sandboxed", "Browser, VLC and Windows apps only see the folders you allow.",
                    state(is_on(self.backend.features(), "sandbox_windows_apps", True), "On", "Off")),
                Row("Secure Boot", "Firmware only starts signed system software (see Secure Boot below).",
                    state(sec.get("secure_boot", False), "On", "Off", neutral=True)),
                Row("Disk encryption", "Your files can't be read if the drive or the device is stolen.",
                    state(sec.get("encrypted", False), "On", "Off"))]
        if weak:
            rows[0].subtitle.setStyleSheet("color: #ff453a;")
        p.section("Security checkup", rows)
        self.encryption_section(p, sec.get("encryption", {}))
        self.face_section(p, self.backend.face_status())
        self.secureboot_section(p, self.backend.secure_boot(), sec.get("encryption", {}))

    def terminal(self, title, cmd):
        return lambda: self.backend.run(["foot", "-T", title, "-e", "sh", "-c",
                                         cmd + "; echo; read -p 'Press Enter to close.' x"], wait=False)

    def face_section(self, p, face):
        if not face.get("available") and not face.get("camera"):
            p.section("Face unlock", [Row("Not available on this device", "Face unlock needs an infrared "
                                          "(Windows Hello) camera; an ordinary camera can be fooled by a photo.")])
            return
        if not face.get("camera"):
            p.section("Face unlock", [Row("No infrared camera found", "Face unlock needs an infrared (Windows "
                                          "Hello) camera, for safety.")])
            return
        on = face.get("enabled")
        b1 = QPushButton("Set up again…" if on else "Set up…")
        b1.setObjectName("pill" if on else "primary")
        b1.clicked.connect(self.terminal("Face unlock", "gosaab-face add"))
        rows = [Row("Unlock with your face", f"Camera: {face.get('camera')}. Look at the screen to unlock it. "
                    "Signing in after a restart and admin approvals still need your password.", b1)]
        if on:
            b2 = QPushButton("Turn off and forget face")
            b2.setObjectName("pill")
            b2.clicked.connect(self.terminal("Face unlock", "gosaab-face remove"))
            rows.append(Row("Face unlock is on", "", b2))
        p.section("Face unlock", rows)

    def secureboot_section(self, p, sb, enc):
        if not sb.get("supported"):
            return
        on = sb.get("enabled")

        def term(text, title, cmd, primary=False):
            b = QPushButton(text)
            b.setObjectName("primary" if primary else "pill")
            b.clicked.connect(self.terminal(title, cmd))
            return b
        lab = QLabel("●  On" if on else "●  Off")
        lab.setObjectName("ok" if on else "note")
        mode = ("On: the PC only starts signed system software and your drive opens by itself with the security "
                "chip. Certificate updates install automatically." if on else
                "Off: simpler and every power tool works. Keep a start-up PIN so the encrypted drive stays safe.")
        rows = [Row("Secure Boot", mode, lab)]
        if sb.get("pending"):
            rows.append(Row("Finish the Secure Boot change", "Locks your drive key to the new setting again.",
                            term("Finish…", "Secure Boot", "gosaab-secureboot finish", primary=True)))
        else:
            note = "Asks your password, then restarts into the BIOS where you switch it (a PC only lets its own " \
                   "BIOS change this). Your files stay encrypted the whole time."
            if not on and sb.get("nvidia_edition"):
                note = "Nvidia's driver isn't signed for Secure Boot, so keep it off on the Nvidia edition."
            rows.append(Row("Turn Secure Boot " + ("off" if on else "on"), note,
                            term("Turn off…" if on else "Turn on…", "Secure Boot",
                                 "gosaab-secureboot turn " + ("off" if on else "on"))))
        if on:
            ok = sb.get("ms_2023_ca")
            cert = QLabel("●  Installed" if ok else "●  Missing")
            cert.setObjectName("ok" if ok else "bad")
            rows.append(Row("Microsoft 2023 certificate", "Needed for future Linux start-up updates; installs "
                            "with device firmware updates.", cert if ok else self.update_button("firmware", "Install")))
        if enc.get("encrypted") and not on:
            rows.append(Row("Handheld without a keyboard?", "The start-up PIN is typed before Gill(OS) starts, "
                            "so it needs a USB keyboard. Turn Secure Boot on instead: the drive then opens by "
                            "itself safely, no PIN needed."))
        p.section("Secure Boot", rows)

    def encryption_section(self, p, enc):
        def button(text, title, cmd, primary=False):
            b = QPushButton(text)
            b.setObjectName("primary" if primary else "pill")
            b.clicked.connect(self.terminal(title, cmd))
            return b
        if not enc.get("encrypted"):
            p.section("Encrypt your files", [
                Row("Install Gill(OS) on this PC, encrypted",
                    "Copies Gill(OS) from this USB to the device's own drive and encrypts the whole drive "
                    "(LUKS2 + the security chip). Everything on that drive is erased; your account comes along.",
                    button("Install…", "Install Gill(OS)", "gosaab-install", primary=True))],
                "Running from the USB stick? Its files aren't encrypted – install to the drive for that.")
            return
        rows = [Row("Start-up PIN", "Asked when the device starts, so a stolen device stays locked. "
                    + ("On." if enc.get("pin") else "Not set – recommended."),
                    button("Change PIN…" if enc.get("pin") else "Add PIN…", "Start-up PIN", "gosaab-encryption pin",
                           primary=not enc.get("pin"))),
                Row("Recovery key", "Opens the drive if the PIN is forgotten or the security chip is reset. "
                    + ("Created." if enc.get("recovery") else "Not created yet."),
                    button("New key…" if enc.get("recovery") else "Create…", "Recovery key",
                           "gosaab-encryption recovery", primary=not enc.get("recovery"))),
                Row("Use a password instead", "For devices without a security chip, or if you prefer typing a "
                    "password at start-up.", button("Use password…", "Start-up password", "gosaab-encryption password"))]
        p.section("Encryption", rows)

