#!/usr/bin/env python3
"""Gill(OS) Settings: every Gill(OS) switch and update in one place."""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/libexec/gill-osaab")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "../libexec/gill-osaab"))
from gosaab_common import ETC, is_on, read_conf  # noqa: E402

from PySide6.QtCore import (QEasingCurve, QProcess, QPropertyAnimation, QRectF, QSize, Qt,  # noqa: E402
                            Property, Signal)
from PySide6.QtGui import QColor, QFont, QIcon, QPainter, QPainterPath, QPixmap  # noqa: E402
from PySide6.QtWidgets import (QAbstractButton, QProgressBar, QApplication, QButtonGroup, QComboBox, QFrame, QSlider,  # noqa: E402
                               QGraphicsOpacityEffect, QHBoxLayout, QLabel, QLineEdit, QListWidget,
                               QListWidgetItem, QMainWindow, QMessageBox, QPushButton, QScrollArea, QSpinBox,
                               QStackedWidget, QVBoxLayout, QWidget)

DEFAULT_ACCENT = "#0a84ff"  # same as the desktop's (Theme.qml)
ACCENT = QColor(DEFAULT_ACCENT)
VERSION_FILE = Path("/usr/share/gill-osaab/version")
UPDATER = "gosaab-update-component"
FREQUENCIES = [("daily", "Every day"), ("weekly", "Every week"), ("2weeks", "Every 2 weeks"),
               ("monthly", "Every month"), ("2months", "Every 2 months"), ("3months", "Every 3 months"),
               ("6months", "Every 6 months"), ("yearly", "Once a year"), ("never", "Never")]
RESULT_TEXT = {0: "Updated", 4: "Up to date", 3: "Not available", 1: "Failed – retry"}


# ------------------------------------------------------------------ backend
class Backend:
    """Everything that touches the system lives here (tests swap in a fake)."""

    def __init__(self):
        self.etc = ETC

    def features(self):
        return read_conf(self.etc / "features.conf")

    def updates(self):
        return read_conf(self.etc / "updates.conf")

    def set_value(self, filename, key, value):
        cmd = ["gosaab-config", "set", filename, key, value]
        if os.geteuid() != 0 and shutil.which("pkexec"):
            cmd = ["pkexec", "/usr/bin/gosaab-config", "set", filename, key, value]
        return subprocess.run(cmd, check=False).returncode == 0

    # ---- memory (Settings > Device)
    MEMORY = "/usr/libexec/gill-osaab/gosaab-memory"

    def memory(self):
        try:
            out = subprocess.run([self.MEMORY, "list"], capture_output=True, text=True, timeout=10, check=False)
            return json.loads(out.stdout)
        except (OSError, ValueError, subprocess.SubprocessError):
            return {}

    def memory_close(self, key):
        return subprocess.run([self.MEMORY, "close", key], capture_output=True, timeout=30,
                              check=False).returncode == 0

    def memory_free(self):
        try:
            out = subprocess.run([self.MEMORY, "free"], capture_output=True, text=True, timeout=60, check=False)
            return json.loads(out.stdout).get("freed", 0)
        except (OSError, ValueError, subprocess.SubprocessError):
            return 0

    # ---- per-game profiles (Settings > Game Mode)
    def game_profiles(self):
        import gosaab_profiles
        return gosaab_profiles.load()

    def set_profile(self, key, profile):
        cmd = ["gosaab-config", "profile", "set", key, json.dumps(profile)]
        if os.geteuid() != 0 and shutil.which("pkexec"):
            cmd = ["pkexec", "/usr/bin/gosaab-config"] + cmd[1:]
        return subprocess.run(cmd, check=False).returncode == 0

    def remove_profile(self, key):
        cmd = ["gosaab-config", "profile", "remove", key]
        if os.geteuid() != 0 and shutil.which("pkexec"):
            cmd = ["pkexec", "/usr/bin/gosaab-config"] + cmd[1:]
        return subprocess.run(cmd, check=False).returncode == 0

    def known_games(self):
        """Installed Steam games, plus the game running now (from Smart TDP's status)."""
        import gosaab_profiles
        games = gosaab_profiles.steam_games(Path.home())
        try:
            g = json.loads(Path("/run/gill-osaab/power.json").read_text()).get("game") or {}
            if g.get("key") and all(k != g["key"] for k, _ in games):
                games.insert(0, (g["key"], g.get("name") or g["key"].split(":", 1)[1]))
        except (OSError, ValueError, AttributeError):
            pass
        return games

    def run(self, cmd, wait=True):
        if wait:
            return subprocess.run(cmd, check=False).returncode == 0
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True

    def run_async(self, cmd, parent, done):
        """Run without freezing the window; done(exit_code) is called at the end."""
        proc = QProcess(parent)
        env = proc.processEnvironment()
        if env.isEmpty():
            from PySide6.QtCore import QProcessEnvironment
            env = QProcessEnvironment.systemEnvironment()
        env.insert("GOSAAB_PROGRESS_STDOUT", "1")
        proc.setProcessEnvironment(env)
        proc.finished.connect(lambda code, _status: done(code))
        proc.errorOccurred.connect(lambda _err: done(1) if proc.state() == QProcess.NotRunning else None)
        proc.start(cmd[0], cmd[1:])
        return proc

    def versions(self):
        try:
            out = subprocess.run([UPDATER, "--versions"], capture_output=True, text=True, timeout=10, check=False)
            return json.loads(out.stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return {}

    def hardware(self):
        try:
            import gosaab_hw
            return gosaab_hw.summary()
        except Exception:
            return {"model": {}, "cpu": "", "gpus": [], "network": [], "nvidia": False, "support_page": ""}

    def have(self, tool):
        return shutil.which(tool) is not None

    def service_active(self, unit):
        if not shutil.which("systemctl"):
            return False
        return subprocess.run(["systemctl", "is-active", "--quiet", unit], check=False).returncode == 0

    def module_loaded(self, name):
        try:
            return any(line.split()[0] == name for line in Path("/proc/modules").read_text().splitlines())
        except OSError:
            return False

    # ---- Game Mode (Core edition)
    BOOT_STATE = Path("/etc/gill-osaab/boot-mode")
    LSFG_CONF = Path.home() / ".config/lsfg-vk/conf.toml"

    def boot_mode(self):
        try:
            return self.BOOT_STATE.read_text().strip() or "auto"
        except OSError:
            return "auto"

    def set_boot_mode(self, mode):
        user = os.environ.get("USER", "")
        return self.run(["pkexec", "/usr/libexec/gill-osaab/gosaab-session-select-root", "--boot", user, mode])

    def frame_gen_enabled(self):
        return self.LSFG_CONF.exists()

    def set_frame_gen(self, on, multiplier=2):
        if on:
            self.LSFG_CONF.parent.mkdir(parents=True, exist_ok=True)
            self.LSFG_CONF.write_text(
                "# Gill(OS) frame generation. Games opt in with the Steam launch option:\n"
                "#   LSFG_PROCESS=gosaab %command%\n"
                "version = 1\n\n[[game]]\nexe = \"gosaab\"\n"
                f"multiplier = {multiplier}\nflow_scale = 0.8\nperformance_mode = true\n")
        elif self.LSFG_CONF.exists():
            self.LSFG_CONF.unlink()
        return 0

    INPUT_CONF = Path.home() / ".config/gill-osaab/input.conf"

    def input_setting(self, key, default=True):
        try:
            for line in self.INPUT_CONF.read_text().splitlines():
                if line.startswith(key + "="):
                    return line.split("=", 1)[1].strip() == "on"
        except OSError:
            pass
        return default

    def set_input_setting(self, key, on):
        lines = []
        try:
            lines = [ln for ln in self.INPUT_CONF.read_text().splitlines() if not ln.startswith(key + "=")]
        except OSError:
            pass
        lines.append(f"{key}={'on' if on else 'off'}")
        self.INPUT_CONF.parent.mkdir(parents=True, exist_ok=True)
        self.INPUT_CONF.write_text("\n".join(lines) + "\n")
        subprocess.run(["pkill", "-RTMIN+2", "-x", "gosaab-wm"], check=False)  # apply now
        return 0

    # ---- VPN (NetworkManager: WireGuard, OpenVPN...)
    def vpn_connections(self):
        """[(name, type, active)] of VPN connections."""
        out = subprocess.run(["nmcli", "-t", "-f", "NAME,TYPE,ACTIVE", "connection", "show"],
                             capture_output=True, text=True, check=False).stdout
        conns = []
        for line in out.splitlines():
            parts = line.replace("\\:", "\0").split(":")
            if len(parts) >= 3 and parts[1] in ("wireguard", "vpn"):
                conns.append((parts[0].replace("\0", ":"), parts[1], parts[2] == "yes"))
        return conns

    def vpn_import(self, path):
        kind = "wireguard" if path.endswith(".conf") else "openvpn"
        return self.run(["nmcli", "connection", "import", "type", kind, "file", path])

    def vpn_set(self, name, up):
        return self.run(["nmcli", "connection", "up" if up else "down", "id", name])

    # ---- cloud drives (rclone: Google Drive, OneDrive, Dropbox, ... several accounts each)
    def cloud_remotes(self):
        out = subprocess.run(["rclone", "listremotes"], capture_output=True, text=True, check=False).stdout
        return [r.rstrip(":") for r in out.split() if r.endswith(":")]

    def cloud_mounted(self, remote):
        return subprocess.run(["systemctl", "--user", "is-active", "--quiet", f"gosaab-cloud@{remote}.service"],
                              check=False).returncode == 0

    def cloud_mount(self, remote, on):
        return self.run(["systemctl", "--user", "enable" if on else "disable", "--now",
                         f"gosaab-cloud@{remote}.service"])

    def cloud_add(self):
        return self.run(["foot", "-T", "Add a cloud drive", "-e", "sh", "-c",
                         "echo 'Choose n (new), give it a name, pick Google Drive / OneDrive / Dropbox...';"
                         " rclone config; echo; read -p 'Done. Press Enter to close.' x"], wait=False)

    GLASSES_CONF = Path.home() / ".config/gill-osaab/glasses.conf"

    # 3DS emulators keep their 3D depth in their own config ("factor_3d", 0-100)
    DEPTH_FILES = [Path.home() / p for p in (
        ".config/azahar-emu/qt-config.ini", ".config/citra-emu/qt-config.ini", ".config/lime3ds-emu/qt-config.ini",
        ".var/app/org.azahar_emu.Azahar/config/azahar-emu/qt-config.ini",
        ".var/app/io.github.lime3ds.Lime3DS/config/lime3ds-emu/qt-config.ini")]

    def depth_3d(self):
        for f in self.DEPTH_FILES:
            try:
                for line in f.read_text().splitlines():
                    if line.startswith("factor_3d=") or line.startswith("factor_3d\\default=false"):
                        if line.startswith("factor_3d="):
                            return int(line.split("=", 1)[1] or 50)
            except (OSError, ValueError):
                pass
        return 50

    def set_depth_3d(self, value):
        import re
        changed = 0
        for f in self.DEPTH_FILES:
            try:
                text = f.read_text()
            except OSError:
                continue
            text = re.sub(r"(?m)^factor_3d\\default=.*$", "factor_3d\\\\default=false", text)
            if re.search(r"(?m)^factor_3d=", text):
                text = re.sub(r"(?m)^factor_3d=.*$", f"factor_3d={int(value)}", text)
            else:
                text = text.replace("[Renderer]", f"[Renderer]\nfactor_3d={int(value)}\nfactor_3d\\default=false", 1)
            f.write_text(text)
            changed += 1
        return changed

    def glasses_status(self):
        out = subprocess.run(["gosaab-glasses", "status"], capture_output=True, text=True, check=False).stdout
        return out.strip() or "No glasses connected"

    def glasses_profiles(self):
        try:
            return dict(ln.split("=", 1) for ln in self.GLASSES_CONF.read_text().splitlines()
                        if "=" in ln and not ln.startswith("#"))
        except OSError:
            return {}

    def set_glasses_profiles(self, profiles):
        self.GLASSES_CONF.parent.mkdir(parents=True, exist_ok=True)
        self.GLASSES_CONF.write_text("# app-id=3d|2d|only|extend (applied when the app is in front)\n" +
                                     "".join(f"{k}={v}\n" for k, v in profiles.items()))
        return 0

    APP_FOLDERS = Path.home() / ".config/gill-osaab/app-folders"

    def sandboxed_apps(self):
        """(id, label) of apps that run sealed off: Firefox, VLC and every Windows app."""
        apps = [("brave", "Brave (downloads)"), ("vlc", "VLC (videos and music)"),
                ("android", "Android downloads (1 folder; Android's files are in ~/Android)")]
        wine = Path.home() / ".local/share/gill-osaab/wine"
        if wine.is_dir():
            apps += [(d.name, f"Windows app: {d.name}") for d in sorted(wine.iterdir()) if d.is_dir()]
        return apps

    def app_folders(self, app):
        try:
            return [ln.strip() for ln in (self.APP_FOLDERS / f"{app}.conf").read_text().splitlines()
                    if ln.strip() and not ln.startswith("#")][:2]
        except OSError:
            return []

    def set_app_folders(self, app, folders):
        self.APP_FOLDERS.mkdir(parents=True, exist_ok=True)
        (self.APP_FOLDERS / f"{app}.conf").write_text("".join(f + "\n" for f in folders[:2]))
        return 0

    # ---- drivers, problems, shortcuts, security
    def _json(self, cmd, default, timeout=30):
        if not shutil.which(cmd[0]):
            return default
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
            return json.loads(out.stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return default

    def drivers(self, check=False):
        state = Path("/var/lib/gill-osaab/drivers.json")
        if not check and state.exists():  # recorded at start-up (includes firmware that failed to load)
            try:
                return json.loads(state.read_text())
            except (OSError, ValueError):
                pass
        return self._json(["gosaab-drivers", "list"] + (["--check"] if check else []),
                          {"parts": [], "categories": [], "problems": [], "versions": {}}, 120 if check else 30)

    def problems(self):
        return self._json(["gosaab-diagnose", "--json"], [])

    def problem_report(self):
        out = subprocess.run(["gosaab-diagnose", "--report"], capture_output=True, text=True, check=False) \
            if shutil.which("gosaab-diagnose") else None
        return out.stdout if out else "gosaab-diagnose is not installed."

    def hotkeys(self):
        return self._json(["gosaab-hotkeys", "list"], {})

    def hotkey_actions(self):
        return self._json(["gosaab-hotkeys", "actions"], {})

    def set_hotkey(self, combo, action):
        return self.have("gosaab-hotkeys") and subprocess.run(
            ["gosaab-hotkeys", "set", combo, action], capture_output=True, check=False).returncode == 0

    def remove_hotkey(self, combo):
        return subprocess.run(["gosaab-hotkeys", "remove", combo], check=False).returncode == 0

    def face_status(self):
        return self._json(["gosaab-face", "status"], {})

    def secure_boot(self):
        return self._json(["gosaab-secureboot", "status"], {})

    def last_update_text(self):
        import time as _t
        try:
            ts = float(Path("/var/lib/gill-osaab/last-auto-update").read_text().strip())
            return _t.strftime("%-d %B %Y", _t.localtime(ts))
        except (OSError, ValueError):
            return "Not yet"

    def power_status(self):
        try:
            return json.loads(Path("/run/gill-osaab/power.json").read_text())
        except (OSError, ValueError):
            return {}

    def gpu_status(self):
        return self._json(["gosaab-gpu", "status"], {})

    def fps_status(self):
        return self._json(["gosaab-fps", "status"], {})

    def search_drivers(self, query):
        return self._json(["gosaab-drivers", "search", query], [], 30)

    def driver_history(self):
        return self._json(["gosaab-drivers", "history"], [])

    def security(self):
        try:
            return json.loads(Path("/run/gill-osaab/security.json").read_text())
        except (OSError, ValueError):
            return {}

    def desktop_apps(self):
        """(desktop id, name) of every app in the menus."""
        dirs = [Path.home() / ".local/share/applications", Path("/var/lib/flatpak/exports/share/applications"),
                Path.home() / ".local/share/flatpak/exports/share/applications", Path("/usr/share/applications")]
        apps = {}
        for d in dirs:
            for f in sorted(d.glob("*.desktop")) if d.is_dir() else []:
                try:
                    text = f.read_text(errors="replace")
                except OSError:
                    continue
                if "NoDisplay=true" in text or f.stem in apps:
                    continue
                name = next((ln[5:] for ln in text.splitlines() if ln.startswith("Name=")), f.stem)
                apps[f.stem] = name
        return sorted(apps.items(), key=lambda kv: kv[1].lower())

    def decky_plugin_installed(self):
        return (Path.home() / "homebrew/plugins/gill-osaab-notify/plugin.json").exists()

    def kde_night_light(self):
        out = subprocess.run(["kreadconfig6", "--file", "kwinrc", "--group", "NightColor", "--key", "Active"],
                             capture_output=True, text=True, check=False) if self.have("kreadconfig6") else None
        return bool(out and out.stdout.strip() == "true")

    def color_scheme(self):
        if not self.have("kreadconfig6"):
            return "GillOSaabDark"
        out = subprocess.run(["kreadconfig6", "--group", "General", "--key", "ColorScheme"],
                             capture_output=True, text=True, check=False)
        return out.stdout.strip() or "GillOSaabDark"

    # ---- appearance shared with the shell (menu bar, Dock, widgets): ~/.config/gill-osaab/appearance.json
    APPEARANCE = Path.home() / ".config/gill-osaab/appearance.json"
    WALLPAPERS = Path("/usr/share/wallpapers")

    def appearance(self):
        try:
            data = json.loads(self.APPEARANCE.read_text())
            return data if isinstance(data, dict) else {}
        except (OSError, ValueError):
            return {}

    def set_appearance(self, key, value):
        data = self.appearance()
        data[key] = value
        self.APPEARANCE.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.APPEARANCE.with_suffix(".tmp")
        tmp.write_text(json.dumps(data, indent=2) + "\n")
        os.replace(tmp, self.APPEARANCE)  # the shell watches the file and follows at once
        return True

    def wallpaper_thumb(self, folder, dark):
        """A small preview (thumb-*.jpg ships next to each wallpaper; the 4K picture is the fallback)."""
        contents = self.WALLPAPERS / folder / "contents"
        for path in (contents / ("thumb-dark.jpg" if dark else "thumb-light.jpg"),
                     contents / ("images_dark" if dark else "images") / "3840x2160.png"):
            if path.exists():
                return str(path)
        return ""

    # ---- ROG Ally stick lights (gosaab-ally-lights service)
    def lights_status(self):
        try:
            return json.loads(Path("/run/gill-osaab/lights.json").read_text())
        except (OSError, ValueError):
            pass
        try:
            import gosaab_lights
            return {"ally": gosaab_lights.is_rog_ally(), "backend": None}
        except Exception:
            return {"ally": False, "backend": None}


# ------------------------------------------------------------------ HD icon tiles
def draw_glyph(p, name, size):
    """White line icons on a 24-unit grid, drawn in code so they never depend on an icon theme.
    Returns False for a name it doesn't know."""
    from PySide6.QtCore import QPointF
    from PySide6.QtGui import QPen
    k = size / 24
    pen = QPen(QColor("white"), 2 * k)
    pen.setCapStyle(Qt.RoundCap)
    pen.setJoinStyle(Qt.RoundJoin)
    p.setPen(pen)
    p.setBrush(Qt.NoBrush)

    def pt(x, y):
        return QPointF(x * k, y * k)

    def poly(*xy, close=False, fill=False):
        path = QPainterPath(pt(xy[0], xy[1]))
        for i in range(2, len(xy), 2):
            path.lineTo(pt(xy[i], xy[i + 1]))
        if close:
            path.closeSubpath()
        p.fillPath(path, QColor("white")) if fill else p.drawPath(path)

    def rect(x, y, w, h, r, fill=False):
        path = QPainterPath()
        path.addRoundedRect(QRectF(x * k, y * k, w * k, h * k), r * k, r * k)
        p.fillPath(path, QColor("white")) if fill else p.drawPath(path)

    def circle(x, y, r, fill=False):
        if fill:
            p.setBrush(QColor("white"))
        p.drawEllipse(pt(x, y), r * k, r * k)
        p.setBrush(Qt.NoBrush)

    def arc(x, y, r, start, span):
        p.drawArc(QRectF((x - r) * k, (y - r) * k, 2 * r * k, 2 * r * k), int(start * 16), int(span * 16))

    if name == "update":
        arc(12, 12, 7.5, 30, 250)
        poly(17.5, 4.5, 18.6, 8.6, 14.5, 9.4)
        poly(12, 8, 12, 12.5, 15, 14)
    elif name == "warning":
        poly(12, 3.5, 21.5, 20, 2.5, 20, close=True)
        poly(12, 9.5, 12, 14)
        circle(12, 17, 0.6, fill=True)
    elif name == "chip":
        rect(6.5, 6.5, 11, 11, 2)
        rect(9.5, 9.5, 5, 5, 1, fill=True)
        for i in (9, 12, 15):
            poly(i, 3, i, 6.5)
            poly(i, 17.5, i, 21)
            poly(3, i, 6.5, i)
            poly(17.5, i, 21, i)
    elif name == "shield":
        poly(12, 3, 19.5, 6, 19, 13, 12, 21, 5, 13, 4.5, 6, close=True)
        poly(8.8, 12, 11.2, 14.4, 15.5, 9.6)
    elif name == "folder":
        poly(3, 7, 3, 18.5, 21, 18.5, 21, 8.5, 11.5, 8.5, 9.5, 5.5, 4.5, 5.5, 3, 7)
    elif name == "globe":
        circle(12, 12, 8.5)
        p.drawEllipse(pt(12, 12), 3.8 * k, 8.5 * k)
        poly(3.5, 12, 20.5, 12)
    elif name == "glasses":
        rect(2.5, 9, 8, 6.5, 3)
        rect(13.5, 9, 8, 6.5, 3)
        poly(10.5, 11, 13.5, 11)
    elif name == "bell":
        poly(6, 16.5, 6, 11, close=False)
        arc(12, 11, 6, 0, 180)
        poly(18, 11, 18, 16.5)
        poly(4.5, 17, 19.5, 17)
        arc(12, 18.5, 2, 180, 180)
    elif name == "moon":
        path = QPainterPath()
        path.addEllipse(pt(12, 12), 8 * k, 8 * k)
        cut = QPainterPath()
        cut.addEllipse(pt(16.5, 8.5), 7 * k, 7 * k)
        p.fillPath(path.subtracted(cut), QColor("white"))
    elif name == "palette":
        circle(12, 12, 8.5)
        path = QPainterPath(pt(12, 3.5))
        path.arcTo(QRectF(3.5 * k, 3.5 * k, 17 * k, 17 * k), 90, 180)
        path.closeSubpath()
        p.fillPath(path, QColor("white"))
    elif name == "gamepad":
        path = QPainterPath()
        path.addRoundedRect(QRectF(2.5 * k, 7 * k, 19 * k, 11 * k), 5.5 * k, 5.5 * k)
        p.drawPath(path)
        poly(7.5, 10.5, 7.5, 14.5)
        poly(5.5, 12.5, 9.5, 12.5)
        circle(15.5, 11.5, 0.9, fill=True)
        circle(17.8, 13.6, 0.9, fill=True)
    elif name == "keyboard":
        rect(2.5, 6.5, 19, 11, 2.5)
        for x in (6, 9.5, 13, 16.5):
            circle(x, 10, 0.7, fill=True)
        poly(7.5, 14, 16.5, 14)
    elif name == "plus":
        circle(12, 12, 8.5)
        poly(12, 8, 12, 16)
        poly(8, 12, 16, 12)
    elif name == "info":
        circle(12, 12, 8.5)
        poly(12, 11, 12, 16.5)
        circle(12, 7.8, 0.7, fill=True)
    elif name == "lights":  # a glowing stick ring
        circle(12, 12, 7.5)
        circle(12, 12, 3.2, fill=True)
        for a in range(0, 360, 45):
            import math
            c, sn = math.cos(math.radians(a)), math.sin(math.radians(a))
            poly(12 + c * 9.5, 12 + sn * 9.5, 12 + c * 11, 12 + sn * 11)
    elif name == "layers":  # translation layers: three stacked sheets
        for i, y in enumerate((14.5, 11, 7.5)):
            poly(12, y - 4, 20, y, 12, y + 4, 4, y, close=True, fill=(i == 2))
    elif name == "wrench":
        poly(14.5, 9.5, 5, 19)
        arc(16.5, 7.5, 4, -40, 260)
        circle(5.3, 18.7, 1.2, fill=True)
    elif name == "screen":
        rect(3, 4.5, 18, 12, 2)
        poly(9, 20, 15, 20)
        poly(12, 16.5, 12, 20)
    else:
        return False
    return True


def tile_icon(color, glyph, letter):
    """iOS-style icon: white glyph on a rounded colour square with a soft top light, drawn at
    1x/2x/3x so it stays sharp on high-resolution screens."""
    from PySide6.QtGui import QLinearGradient
    icon = QIcon()
    theme = QIcon.fromTheme(glyph)
    for scale in (1, 2, 3):
        size = 28 * scale
        pm = QPixmap(size, size)
        pm.fill(Qt.transparent)
        p = QPainter(pm)
        p.setRenderHint(QPainter.Antialiasing)
        path = QPainterPath()
        path.addRoundedRect(QRectF(0, 0, size, size), size * 0.26, size * 0.26)
        grad = QLinearGradient(0, 0, 0, size)
        grad.setColorAt(0, QColor(color).lighter(122))
        grad.setColorAt(1, QColor(color))
        p.fillPath(path, grad)
        inner = int(size * 0.62)
        off = (size - inner) / 2
        p.save()
        p.translate(off, off)
        drawn = draw_glyph(p, glyph, inner)
        p.restore()
        glyph_pm = theme.pixmap(inner, inner) if not drawn and not theme.isNull() else QPixmap()
        if drawn:
            pass
        elif not glyph_pm.isNull():
            white = QPixmap(glyph_pm.size())
            white.fill(Qt.transparent)
            gp = QPainter(white)
            gp.drawPixmap(0, 0, glyph_pm)
            gp.setCompositionMode(QPainter.CompositionMode_SourceIn)
            gp.fillRect(white.rect(), QColor("white"))
            gp.end()
            p.drawPixmap(QRectF(off, off, inner, inner), white, QRectF(white.rect()))
        else:
            font = QFont("Inter")
            font.setPixelSize(int(size * 0.5))
            font.setWeight(QFont.DemiBold)
            p.setFont(font)
            p.setPen(QColor("white"))
            p.drawText(QRectF(0, 0, size, size), Qt.AlignCenter, letter)
        p.end()
        icon.addPixmap(pm)
    return icon


# ------------------------------------------------------------------ widgets
class Switch(QAbstractButton):
    """iOS-style toggle switch with a sliding knob."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setCheckable(True)
        self.setCursor(Qt.PointingHandCursor)
        self.setFixedSize(52, 30)
        self._pos = 0.0
        self._anim = QPropertyAnimation(self, b"knob", self)
        self._anim.setDuration(180)
        self._anim.setEasingCurve(QEasingCurve.OutCubic)
        self.toggled.connect(self._animate)

    def _animate(self, checked):
        self._anim.stop()
        self._anim.setStartValue(self._pos)
        self._anim.setEndValue(1.0 if checked else 0.0)
        self._anim.start()

    def set_quiet(self, checked):
        self.blockSignals(True)
        self.setChecked(checked)
        self._pos = 1.0 if checked else 0.0
        self.blockSignals(False)
        self.update()

    def get_knob(self):
        return self._pos

    def set_knob(self, value):
        self._pos = value
        self.update()

    knob = Property(float, get_knob, set_knob)

    def sizeHint(self):
        return QSize(52, 30)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        off = QColor(72, 72, 78)
        t = self._pos
        track = QColor(int(off.red() + (ACCENT.red() - off.red()) * t),
                       int(off.green() + (ACCENT.green() - off.green()) * t),
                       int(off.blue() + (ACCENT.blue() - off.blue()) * t))
        if not self.isEnabled():
            track.setAlpha(90)
        p.setPen(Qt.NoPen)
        p.setBrush(track)
        p.drawRoundedRect(QRectF(0, 0, 52, 30), 15, 15)
        p.setBrush(QColor(0, 0, 0, 40))
        x = 3 + t * 22
        p.drawEllipse(QRectF(x, 4, 24, 24))  # soft knob shadow
        p.setBrush(QColor(255, 255, 255, 255 if self.isEnabled() else 150))
        p.drawEllipse(QRectF(x, 3, 24, 24))


def progress_ring_pixmap(percent, size):
    """Track + mint arc with round ends (the same ring the shell and boot screen use)."""
    ratio = 2
    pm = QPixmap(size * ratio, size * ratio)
    pm.fill(Qt.transparent)
    pm.setDevicePixelRatio(ratio)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    from PySide6.QtGui import QPen
    width = max(3, size * 0.14)
    rect = QRectF(width / 2 + 0.5, width / 2 + 0.5, size - width - 1, size - width - 1)
    p.setPen(QPen(QColor("#2c2c2e"), width))
    p.drawEllipse(rect)
    if percent > 0:
        pen = QPen(QColor("#6fe3b0"), width)
        pen.setCapStyle(Qt.RoundCap)
        p.setPen(pen)
        p.drawArc(rect, 90 * 16, -int(360 * 16 * min(100, percent) / 100))
    p.end()
    return pm


class UpdateButton(QPushButton):
    """Runs one updater part in the background and shows the result."""

    def __init__(self, window, part, label="Update", command=None):
        super().__init__(label)
        self.window, self.part, self.label = window, part, label
        self.command = command  # callable -> argv, for jobs other than gosaab-update-component
        self.setObjectName("pill")
        self.setCursor(Qt.PointingHandCursor)
        self.clicked.connect(self.start)
        self.proc = None
        self.last_code = None

    def start(self):
        cmd = self.command() if self.command else [UPDATER, self.part]
        if not cmd:
            return
        self.setEnabled(False)
        self.show_progress(0)
        self.proc = self.window.backend.run_async(cmd, self, self.finished)
        if hasattr(self.proc, "readyReadStandardOutput"):
            self.proc.readyReadStandardOutput.connect(self.read_progress)

    def read_progress(self):
        for line in bytes(self.proc.readAllStandardOutput()).decode(errors="ignore").splitlines():
            if line.startswith("GOSAAB_PROGRESS "):
                try:
                    self.show_progress(int(line.split()[1]))
                except ValueError:
                    pass

    def show_progress(self, percent):
        """Liquid Glass ring with the percentage, instead of a spinner."""
        self.setIcon(QIcon(progress_ring_pixmap(percent, 26)))
        self.setIconSize(QSize(26, 26))
        self.setText(f"{percent}%")

    def finished(self, code):
        self.setIcon(QIcon())
        self.last_code = code
        self.setEnabled(True)
        self.setText(RESULT_TEXT.get(code, RESULT_TEXT[1]))
        haptic("success" if code in (0, 4) else "error")
        self.window.on_update_finished(self.part, code)


def haptic(kind="toggle"):
    """A light buzz from the built-in controller (gosaab-haptic service); silent if there isn't one."""
    import socket
    path = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "gosaab-haptic.sock"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.2)
            s.connect(str(path))
            s.sendall(kind.encode() + b"\n")
    except OSError:
        pass


class PreviewTile(QAbstractButton):
    """A picture you pick, with its name under it (Appearance: mode, icon style, wallpaper).
    paint(painter, rect) draws the picture; the chosen tile gets an accent ring."""

    def __init__(self, label, paint, width=118, height=78):
        super().__init__()
        self.setCheckable(True)
        self.setCursor(Qt.PointingHandCursor)
        self.label, self.paint_fn = label, paint
        self.pic = QSize(width, height)
        self.setFixedSize(width + 8, height + 30)
        self.setAccessibleName(label)

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(4, 4, self.pic.width(), self.pic.height())
        clip = QPainterPath()
        clip.addRoundedRect(r, 10, 10)
        p.save()
        p.setClipPath(clip)
        self.paint_fn(p, r)
        p.restore()
        from PySide6.QtGui import QPen
        p.setPen(QPen(ACCENT if self.isChecked() else QColor(255, 255, 255, 40), 3 if self.isChecked() else 1))
        p.drawRoundedRect(r.adjusted(-1.5, -1.5, 1.5, 1.5), 11.5, 11.5)
        p.setPen(QColor("#ffffff") if self.isChecked() else QColor("#b8b8c0"))
        f = QFont("Inter")
        f.setPixelSize(12)
        f.setWeight(QFont.DemiBold if self.isChecked() else QFont.Normal)
        p.setFont(f)
        p.drawText(QRectF(0, r.bottom() + 6, self.width(), 18), Qt.AlignHCenter, self.label)


class ColorDot(QAbstractButton):
    """A round colour swatch; the chosen one shows a white ring."""

    def __init__(self, color, name):
        super().__init__()
        self.setCheckable(True)
        self.setCursor(Qt.PointingHandCursor)
        self.color = QColor(color)
        self.setToolTip(name)
        self.setAccessibleName(name)
        self.setFixedSize(30, 30)

    def paintEvent(self, _):
        from PySide6.QtGui import QPen
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        p.setPen(Qt.NoPen)
        p.setBrush(self.color)
        p.drawEllipse(QRectF(5, 5, 20, 20))
        if self.isChecked():
            p.setBrush(Qt.NoBrush)
            p.setPen(QPen(QColor("white"), 2))
            p.drawEllipse(QRectF(1.5, 1.5, 27, 27))


def picker(options, current, on_pick, spacing=10):
    """A row of PreviewTiles/ColorDots that act as one choice. options: [(value, widget)]."""
    box = QWidget()
    lay = QHBoxLayout(box)
    lay.setContentsMargins(0, 0, 0, 0)
    lay.setSpacing(spacing)
    group = QButtonGroup(box)
    group.setExclusive(True)
    for value, w in options:
        w.setChecked(value == current)
        w.clicked.connect(lambda _=False, v=value: (haptic("tick"), on_pick(v)))
        group.addButton(w)
        lay.addWidget(w)
    lay.addStretch(1)
    box.group = group
    return box


def segmented(options, current, on_pick):
    """macOS-style segmented control. options: [(value, label)]."""
    box = QWidget()
    lay = QHBoxLayout(box)
    lay.setContentsMargins(0, 0, 0, 0)
    lay.setSpacing(0)
    group = QButtonGroup(box)
    for i, (value, label) in enumerate(options):
        b = QPushButton(label)
        b.setCheckable(True)
        b.setObjectName("segLeft" if i == 0 else "segRight" if i == len(options) - 1 else "segMid")
        b.setChecked(value == current)
        b.clicked.connect(lambda _=False, v=value: (haptic("tick"), on_pick(v)))
        group.addButton(b)
        lay.addWidget(b)
    box.group = group
    return box


ACCENTS = [("#0a84ff", "Blue"), ("#1fb6c9", "Teal"), ("#bf5af2", "Purple"), ("#ff375f", "Pink"), ("#ff453a", "Red"),
           ("#ff9f0a", "Orange"), ("#ffd60a", "Yellow"), ("#30d158", "Green"), ("#8e8e93", "Graphite")]
LIGHT_COLORS = [("0a84ff", "Blue"), ("64d2ff", "Cyan"), ("30d158", "Green"), ("ffd60a", "Yellow"),
                ("ff9f0a", "Orange"), ("ff2d55", "Red"), ("ff64d2", "Pink"), ("bf5af2", "Purple"), ("ffffff", "White")]
WIDGETS = [("clock", "Clock", True), ("weather", "Weather", True), ("calendar", "Calendar", True),
           ("battery", "Battery", True), ("nowPlaying", "Now Playing", True), ("stats", "Processor & Memory", False)]


def paint_icon_style(style):
    """Sample app icon in one of the four Icon & widget styles."""
    def paint(p, r):
        from PySide6.QtGui import QLinearGradient
        bg = QLinearGradient(r.topLeft(), r.bottomLeft())
        bg.setColorAt(0, QColor("#2a4f9c"))
        bg.setColorAt(1, QColor("#0d1d45"))
        p.fillRect(r, bg)
        size = r.height() * 0.62
        for i, hue in enumerate((QColor("#ff9f0a"), QColor("#30d158"))):
            x = r.center().x() - size - 4 + i * (size + 8)
            sq = QRectF(x, r.center().y() - size / 2, size, size)
            path = QPainterPath()
            path.addRoundedRect(sq, size * 0.26, size * 0.26)
            glyph = QColor("white")
            if style == "default":
                g = QLinearGradient(sq.topLeft(), sq.bottomLeft())
                g.setColorAt(0, hue.lighter(125))
                g.setColorAt(1, hue)
                p.fillPath(path, g)
            elif style == "dark":
                p.fillPath(path, QColor(28, 28, 32))
                glyph = hue
            elif style == "clear":
                p.fillPath(path, QColor(255, 255, 255, 50))
            else:
                p.fillPath(path, QColor(ACCENT.red(), ACCENT.green(), ACCENT.blue(), 110))
                glyph = ACCENT.lighter(160)
            p.setPen(Qt.NoPen)
            p.setBrush(glyph)
            p.drawEllipse(sq.center(), size * 0.2, size * 0.2)
    return paint


_PICTURES = {}


def paint_picture(paths):
    """Wallpaper thumbnail(s); two paths are drawn split diagonally (light/dark, like macOS Auto)."""
    def load(path, size):
        key = (path, size.width(), size.height())
        if key not in _PICTURES:  # shared by every tile, so each picture is decoded once
            from PySide6.QtGui import QImageReader
            reader = QImageReader(path) if path else None
            if reader and reader.size().isValid():  # decode straight to preview size (fast even for 4K)
                full = reader.size()
                reader.setScaledSize(full.scaled(size, Qt.KeepAspectRatioByExpanding))
            img = reader.read() if reader else None
            _PICTURES[key] = QPixmap.fromImage(img) if img is not None and not img.isNull() else QPixmap()
        return _PICTURES[key]

    def paint(p, r):
        size = QSize(int(r.width()), int(r.height()))
        for i, path in enumerate(paths):
            pm = load(path, size)
            if i == 1:
                clip = QPainterPath(r.topRight())
                clip.lineTo(r.bottomRight())
                clip.lineTo(r.bottomLeft())
                clip.closeSubpath()
                p.setClipPath(clip, Qt.IntersectClip)
            if pm.isNull():
                p.fillRect(r, QColor("#1d3f8f") if i or "dark" in path else QColor("#8fb8f5"))
            else:
                p.drawPixmap(r.topLeft(), pm)
    return paint


def paint_mode(light, dark, mode):
    """Mini desktop for the Light / Dark / Auto tiles: wallpaper, menu bar, a window and the Dock."""
    pics = paint_picture([light] if mode == "light" else [dark] if mode == "dark" else [light, dark])

    def paint(p, r):
        pics(p, r)
        p.setClipping(False)
        win = QRectF(r.left() + r.width() * 0.16, r.top() + r.height() * 0.24, r.width() * 0.5, r.height() * 0.44)
        path = QPainterPath()
        path.addRoundedRect(win, 5, 5)
        p.fillPath(path, QColor(245, 245, 247, 235) if mode != "dark" else QColor(40, 40, 44, 235))
        dock = QRectF(r.center().x() - r.width() * 0.25, r.bottom() - 11, r.width() * 0.5, 7)
        path = QPainterPath()
        path.addRoundedRect(dock, 3.5, 3.5)
        p.fillPath(path, QColor(255, 255, 255, 110))
    return paint


class LightsPreview(QWidget):
    """Two glowing rings, like the Ally's sticks, in the colour the lights will show."""

    def __init__(self, settings):
        super().__init__()
        self.settings = settings
        self.setFixedHeight(150)

    def colour(self, key):
        import colorsys
        raw = self.settings.lights.get(key, "0a84ff")
        c = QColor("#" + raw) if len(raw) == 6 else QColor("#0a84ff")
        h, sat, v = colorsys.rgb_to_hsv(c.redF(), c.greenF(), c.blueF())
        sat *= int(self.settings.lights.get("lights_vividness", "100") or 0) / 100
        v *= int(self.settings.lights.get("lights_brightness", "70") or 0) / 100
        r, g, b = colorsys.hsv_to_rgb(h, sat, v)
        return QColor.fromRgbF(r, g, b)

    def paintEvent(self, _):
        from PySide6.QtGui import QPen, QRadialGradient
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        lights = self.settings.lights
        off = lights.get("lights_mode") == "off"
        pairs = [("Desktop", "lights_color")]
        if lights.get("lights_mode") == "gaming":
            pairs.append(("Gaming", "lights_game_color"))
        w = self.width() / len(pairs)
        for i, (label, key) in enumerate(pairs):
            col = QColor(40, 40, 44) if off else self.colour(key)
            for j in (0, 1):
                cx, cy = w * i + w / 2 + (j - 0.5) * 84, 62
                glow = QRadialGradient(cx, cy, 52)
                glow.setColorAt(0.55, QColor(col.red(), col.green(), col.blue(), 0 if off else 150))
                glow.setColorAt(1, QColor(col.red(), col.green(), col.blue(), 0))
                p.setPen(Qt.NoPen)
                p.setBrush(glow)
                p.drawEllipse(QRectF(cx - 52, cy - 52, 104, 104))
                p.setBrush(QColor(22, 22, 24))
                p.setPen(QPen(col, 6))
                p.drawEllipse(QRectF(cx - 30, cy - 30, 60, 60))
            p.setPen(QColor("#b8b8c0"))
            p.drawText(QRectF(w * i, 124, w, 20), Qt.AlignHCenter, label)


class Row(QWidget):
    """A settings row: title, optional subtitle, control on the right."""

    def __init__(self, title, subtitle="", control=None):
        super().__init__()
        self.title_text = title
        lay = QHBoxLayout(self)
        lay.setContentsMargins(16, 11, 16, 11)
        self.subtitle = None
        if not title and control is not None:  # a full-width row (a row of pictures or swatches)
            lay.addWidget(control, 1)
            return
        text = QVBoxLayout()
        text.setSpacing(2)
        t = QLabel(title)
        t.setObjectName("rowTitle")
        text.addWidget(t)
        self.subtitle = None
        if subtitle:
            self.subtitle = QLabel(subtitle)
            self.subtitle.setObjectName("rowSubtitle")
            self.subtitle.setWordWrap(True)
            text.addWidget(self.subtitle)
        lay.addLayout(text, 1)
        if control is not None:
            lay.addWidget(control, 0, Qt.AlignVCenter)


class Card(QFrame):
    """Rounded group of rows, like an iOS settings section."""

    def __init__(self, rows):
        super().__init__()
        self.setObjectName("card")
        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 4, 0, 4)
        lay.setSpacing(0)
        for i, row in enumerate(rows):
            if i:
                line = QFrame()
                line.setObjectName("divider")
                line.setFixedHeight(1)
                lay.addWidget(line)
            lay.addWidget(row)


class Page(QScrollArea):
    def __init__(self, title):
        super().__init__()
        self.title = title
        self.keywords = [title.lower()]
        self.setWidgetResizable(True)
        self.setFrameShape(QFrame.NoFrame)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        # flick to scroll with a finger, with momentum and a soft bounce at the ends (like iOS)
        from PySide6.QtWidgets import QScroller
        QScroller.grabGesture(self.viewport(), QScroller.TouchGesture)
        body = QWidget()
        body.setObjectName("page")
        self.lay = QVBoxLayout(body)
        self.lay.setContentsMargins(32, 26, 32, 26)
        self.lay.setSpacing(10)
        h = QLabel(title)
        h.setObjectName("pageTitle")
        self.lay.addWidget(h)
        self.setWidget(body)

    def section(self, label, rows, note=""):
        """Add a titled card of rows; returns its container (hide it to hide the whole section)."""
        box = QWidget()
        bl = QVBoxLayout(box)
        bl.setContentsMargins(0, 0, 0, 0)
        bl.setSpacing(10)
        if label:
            lab = QLabel(label.upper())
            lab.setObjectName("sectionLabel")
            bl.addSpacing(10)
            bl.addWidget(lab)
            self.keywords.append(label.lower())
        for r in rows:
            self.keywords.append(r.title_text.lower())
            if r.subtitle is not None:
                self.keywords.append(r.subtitle.text().lower())
        bl.addWidget(Card(rows))
        if note:
            n = QLabel(note)
            n.setObjectName("note")
            n.setWordWrap(True)
            bl.addWidget(n)
        self.lay.addWidget(box)
        return box

    def button(self, text, primary=False):
        b = QPushButton(text)
        b.setCursor(Qt.PointingHandCursor)
        if primary:
            b.setObjectName("primary")
        self.lay.addWidget(b, 0, Qt.AlignLeft)
        self.keywords.append(text.lower())
        return b

    def finish(self):
        self.lay.addStretch(1)


