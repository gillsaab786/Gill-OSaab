        p.section("Wallpaper", [Row("", "", self.wall_picker), Row("Your own picture", "", own)],
                  "Tide follows Light and Dark, cross-fading at sunset when Appearance is Auto.")

        widgets = ap.get("widgets", {}) if isinstance(ap.get("widgets"), dict) else {}
        rows = []
        self.widget_switches = {}
        for key, title, default in WIDGETS:
            sw = Switch()
            sw.set_quiet(bool(widgets.get(key, default)))
            sw.toggled.connect(lambda on, k=key: (haptic("toggle"), self.set_widget(k, on)))
            self.widget_switches[key] = sw
            rows.append(Row(title, "", sw))
        self.city = QLineEdit(ap.get("city", ""))
        self.city.setPlaceholderText("e.g. Melbourne")
        self.city.setObjectName("field")
        self.city.setFixedWidth(200)
        self.city.editingFinished.connect(lambda: self.backend.set_appearance("city", self.city.text().strip()))
        rows.append(Row("Weather city", "Weather comes from Open-Meteo (no account).", self.city))
        p.section("Desktop widgets", rows, "Widgets sit on the desktop under your windows. Android home-screen "
                  "widgets and Windows 11 Widgets can't run outside their own systems; their apps still open in "
                  "windows here.")

        self.clip_switch = Switch()
        self.clip_switch.set_quiet(ap.get("clipboardHistory", True) is not False)
        self.clip_switch.toggled.connect(lambda on: (haptic("toggle"), self.backend.set_appearance("clipboardHistory", on)))
        p.section("Spotlight", [Row("Clipboard history", "The last 25 things you copied, in Spotlight's Clipboard "
                                    "view. Kept in memory only, cleared when you sign out. Passwords from password "
                                    "managers are never kept.", self.clip_switch)])

        self.night = Switch()
        self.night.set_quiet(self.backend.kde_night_light())
        self.night.toggled.connect(self.apply_night_light)
