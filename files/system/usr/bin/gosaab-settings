    def set_widget(self, key, on):
        widgets = self.backend.appearance().get("widgets", {})
        widgets = dict(widgets) if isinstance(widgets, dict) else {}
        widgets[key] = on
        self.backend.set_appearance("widgets", widgets)

    def choose_wallpaper(self):
        from PySide6.QtWidgets import QFileDialog
        path, _ = QFileDialog.getOpenFileName(self, "Choose a wallpaper", str(Path.home() / "Pictures"),
                                              "Pictures (*.png *.jpg *.jpeg *.webp)")
        if path:
            self.backend.set_appearance("wallpaper", path)
            for b in self.wall_picker.group.buttons():
                b.setChecked(False)

    # ---- ROG Ally stick lights
    def page_lights(self):
        p = Page("Controller Lights")
        f = self.backend.features()
        get = lambda k, d: f.get(k, d)  # noqa: E731
        self.lights = {"lights_mode": get("lights_mode", "gaming"), "lights_color": get("lights_color", "0a84ff"),
                       "lights_game_color": get("lights_game_color", "ff2d55"),
                       "lights_brightness": get("lights_brightness", "70"),
                       "lights_vividness": get("lights_vividness", "100"), "lights_effect": get("lights_effect", "solid")}
        self.lights_preview = LightsPreview(self)

        def save(key, value):
            if self.backend.set_value("features.conf", key, str(value)):
                self.lights[key] = str(value)
                self.lights_preview.update()
                self.game_color_box.setVisible(self.lights["lights_mode"] == "gaming")

        def colors(key):
            row = picker([(c, ColorDot("#" + c, n)) for c, n in LIGHT_COLORS], self.lights[key],
                         lambda c: save(key, c), 4)
            custom = QPushButton("Custom…")
            custom.setObjectName("pill")

            def choose():
                from PySide6.QtWidgets import QColorDialog
                col = QColorDialog.getColor(QColor("#" + self.lights[key]), self, "Stick light colour")
                if col.isValid():
                    save(key, col.name()[1:])
                    for b in row.group.buttons():
                        b.setChecked(False)
            custom.clicked.connect(choose)
            row.layout().insertWidget(row.layout().count() - 1, custom)
            return row

        def slider(key):
            sl = QSlider(Qt.Horizontal)
            sl.setRange(0, 100)
            sl.setValue(int(self.lights[key] or 0))
            sl.setFixedWidth(220)
            sl.valueChanged.connect(lambda v: (self.lights.__setitem__(key, str(v)), self.lights_preview.update()))
            sl.sliderReleased.connect(lambda: (haptic("tick"), save(key, sl.value())))
            return sl

        self.lights_mode = segmented([("always", "Always"), ("gaming", "Game && Desktop"), ("off", "Off")],
                                     self.lights["lights_mode"], lambda v: save("lights_mode", v))
        p.lay.addWidget(self.lights_preview)
        p.section("", [Row("Lights", "Game & desktop: one colour on the desktop, another while you play.",
                           self.lights_mode)])
        self.desktop_colors = colors("lights_color")
        self.game_colors = colors("lights_game_color")
        p.section("Colour", [Row("Desktop", "", self.desktop_colors)])
        self.game_color_box = p.section("While gaming", [Row("Game", "", self.game_colors)])
        self.game_color_box.setVisible(self.lights["lights_mode"] == "gaming")
        self.lights_effect = segmented([("solid", "Solid"), ("breathing", "Breathing"), ("rainbow", "Rainbow")],
                                       self.lights["lights_effect"], lambda v: save("lights_effect", v))
        self.brightness_slider = slider("lights_brightness")
        self.vivid_slider = slider("lights_vividness")
        st = self.backend.lights_status()
        how = {"led": "Driven by the kernel's Ally lights driver.", "hid": "Driven through the controller directly."}
        note = (st.get("note") or st.get("error") or how.get(st.get("backend"))
                or "The stick lights weren't found yet; settings are kept and used as soon as they are.")
        if st.get("hhd"):
            note += " Tip: set RGB to Disabled in Handheld Daemon's menu so it never flashes its own colour."
        p.section("Look", [
            Row("Brightness", "", self.brightness_slider),
            Row("Colour contrast", "Lower for softer, pastel colours; higher for deep, vivid colour.", self.vivid_slider),
            Row("Effect", "", self.lights_effect),
        ], note)
        p.finish()
        return p

    def page_folders(self):
        p = Page("App Folders")
        rows = []
        self.folder_labels = {}
        for app, label in self.backend.sandboxed_apps():
            current = self.backend.app_folders(app)
            text = QLabel("  ·  ".join(Path(f).name for f in current) or "Only its own files")
            self.folder_labels[app] = text
            box = QWidget()
            bl = QHBoxLayout(box)
            bl.setContentsMargins(0, 0, 0, 0)
            bl.addWidget(text)
            add = QPushButton("Choose…")
            add.setObjectName("pill")
            add.clicked.connect(lambda _=False, a=app: self.choose_folder(a))
            clear = QPushButton("Clear")
            clear.setObjectName("pill")
            clear.clicked.connect(lambda _=False, a=app: self.clear_folders(a))
            bl.addWidget(add)
            bl.addWidget(clear)
            rows.append(Row(label, "", box))
        p.section("Each app is sealed off", rows, "Apps see only their own files plus up to 2 folders you "
                  "choose here. Picking a third folder replaces the oldest. Changes apply next time the app "
                  "opens.")
        p.finish()
        return p

    def choose_folder(self, app):
        from PySide6.QtWidgets import QFileDialog
        folder = QFileDialog.getExistingDirectory(self, "Choose a folder this app may use", str(Path.home()))
        if folder:
            current = [f for f in self.backend.app_folders(app) if f != folder]
            self.set_folders(app, (current + [folder])[-2:])

    def clear_folders(self, app):
        self.set_folders(app, [])

    def set_folders(self, app, folders):
        self.backend.set_app_folders(app, folders)
        self.folder_labels[app].setText("  ·  ".join(Path(f).name for f in folders) or "Only its own files")

    def android_toggled(self, on):
        if on:
            self.backend.run(["gosaab-android-setup"], wait=False)
            return
        answer = QMessageBox.question(self, "Remove Android?", "Android, every Android app and their data "
                                      "will be removed. You can install it again later by turning this on.")
        if answer == QMessageBox.Yes:
            self.backend.run(["pkexec", "/usr/bin/gosaab-android-setup", "--remove"], wait=False)
        else:
            sw = self.switches[("features.conf", "android")][0]
            sw.set_quiet(True)
            self.backend.set_value("features.conf", "android", "on")

    def page_vpn_cloud(self):
        p = Page("VPN & Cloud")
        b = self.backend
        vpn_on = self.switch("features.conf", "vpn", default=False)
        p.section("VPN", [Row("VPN", "Off by default. Turn on to add and use VPN connections.", vpn_on)])
        rows = []
        for name, kind, active in b.vpn_connections():
            sw = Switch()
            sw.set_quiet(active)
            sw.toggled.connect(lambda on, n=name: b.vpn_set(n, on))
            rows.append(Row(name, "WireGuard" if kind == "wireguard" else "OpenVPN / other", sw))
        if not rows:
            rows.append(Row("No VPN yet", "Import a file from your VPN provider below.", QLabel("")))
        vpn_box = p.section("Connections", rows, "WireGuard is fastest; if it is blocked on a network, "
                            "import your provider's OpenVPN file and switch to that one.")
        imp = QPushButton("Import VPN file (WireGuard .conf or OpenVPN .ovpn)…")
        imp.clicked.connect(self.import_vpn)
        vpn_box.layout().addWidget(imp)
        vpn_box.setVisible(self.backend.features().get("vpn", "off") == "on")
        vpn_on.toggled.connect(vpn_box.setVisible)

        cloud_on = self.switch("features.conf", "cloud_drives", default=False)
        p.section("Cloud drives", [Row("Cloud drives", "Off by default. Nothing appears in Files until you "
                                       "turn this on and add an account.", cloud_on)])
        rows = []
        for remote in b.cloud_remotes():
            sw = Switch()
            sw.set_quiet(b.cloud_mounted(remote))
            sw.toggled.connect(lambda on, r=remote: b.cloud_mount(r, on))
            rows.append(Row(remote, f"Shows in Files as Cloud/{remote}", sw))
        if not rows:
            rows.append(Row("No accounts yet", "Add Google Drive, OneDrive, Dropbox... as many as you like.",
                            QLabel("")))
        cloud_box = p.section("Accounts", rows)
        add = QPushButton("Add an account…")
        add.clicked.connect(lambda: b.cloud_add())
        cloud_box.layout().addWidget(add)
        cloud_box.setVisible(self.backend.features().get("cloud_drives", "off") == "on")
        cloud_on.toggled.connect(cloud_box.setVisible)
        p.finish()
        return p

    def import_vpn(self):
        from PySide6.QtWidgets import QFileDialog
        path, _ = QFileDialog.getOpenFileName(self, "VPN file from your provider", str(Path.home()),
                                              "VPN files (*.conf *.ovpn)")
        if path:
            self.backend.vpn_import(path)

    GLASSES_MODES = [("2D", "2d"), ("3D (side by side)", "3d"), ("Glasses only", "only"), ("Extend", "extend")]
    EMULATOR_3D = {"org.citra_emu.citra": "3d", "citra-qt": "3d", "org.azahar_emu.azahar": "3d",
                   "org.DolphinEmu.dolphin-emu": "3d", "rpcs3": "3d", "net.rpcs3.RPCS3": "3d"}

    def page_glasses(self):
        p = Page("Glasses")
        b = self.backend
        self.glasses_label = QLabel(b.glasses_status())
        modes = QWidget()
        ml = QHBoxLayout(modes)
        ml.setContentsMargins(0, 0, 0, 0)
        for label, mode in self.GLASSES_MODES:
            btn = QPushButton(label)
            btn.setObjectName("pill")
            btn.clicked.connect(lambda _=False, m=mode: (b.run(["gosaab-glasses", m]),
                                                        self.glasses_label.setText(b.glasses_status())))
            ml.addWidget(btn)
        p.section("XREAL and other glasses", [Row("Status", "", self.glasses_label), Row("Mode", "", modes)],
                  "Plug the glasses into USB-C. 3D shows games side by side (3840x1080); Glasses only turns "
                  "the built-in screen off to save battery.")
        depth = QSlider(Qt.Horizontal)
        depth.setRange(0, 100)
        depth.setValue(b.depth_3d())
        depth.setMinimumWidth(220)
        depth.valueChanged.connect(lambda v: b.set_depth_3d(v))
        p.section("3D depth", [Row("Depth", "How deep 3DS games look in 3D (applies to Azahar/Citra/Lime3DS "
                                   "next time a game starts).", depth)])
        rows = []
        self.glasses_combo = {}
        profiles = {**b.glasses_profiles()}
        for app in sorted(set(profiles) | set(self.EMULATOR_3D)):
            combo = QComboBox()
            combo.addItems(["Off", "2d", "3d", "only", "extend"])
            combo.setCurrentText(profiles.get(app, "Off"))
            combo.currentTextChanged.connect(self.save_glasses_profiles)
            self.glasses_combo[app] = combo
            rows.append(Row(app, "", combo))
        p.section("Per-app modes", rows, "When one of these apps is in front, the glasses switch to its mode. "
                  "Set 3D for 3DS, Wii/GameCube and PS3 emulators to have 3D come on by itself.")
        p.finish()
        return p

    def save_glasses_profiles(self, *_):
        self.backend.set_glasses_profiles({a: c.currentText() for a, c in self.glasses_combo.items()
                                           if c.currentText() != "Off"})

    def smart_power_section(self, p):
        st = self.backend.power_status()
        watts = st.get("watts_all", {})
        now = QLabel(f"●  {st.get('label', 'Everyday')}" + (f" · {st.get('watts')} W" if st.get("watts") else ""))
        now.setObjectName("ok")
        how = {"firmware-attributes": "the device's own power limit", "asus-wmi": "the ASUS power limit",
               "ryzenadj": "the AMD power limit (ryzenadj)", "intel-rapl": "the Intel power limit (RAPL)"}
        via = how.get(st.get("backend"), "power profiles (this PC has no adjustable power limit)")
        rows = [Row("Smart TDP", "Gives the processor only the power the task needs: low for idle and video, "
                    f"full for games. Uses {via}.", self.switch("features.conf", "smart_tdp", default=True)),
                Row("Right now", "Changes by itself when you start a game, play a video or step away.", now)]
        if st.get("device") != "desktop" and watts:
            for mode, label in (("idle", "Idle"), ("video", "Video"), ("desktop", "Everyday"), ("game", "Gaming")):
                box = QSpinBox()
                box.setRange(3, 120)
                box.setSuffix(" W")
                box.setValue(int(watts.get(mode, 10)))
                box.valueChanged.connect(lambda v, m=mode: self.backend.set_value("features.conf", f"tdp_{m}", str(v)))
                rows.append(Row(f"{label} power", "", box))
        p.section("Smart TDP", rows, "In Game Mode the Quick Access TDP slider still works; Smart TDP takes "
                                     "over again when the game ends.")
        g = self.backend.gpu_status()
        if not g.get("hybrid"):
            return
        ig, dg = g.get("integrated") or {}, g.get("dedicated") or {}
        self.gpu_pick = self.choice("features.conf", "gpu_mode", g.get("mode", "auto"), [
            ("auto", "Automatic (recommended)"), ("integrated", "Integrated only – longest battery"),
            ("dedicated", "Dedicated for everything – most power")])
        self.gpu_pick.currentIndexChanged.connect(lambda _i: self.backend.run(["gosaab-gpu", "apply"], wait=False))
        msg = st.get("gpu_message") or ""
        p.section("Graphics", [
            Row("Graphics chips", f"Integrated: {ig.get('name', '?')}\nDedicated: {dg.get('name', '?')}",
                QLabel("●  Dedicated in use" if st.get("dgpu_active") else
                       ("●  Dedicated off" if st.get("dgpu_off") else "●  Dedicated asleep"))),
            Row("Which to use", "Automatic: the desktop, videos and browsing use the integrated chip and the "
                "dedicated one sleeps; games and game stores start on the dedicated one. A small pop-up shows "
                "when it switches. No restart needed. " + msg, self.gpu_pick)],
            "Apps keep the chip they started on: restart a running game to move it.")

    def fps_section(self, p):
        st = self.backend.fps_status()
        g = st.get("main") or {}
        rec = st.get("recommendation", {})
        names = {"dlss": "DLSS 4", "fsr4": "FSR 4", "fsr4-rdna3": "FSR 4 (RX 7000)", "xess": "XeSS",
                 "fsr3": "FSR 3"}
        up = names.get(rec.get("upgrade"), "FSR")
        rows = [Row("Graphics", f"{g.get('name') or 'Unknown'} · " + "  ".join(rec.get("notes", [])[:1]),
                    QLabel(f"●  {g.get('vendor', '?').upper()}"))]

        def apply_after(key):
            sw = self.switch("features.conf", key, default=key == "fps_upgrade")
            sw.toggled.connect(lambda _on: self.backend.run(["gosaab-fps", "apply"], wait=False))
            return sw
        rows.append(Row(f"Use the newest {up} in games", "Upgrades the upscaler and frame generation built into "
                        "games to the latest version (needs GE-Proton, set up for you).", apply_after("fps_upgrade")))
        if rec.get("smooth_motion"):
            rows.append(Row("Nvidia Smooth Motion", "Driver frame generation for games without DLSS frame "
                            "generation. Turn off in games that have it.", apply_after("fps_smooth_motion")))
        ge = st.get("ge_proton", [])
        get = UpdateButton(self, "ge-proton", "Update" if ge else "Install",
                           command=lambda: ["gosaab-fps", "install-proton"])
        get.setObjectName("pill")
        rows.append(Row("GE-Proton", (ge[0] if ge else "Not installed") + " · runs Windows games with the "
                        "upscaler upgrades.", get))
        if st.get("needs_nvidia_edition"):
            rows.append(Row("Nvidia driver", "Your RTX/GTX 16 card needs Nvidia's driver for DLSS and full speed.",
                            self.update_button("nvidia", "Install")))
        p.section("Best FPS for your graphics", rows, "  ".join(rec.get("notes", [])[1:]))

    def page_gamemode(self):
        p = Page("Game Mode")
        b = self.backend
        start = QWidget()
        sl = QHBoxLayout(start)
        sl.setContentsMargins(0, 0, 0, 0)
        sl.setSpacing(0)
        self.boot_group = QButtonGroup(self)
        current = b.boot_mode()
        choices = [("Game Mode", "game"), ("Desktop", "desktop"), ("Ask", "ask")]
        for i, (label, mode) in enumerate(choices):
            btn = QPushButton(label)
            btn.setCheckable(True)
            btn.setObjectName("segLeft" if i == 0 else "segRight" if i == len(choices) - 1 else "segMid")
            btn.setChecked(current == mode)
            btn.clicked.connect(lambda _=False, m=mode: b.set_boot_mode(m))
            self.boot_group.addButton(btn)
            sl.addWidget(btn)
        p.section("Start up", [
            Row("Start up in", "What opens when you turn it on. Handhelds start in Game Mode, PCs on the "
                "desktop, until you choose.", start),
        ])
        self.fg = Switch()
        self.fg.set_quiet(b.frame_gen_enabled())
        self.fg.toggled.connect(lambda on: b.set_frame_gen(on))
        fg_ready = Path("/usr/share/vulkan/implicit_layer.d").exists() and any(
            "lsfg" in f.name.lower() for f in Path("/usr/share/vulkan/implicit_layer.d").glob("*.json"))
        p.section("Performance", [
            Row("TDP, fans and buttons", "In Game Mode press the ··· (Quick Access) button: Handheld Daemon "
                "sets TDP, fan curve and charge limit." if b.have("hhd") else "Handheld Daemon is not installed.",
                QLabel("●  Ready" if b.have("hhd") else "●  Not found")),
            Row("Frame generation", "Off by default. Doubles frames in games you choose: add the Steam launch "
                "option  LSFG_PROCESS=gosaab %command%. Needs Lossless Scaling from Steam."
                + ("" if fg_ready else "  (Not installed on this system.)"), self.fg),
        ])
        self.smart_power_section(p)
        self.profiles_section(p)
        self.fps_section(p)
        decky = p.button("Install Decky Loader (Game Mode plugins, notifications)")
        decky.clicked.connect(lambda: b.run(["foot", "-e", "sh", "-c",
            "curl -L https://github.com/SteamDeckHomebrew/decky-installer/releases/latest/download/"
            "install_release.sh | sh; echo; read -p 'Done. Press Enter to close.' x"], wait=False))
        switch = p.button("Switch to Game Mode now", primary=True)
        switch.clicked.connect(lambda: b.run(["gosaab-game-mode"], wait=False))
        p.finish()
        return p

    FPS_CHOICES = [(0, "No cap"), (30, "30 FPS"), (40, "40 FPS"), (45, "45 FPS"), (60, "60 FPS"), (90, "90 FPS"),
                   (120, "120 FPS")]
    GPU_CHOICES = [("auto", "Automatic"), ("dedicated", "Dedicated graphics"), ("integrated", "Integrated (saves battery)")]

    def profiles_section(self, p):
        """Per-game profiles: TDP, graphics chip, FPS cap and stick-light colour for each game."""
        p.keywords += ["per-game", "game profile", "profiles", "fps cap", "frame limit", "per game tdp"]
        self.profiles_holder = QWidget()
        self.profiles_lay = QVBoxLayout(self.profiles_holder)
        self.profiles_lay.setContentsMargins(0, 0, 0, 0)
        p.lay.addWidget(self.profiles_holder)
        self.fill_profiles()

    def fill_profiles(self):
        while self.profiles_lay.count():
            w = self.profiles_lay.takeAt(0).widget()
            if w:
                w.deleteLater()
        profiles = self.backend.game_profiles()
        fps_name = dict(self.FPS_CHOICES)
        gpu_name = dict(self.GPU_CHOICES)
        rows = []
        for key, prof in sorted(profiles.items(), key=lambda kv: kv[1].get("name", kv[0]).lower()):
            parts = [f"{prof['tdp']} W" if prof.get("tdp") else "Smart TDP", fps_name.get(prof.get("fps", 0), ""),
                     gpu_name.get(prof.get("gpu", "auto"), "")]
            if prof.get("lights"):
                parts.append("lights #" + prof["lights"])
            btns = QWidget()
            bl = QHBoxLayout(btns)
            bl.setContentsMargins(0, 0, 0, 0)
            edit = QPushButton("Edit")
            edit.setObjectName("pill")
            edit.clicked.connect(lambda _=False, k=key: self.edit_profile(k))
            rm = QPushButton("Remove")
            rm.setObjectName("pill")
            rm.clicked.connect(lambda _=False, k=key: (self.backend.remove_profile(k), self.fill_profiles()))
            bl.addWidget(edit)
            bl.addWidget(rm)
            rows.append(Row(prof.get("name", key), " · ".join(x for x in parts if x), btns))
        if not rows:
            rows = [Row("No game profiles yet", "Add one below: it applies by itself whenever that game runs.")]
        # editor
        self.profile_game = QComboBox()
        for key, name in self.backend.known_games():
            self.profile_game.addItem(name, key)
        if self.profile_game.count() == 0:
            self.profile_game.addItem("Start a game, then come back here", "")
        self.profile_tdp = QSpinBox()
        self.profile_tdp.setRange(0, 120)
        self.profile_tdp.setSuffix(" W")
        self.profile_tdp.setSpecialValueText("Smart TDP")
        self.profile_gpu = QComboBox()
        for v, label in self.GPU_CHOICES:
            self.profile_gpu.addItem(label, v)
        self.profile_fps = QComboBox()
        for v, label in self.FPS_CHOICES:
            self.profile_fps.addItem(label, v)
        self.profile_lights = QComboBox()
        self.profile_lights.addItem("Same as Controller Lights", "")
        for c, n in LIGHT_COLORS:
            self.profile_lights.addItem(n, c)
        save = QPushButton("Save profile")
        save.setObjectName("primary")
        save.clicked.connect(self.save_profile)
        editor = [Row("Game", "Installed Steam games and the game running now.", self.profile_game),
                  Row("Power (TDP)", "Smart TDP picks by itself; or set the watts for this game.", self.profile_tdp),
                  Row("Graphics", "Which graphics chip this game uses (PCs with two).", self.profile_gpu),
                  Row("FPS cap", "Steadier frames and longer battery (Game Mode).", self.profile_fps)]
        if self.backend.lights_status().get("ally"):
            editor.append(Row("Stick lights", "This game's colour (ROG Ally).", self.profile_lights))
        editor.append(Row("", "", save))
        box = QWidget()
        bl = QVBoxLayout(box)
        bl.setContentsMargins(0, 0, 0, 0)
        for title, rws in (("PER-GAME PROFILES", rows), ("ADD OR CHANGE A PROFILE", editor)):
            lab = QLabel(title)
            lab.setObjectName("sectionLabel")
            bl.addWidget(lab)
            bl.addWidget(Card(rws))
        self.profiles_lay.addWidget(box)

    def edit_profile(self, key):
        prof = self.backend.game_profiles().get(key, {})
        i = self.profile_game.findData(key)
        if i < 0:
            self.profile_game.insertItem(0, prof.get("name", key), key)
            i = 0
        self.profile_game.setCurrentIndex(i)
        self.profile_tdp.setValue(prof.get("tdp", 0))
        self.profile_gpu.setCurrentIndex(max(0, self.profile_gpu.findData(prof.get("gpu", "auto"))))
        self.profile_fps.setCurrentIndex(max(0, self.profile_fps.findData(prof.get("fps", 0))))
        self.profile_lights.setCurrentIndex(max(0, self.profile_lights.findData(prof.get("lights", ""))))

    def save_profile(self):
        key = self.profile_game.currentData()
        if not key:
            return
        prof = {"name": self.profile_game.currentText()[:80], "tdp": self.profile_tdp.value(),
                "gpu": self.profile_gpu.currentData(), "fps": self.profile_fps.currentData(),
                "lights": self.profile_lights.currentData() or ""}
        if self.backend.set_profile(key, prof):
            haptic("success")
            self.fill_profiles()
        else:
            QMessageBox.warning(self, "Game profile", "Couldn't save the profile.")

    def page_optional(self):
        p = Page("Optional Features")
        rows = []
        for key, title in [("phone_link", "Phone link"), ("shared_game_library", "Shared game library"),
                           ("vrr", "VRR (FreeSync)"),
                           ("suspend_then_hibernate", "Suspend, then hibernate"), ("undervolt", "Undervolting"),
                           ("smart_updates", "Smart updates"),
                           ("pause_downloads_while_gaming", "Pause downloads while gaming")]:
            rows.append(Row(title, "Coming in a later update. Off by default.",
                            self.switch("features.conf", key, default=False, enabled=False)))
        p.section("Off by default", rows)
        p.finish()
        return p

    def page_about(self):
        p = Page("About")
        version = VERSION_FILE.read_text().strip() if VERSION_FILE.exists() else "dev"
        p.section("", [Row("Gill(OS)", f"Version {version}  ·  Developer: GILL-Saab")])
        b = self.backend
        checks = [
            ("Windows apps (Wine)", b.have("wine")), ("App sandbox (bubblewrap)", b.have("bwrap")),
            ("Android apps (Waydroid)", b.have("waydroid")), ("Linux packages (distrobox)", b.have("distrobox")),
            ("Firmware updates (fwupd)", b.have("fwupdmgr")),
            ("Gaming CPU scheduler", b.service_active("scx_loader.service")),
            ("NTSYNC", b.module_loaded("ntsync")),
            ("Gill(OS) updater", b.service_active("gosaab-update.timer")),
            ("Game Mode notifications (Decky)", b.decky_plugin_installed()),
        ]
        rows = []
        for name, ok in checks:
            dot = QLabel("●  Ready" if ok else "●  Not found")
            dot.setObjectName("ok" if ok else "bad")
            rows.append(Row(name, "", dot))
        p.section("Status", rows)
        p.finish()
        return p

    # -------------------------------------------------------- actions
    def bios_not_available(self):
        url = self.hw.get("support_page", "")
        name = self.hw.get("model", {}).get("name", "this device")
        box = QMessageBox(self)
        box.setWindowTitle("BIOS")
        box.setText(f"{name} doesn't publish BIOS updates to the Linux firmware service.")
        if url:
            box.setInformativeText("Open the maker's support page to download the BIOS for your exact model?")
            open_btn = box.addButton("Open support page", QMessageBox.AcceptRole)
            box.addButton(QMessageBox.Close)
            box.exec()
            if box.clickedButton() is open_btn:
                self.backend.run(["xdg-open", url], wait=False)
        else:
            box.exec()

    def apply_scheme(self, scheme):
        icons = "Papirus-Dark" if scheme.endswith("Dark") else "Papirus-Light"
        self.backend.run(["plasma-apply-colorscheme", scheme])
        self.backend.run(["/usr/libexec/plasma-changeicons", icons])

    def apply_night_light(self, on):
        self.backend.run(["kwriteconfig6", "--file", "kwinrc", "--group", "NightColor", "--key", "Active",
                          "true" if on else "false"])
        self.backend.run(["dbus-send", "--session", "--dest=org.kde.KWin", "/KWin", "org.kde.KWin.reconfigure"])

    def apply_look(self):
        answer = QMessageBox.question(self, "Apply Gill(OS) look",
                                      "This resets your panels to the Gill(OS) top bar and dock. Continue?")
        if answer == QMessageBox.Yes:
            self.backend.run(["plasma-apply-lookandfeel", "--apply", "org.gillosaab.desktop", "--resetLayout"])


