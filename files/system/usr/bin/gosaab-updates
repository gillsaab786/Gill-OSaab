#!/usr/bin/env python3
"""Gill(OS) update switches.

  gosaab-updates                 show the switches
  gosaab-updates all off         turn every update off
  gosaab-updates os on|off       OS updates
  gosaab-updates apps on|off     Flatpak apps and emulators
  gosaab-updates containers on|off   Linux (distrobox) containers
  gosaab-updates now             run the switched-on updates right away

Steam updates itself and is not controlled here.
"""
import os
import shutil
import subprocess
import sys

sys.path.insert(0, "/usr/libexec/gill-osaab")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "../libexec/gill-osaab"))
from gosaab_common import ETC, is_on, read_conf, write_conf_value  # noqa: E402

TARGETS = ("all", "os", "apps", "containers")
LABELS = {"all": "All updates", "os": "OS", "apps": "Apps and emulators", "containers": "Linux containers"}


def status_lines(conf):
    master = is_on(conf, "all", default=True)
    lines = []
    for key in TARGETS:
        state = "on" if is_on(conf, key, default=True) else "off"
        note = " (blocked: All updates is off)" if key != "all" and not master and state == "on" else ""
        lines.append(f"{LABELS[key]:<20} {state}{note}")
    return lines


def elevate(argv):
    if os.geteuid() == 0:
        return
    script = os.path.realpath(__file__)
    if shutil.which("pkexec"):
        os.execvp("pkexec", ["pkexec", script, *argv])
    if shutil.which("sudo"):
        os.execvp("sudo", ["sudo", sys.executable, script, *argv])
    sys.exit("Needs admin rights: run with sudo.")


def main(argv):
    conf_path = ETC / "updates.conf"
    if not argv or argv[0] in ("status", "-s"):
        print("\n".join(status_lines(read_conf(conf_path))))
        return 0
    if argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "now":
        elevate(argv)
        return subprocess.run(["/usr/libexec/gill-osaab/gosaab-update-run", "--force"], check=False).returncode
    if len(argv) != 2 or argv[0] not in TARGETS or argv[1] not in ("on", "off"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    elevate(argv)
    write_conf_value(conf_path, argv[0], argv[1])
    print("\n".join(status_lines(read_conf(conf_path))))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
