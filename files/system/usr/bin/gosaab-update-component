#!/usr/bin/env python3
"""Update one part of Gill(OS), or everything.

  gosaab-update-component <name>      update it now (shows progress in notifications)
  gosaab-update-component --versions  print installed versions as JSON
  gosaab-update-component --list      list the parts

Parts: all, os, drivers, translation, rollback, firmware, bios, android, proton, wine, apps, containers, decky,
nvidia
"""
import hashlib
import json
import os
import platform
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request
from pathlib import Path

sys.path.insert(0, "/usr/libexec/gill-osaab")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "../libexec/gill-osaab"))
from gosaab_common import Progress, log  # noqa: E402

ROOT_HELPER = "/usr/libexec/gill-osaab/gosaab-update-root"
PROTON_API = "https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest"
WINE_PREFIXES = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "gill-osaab" / "wine"
NOT_AVAILABLE, UP_TO_DATE, FAILED = 3, 4, 1

PARTS = {
    "os": ("Gill(OS) system", "Kernel, graphics and Wi-Fi drivers, Wine, Android support", "root"),
    "firmware": ("Device firmware", "Controllers, SSDs, docks and other parts (LVFS)", "root"),
    "bios": ("BIOS", "Only when your maker publishes it to LVFS; never automatic", "root"),
    "android": ("Android system", "The Android image used for .apk apps (Waydroid)", "root"),
    "proton": ("Proton-GE", "Latest Proton-GE for Steam games", "user"),
    "wine": ("Windows app setups", "Refreshes each Windows app's private setup", "user"),
    "apps": ("Apps and emulators", "Flatpak apps", "user"),
    "containers": ("Linux containers", "Apps installed from .deb and .rpm", "user"),
    "decky": ("Game Mode plugins", "Gill(OS) Notifications for Decky", "root"),
    "nvidia": ("Nvidia edition", "Switches to the Gill(OS) build with Nvidia drivers", "root"),
    "rollback": ("Previous version", "Goes back to the system version before the last update", "root"),
}
GROUPS = {
    "drivers": ["os", "firmware"],
    # the layers that run other systems' apps: Android (Waydroid), Windows (Proton-GE, Wine setups),
    # other Linux distros (containers)
    "translation": ["android", "proton", "wine", "containers"],
    "all": ["os", "firmware", "android", "proton", "wine", "apps", "containers", "decky"],
}


# ------------------------------------------------------------ helpers
def sh(cmd, **kw):
    log("update", "run: " + " ".join(cmd))
    return subprocess.run(cmd, check=False, **kw).returncode


def capture(cmd):
    if not shutil.which(cmd[0]):
        return ""
    return subprocess.run(cmd, capture_output=True, text=True, check=False).stdout.strip()


def as_root(action):
    if os.geteuid() == 0:
        return subprocess.run([ROOT_HELPER, action], check=False).returncode
    if not shutil.which("pkexec"):
        return FAILED
    return subprocess.run(["pkexec", ROOT_HELPER, action], check=False).returncode


def steam_root(home=None):
    home = Path(home or Path.home())
    for cand in (home / ".steam/root", home / ".local/share/Steam", home / ".var/app/com.valve.Steam/data/Steam"):
        if cand.is_dir():
            return cand.resolve()
    return home / ".local/share/Steam"


def proton_versions(home=None):
    d = steam_root(home) / "compatibilitytools.d"
    if not d.is_dir():
        return []
    return sorted((p.name for p in d.iterdir() if p.is_dir() and p.name.startswith("GE-Proton")), key=version_key)


def version_key(name):
    parts = []
    for chunk in name.replace("GE-Proton", "").replace("-", ".").split("."):
        parts.append(int(chunk) if chunk.isdigit() else 0)
    return parts


# ------------------------------------------------------------ user parts
def update_proton(progress):
    req = urllib.request.Request(PROTON_API, headers={"Accept": "application/vnd.github+json",
                                                      "User-Agent": "Gill(OS)"})
    with urllib.request.urlopen(req, timeout=30) as r:
        release = json.load(r)
    tag = release["tag_name"]
    if tag in proton_versions():
        return UP_TO_DATE
    assets = {a["name"]: a["browser_download_url"] for a in release.get("assets", [])}
    tar_name = next((n for n in assets if n.endswith(".tar.gz")), None)
    sum_name = next((n for n in assets if n.endswith(".sha512sum")), None)
    if not tar_name:
        return FAILED
    dest = steam_root() / "compatibilitytools.d"
    dest.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        tar_path = Path(tmp) / tar_name
        download(assets[tar_name], tar_path, progress, f"Downloading {tag}")
        if sum_name:
            with urllib.request.urlopen(assets[sum_name], timeout=30) as r:
                expected = r.read().decode().split()[0]
            if sha512(tar_path) != expected:
                raise RuntimeError("download checksum did not match")
        progress.update(message=f"Installing {tag}")
        with tarfile.open(tar_path) as tf:
            tf.extractall(dest, filter="data")
    for old in proton_versions()[:-2]:  # keep the newest two
        shutil.rmtree(dest / old, ignore_errors=True)
    return 0


def download(url, path, progress, message):
    req = urllib.request.Request(url, headers={"User-Agent": "Gill(OS)"})
    with urllib.request.urlopen(req, timeout=60) as r, open(path, "wb") as out:
        total = int(r.headers.get("Content-Length") or 0)
        done = 0
        while chunk := r.read(1 << 20):
            out.write(chunk)
            done += len(chunk)
            if total:
                progress.update(percent=done * 100 // total, message=message)


def sha512(path):
    h = hashlib.sha512()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def update_wine(progress):
    if not WINE_PREFIXES.is_dir():
        return NOT_AVAILABLE
    prefixes = [p for p in WINE_PREFIXES.iterdir() if (p / "system.reg").exists()]
    if not prefixes:
        return NOT_AVAILABLE
    for i, prefix in enumerate(prefixes):
        progress.update(percent=i * 100 // len(prefixes), message=prefix.name)
        sh(["wineboot", "-u"], env={**os.environ, "WINEPREFIX": str(prefix), "WINEDEBUG": "-all"})
    return 0


def update_apps(progress):
    if not shutil.which("flatpak"):
        return NOT_AVAILABLE
    return 0 if sh(["flatpak", "update", "-y", "--noninteractive"]) == 0 else FAILED


def update_containers(progress):
    if not shutil.which("distrobox"):
        return NOT_AVAILABLE
    return 0 if sh(["distrobox", "upgrade", "--all"]) == 0 else FAILED


USER_PARTS = {"proton": update_proton, "wine": update_wine, "apps": update_apps, "containers": update_containers}


# ------------------------------------------------------------ running
def expand(name):
    return GROUPS.get(name, [name])


def update(name):
    parts = expand(name)
    group_titles = {"all": "Updating everything", "drivers": "Updating drivers"}
    title = group_titles[name] if name in group_titles else f"Updating {PARTS[name][0]}"
    progress = Progress(title, app="gosaab-settings").start("Starting")
    results = {}
    for i, part in enumerate(parts):
        progress.update(percent=i * 100 // len(parts), message=PARTS[part][0])
        try:
            if PARTS[part][2] == "root":
                results[part] = as_root(part)
            else:
                results[part] = USER_PARTS[part](progress)
        except Exception as exc:  # network errors, bad archives
            log("update", f"{part} failed: {exc}")
            results[part] = FAILED
    failed = [PARTS[p][0] for p, rc in results.items() if rc not in (0, NOT_AVAILABLE, UP_TO_DATE)]
    progress.finish(not failed, message_for(results, failed))
    print(json.dumps(results))
    return exit_code(results, failed)


def exit_code(results, failed):
    codes = set(results.values())
    if failed:
        return FAILED
    if codes == {NOT_AVAILABLE}:
        return NOT_AVAILABLE
    if codes <= {UP_TO_DATE, NOT_AVAILABLE}:
        return UP_TO_DATE
    return 0


def message_for(results, failed):
    if failed:
        return "Couldn't update: " + ", ".join(failed)
    if all(rc == NOT_AVAILABLE for rc in results.values()):
        return "Not available on this device."
    if all(rc in (UP_TO_DATE, NOT_AVAILABLE) for rc in results.values()):
        return "Already up to date."
    if results.get("rollback") == 0:
        return "Restart to go back to the previous version."
    if "os" in results and results["os"] == 0:
        return "Updated. Restart to finish."
    return "Updated."


def versions():
    status = capture(["rpm-ostree", "status", "--json", "--booted"])
    os_version = image = ""
    try:
        dep = json.loads(status)["deployments"][0]
        os_version, image = dep.get("version", ""), dep.get("container-image-reference", "")
    except (ValueError, KeyError, IndexError):
        pass
    gosaab = Path("/usr/share/gill-osaab/version")
    protons = proton_versions()
    android = ""
    cfg = Path("/var/lib/waydroid/waydroid.cfg")
    if cfg.exists():
        for line in cfg.read_text(errors="replace").splitlines():
            if line.startswith("system_datetime"):
                android = line.split("=", 1)[1].strip()
    return {
        "gill_osaab": gosaab.read_text().strip() if gosaab.exists() else "dev",
        "os": os_version, "image": image, "kernel": platform.release(),
        "mesa": capture(["rpm", "-q", "--qf", "%{VERSION}", "mesa-dri-drivers"]),
        "wine": capture(["wine", "--version"]),
        "waydroid": capture(["rpm", "-q", "--qf", "%{VERSION}", "waydroid"]),
        "android_image": android,
        "proton": protons[-1] if protons else "",
    }


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    if argv[0] == "--versions":
        print(json.dumps(versions()))
        return 0
    if argv[0] == "--list":
        print(json.dumps({k: {"title": v[0], "detail": v[1]} for k, v in PARTS.items()}))
        return 0
    if argv[0] not in PARTS and argv[0] not in GROUPS:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return update(argv[0])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
