#!/usr/bin/env python3
"""Change a Gill(OS) system setting (used by Gill(OS) Settings).

  gosaab-config set <updates.conf|features.conf> <key> <value>

Only known keys and values are accepted.
"""
import os
import sys

sys.path.insert(0, "/usr/libexec/gill-osaab")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "../libexec/gill-osaab"))
from gosaab_common import ETC, write_conf_value  # noqa: E402

ONOFF = ("on", "off")
OPTIONAL = ("phone_link", "shared_game_library", "vpn", "cloud_drives", "night_light", "auto_dark_mode_sunset",
            "vrr", "suspend_then_hibernate", "undervolt", "smart_updates", "pause_downloads_while_gaming")
ALLOWED = {
    "updates.conf": {**{k: ONOFF for k in ("all", "os", "apps", "containers")},
                     "frequency": ("daily", "weekly", "2weeks", "monthly", "2months", "3months", "6months",
                                   "yearly", "never"),
                     "scope": ("everything", "drivers")},
    "features.conf": {
        "sandbox_windows_apps": ONOFF,
        "screen_off_overnight": ONOFF,
        "screen_off_idle_seconds": "int:5:600",
        "auto_drivers": ONOFF,
        "fps_upgrade": ONOFF,
        "fps_smooth_motion": ONOFF,
        "smart_tdp": ONOFF,
        "haptics": ONOFF,
        "tdp_idle": "int:0:120",
        "tdp_video": "int:0:120",
        "tdp_desktop": "int:0:120",
        "tdp_game": "int:0:120",
        "gpu_mode": ("auto", "integrated", "dedicated"),
        "charge_limit": "int:50:100",
        # ROG Ally stick lights
        "lights_mode": ("always", "gaming", "off"),
        "lights_color": "hex",
        "lights_game_color": "hex",
        "lights_brightness": "int:0:100",
        "lights_vividness": "int:0:100",
        "lights_effect": ("solid", "breathing", "rainbow"),
        **{k: ONOFF for k in OPTIONAL},
    },
}


def validate(filename, key, value):
    rules = ALLOWED.get(filename)
    if rules is None or key not in rules:
        return False
    rule = rules[key]
    if rule == "hex":  # a colour as six hex digits, no "#" (that starts a comment in .conf files)
        return len(value) == 6 and all(c in "0123456789abcdefABCDEF" for c in value)
    if isinstance(rule, str) and rule.startswith("int:"):
        _, lo, hi = rule.split(":")
        return value.isdigit() and int(lo) <= int(value) <= int(hi)
    return value in rule


def main(argv):
    if len(argv) != 4 or argv[0] != "set":
        print(__doc__.strip(), file=sys.stderr)
        return 2
    _, filename, key, value = argv
    if not validate(filename, key, value):
        print(f"Not allowed: {filename} {key}={value}", file=sys.stderr)
        return 2
    if os.geteuid() != 0 and not os.environ.get("GOSAAB_ETC"):
        print("Needs admin rights (run through pkexec).", file=sys.stderr)
        return 1
    write_conf_value(ETC / filename, key, value)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
