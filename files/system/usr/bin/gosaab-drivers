#!/usr/bin/env python3
"""Drivers on this device: list them, update only the ones you pick, install missing ones at boot.

  gosaab-drivers list [--check]                    parts, drivers, problems (JSON); --check looks for updates
  gosaab-drivers update CATEGORY[,CATEGORY] [--builtin]
                                                   e.g. "graphics" or "graphics,wi-fi"; --builtin also updates
                                                   the drivers built into the system (kernel, Mesa, firmware files)
  gosaab-drivers auto [--install]                  (admin) record every part and its driver; --install (on the
                                                   update schedule, and at the very first start) installs
                                                   firmware/driver updates
  gosaab-drivers history                           driver changes that can be undone (JSON)
  gosaab-drivers rollback ID                       undo one (previous firmware / graphics drivers / system)
  gosaab-drivers search WORDS                      find any driver: on this device, built in, firmware files
  gosaab-drivers index FILE                        (image build) describe every built-in driver for search
"""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/libexec/gill-osaab")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "../libexec/gill-osaab"))
import gosaab_drivers as drv  # noqa: E402
from gosaab_common import ETC, Progress, is_on, log, read_conf  # noqa: E402

ROOT_HELPER = "/usr/libexec/gill-osaab/gosaab-update-root"
NOT_AVAILABLE, UP_TO_DATE, FAILED = 3, 4, 1


def fwupd_json():
    if not shutil.which("fwupdmgr"):
        return ""
    out = subprocess.run(["fwupdmgr", "get-updates", "--json"], capture_output=True, text=True, check=False,
                         timeout=120)
    return out.stdout


def as_root(*args):
    cmd = [ROOT_HELPER, *args]
    if os.geteuid() != 0:
        if not shutil.which("pkexec"):
            return FAILED
        cmd = ["pkexec", *cmd]
    return subprocess.run(cmd, check=False).returncode


def cmd_list(check):
    inv = drv.inventory()
    inv["updates"] = drv.fwupd_updates(fwupd_json()) if check else []
    inv["flatpak_gl"] = drv.flatpak_gl_refs()
    inv["keys"] = {c: drv.KEYS[c] for c in inv["categories"]}
    print(json.dumps(inv))
    return 0


def device_versions():
    if not shutil.which("fwupdmgr"):
        return {}
    out = subprocess.run(["fwupdmgr", "get-devices", "--json"], capture_output=True, text=True, check=False,
                         timeout=120)
    return drv.fwupd_device_versions(out.stdout)


def flatpak_commit(ref, installation):
    out = subprocess.run(["flatpak", "info", f"--{installation}", "--show-commit", ref], capture_output=True,
                         text=True, check=False)
    return out.stdout.strip()


def install_firmware(dev_id, name, installer):
    before = device_versions().get(dev_id, "")
    rc = installer()
    after = device_versions().get(dev_id, "")
    if rc == 0 and before and after and before != after:
        drv.add_history({"kind": "firmware", "name": f"{name} firmware", "target": dev_id, "from": before,
                         "to": after})
    return rc


def update_graphics_apps(gl, extra=()):
    before = {ref: flatpak_commit(ref, inst) for ref, inst in gl}
    rc = 0
    for inst in sorted({i for _, i in gl}):
        refs = [r for r, i in gl if i == inst]
        rc |= subprocess.run(["flatpak", "update", f"--{inst}", "-y", "--noninteractive", *extra, *refs],
                             check=False).returncode
    for ref, inst in gl:
        after = flatpak_commit(ref, inst)
        if before[ref] and after and before[ref] != after:
            drv.add_history({"kind": "graphics-apps", "name": "Graphics drivers for apps and games (Mesa/Vulkan)",
                             "target": ref, "installation": inst, "from": before[ref], "to": after})
    return 0 if rc == 0 else FAILED


def run_target(target, gl, names=None):
    if target == "gfx-apps":
        return update_graphics_apps(gl)
    if target.startswith("fw:"):
        dev = target[3:]
        return install_firmware(dev, (names or {}).get(target, "Device"), lambda: as_root("firmware-device", dev))
    if target == "builtin":
        v = drv.inventory().get("versions", {})
        rc = as_root("os")
        if rc == 0:
            drv.add_history({"kind": "system", "name": "Built-in drivers (kernel, Mesa, firmware files)",
                             "target": "system", "from": f"kernel {v.get('kernel')} · Mesa {v.get('mesa')}",
                             "to": "after restart"})
        return rc
    return NOT_AVAILABLE


def cmd_rollback(entry_id):
    entry = next((e for e in drv.load_history() if e.get("id") == entry_id), None)
    if not entry:
        print("no such change", file=sys.stderr)
        return 2
    progress = Progress(f"Undoing: {entry['name']}", app="gosaab-settings").start("Going back")
    if entry["kind"] == "firmware":
        rc = install_firmware(entry["target"], entry["name"].replace(" firmware", ""),
                              lambda: as_root("firmware-version", entry["target"], entry["from"]))
    elif entry["kind"] == "graphics-apps":
        inst = entry.get("installation", "system")
        rc = update_graphics_apps([(entry["target"], inst)], extra=[f"--commit={entry['from']}"])
    elif entry["kind"] == "system":
        rc = as_root("rollback")
    else:
        rc = NOT_AVAILABLE
    progress.update(percent=100)
    progress.finish(rc == 0, "Back to the previous version." + (" Restart to finish." if entry["kind"] == "system"
                                                                 else "") if rc == 0 else "Couldn't go back.")
    return 0 if rc == 0 else FAILED


def cmd_search(query):
    inv = drv.load_state() or drv.inventory()
    try:
        index = json.loads(drv.INDEX.read_text())
    except (OSError, ValueError):
        index = {}
    # the running kernel; else the newest one indexed (e.g. just after a kernel update, before a restart)
    modules = index.get(os.uname().release) or (index[sorted(index)[-1]] if index else {})
    if not modules:
        modules = drv.kernel_modules(f"/usr/lib/modules/{os.uname().release}")
    loaded = {ln.split()[0] for ln in drv.gosaab_hw.read("/proc/modules").splitlines() if ln}
    print(json.dumps(drv.search(query, inv, modules, loaded, updates=inv.get("updates", []))))
    return 0


def cmd_index(out):
    index = {}
    for kdir in sorted(Path("/usr/lib/modules").iterdir()):
        if (kdir / "kernel").is_dir():
            index[kdir.name] = drv.build_index(kdir / "kernel")
    Path(out).parent.mkdir(parents=True, exist_ok=True)
    Path(out).write_text(json.dumps(index))
    print(f"indexed {sum(len(v) for v in index.values())} drivers")
    return 0


def cmd_update(keys, builtin):
    cats = [drv.BY_KEY[k] for k in keys if k in drv.BY_KEY]
    if not cats and not builtin:
        print("unknown category; use: " + ", ".join(drv.KEYS.values()), file=sys.stderr)
        return 2
    title = "Updating " + (", ".join(cats) if cats else "built-in") + " drivers"
    progress = Progress(title, app="gosaab-settings").start("Checking for updates")
    gl = drv.flatpak_gl()
    ups = drv.fwupd_updates(fwupd_json())
    names = {u["id"]: u["name"] for u in ups}
    targets = drv.targets_for(cats, ups, builtin, bool(gl))
    if not targets:
        progress.finish(True, "Already up to date.")
        return UP_TO_DATE
    results = {}
    for i, t in enumerate(targets):
        progress.update(percent=i * 100 // len(targets), message=t)
        log("drivers", f"update {t}")
        results[t] = run_target(t, gl, names)
    failed = [t for t, rc in results.items() if rc not in (0, UP_TO_DATE, NOT_AVAILABLE)]
    progress.update(percent=100)
    restart = results.get("builtin") == 0
    progress.finish(not failed, "Couldn't update: " + ", ".join(failed) if failed else
                    ("Drivers updated. Restart to finish." if restart else "Drivers updated."))
    return FAILED if failed else 0


def on_ac_power(root=Path("/sys/class/power_supply")):
    supplies = list(root.glob("*"))
    if not any(drv.gosaab_hw.read(s / "type") == "Battery" for s in supplies):
        return True  # desktop PC
    return any(drv.gosaab_hw.read(s / "type") in ("Mains", "USB", "USB_C") and drv.gosaab_hw.read(s / "online") == "1"
               for s in supplies)


def cmd_auto(install):
    """(admin) Record the device; install firmware/driver updates when asked (the update schedule) or at
    the very first start, unless updates are set to Never."""
    first = not drv.STATE_FILE.exists()
    inv = drv.inventory()
    done, skipped = [], []
    updates_conf = read_conf(ETC / "updates.conf")
    allowed = is_on(read_conf(ETC / "features.conf"), "auto_drivers", default=True) and \
        is_on(updates_conf, "all", default=True) and updates_conf.get("frequency") != "never"
    if allowed and (install or first):
        if shutil.which("fwupdmgr"):
            subprocess.run(["fwupdmgr", "refresh", "--force"], capture_output=True, check=False, timeout=300)
            for u in drv.fwupd_updates(fwupd_json(), allow_sb_keys=drv.secure_boot_on()):
                if not on_ac_power():
                    skipped.append(f"{u['name']} firmware {u['to']} (waiting for the charger)")
                    continue
                dev = u["id"][3:]
                rc = install_firmware(dev, u["name"], lambda d=dev: subprocess.run(
                    ["fwupdmgr", "update", d, "--assume-yes", "--no-reboot-check"], capture_output=True,
                    check=False, timeout=1800).returncode)
                if rc == 0:
                    done.append(f"{u['name']} firmware {u['to']}")
                else:
                    inv["problems"].append({
                        "kind": "update-failed", "category": u["category"], "name": u["name"],
                        "detail": f"Firmware {u['to']} for {u['name']} failed to install.",
                        "hint": "Try again from Settings > Device & Drivers."})
        gl = [(r, i) for r, i in drv.flatpak_gl() if i == "system"]
        if gl:
            update_graphics_apps(gl)
    inv["updates"] = drv.fwupd_updates(fwupd_json()) if shutil.which("fwupdmgr") else []
    inv["installed"], inv["waiting"] = done, skipped
    drv.STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = drv.STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(inv, indent=1))
    os.chmod(tmp, 0o644)
    os.replace(tmp, drv.STATE_FILE)
    print(f"{len(inv['parts'])} parts, {len(inv['problems'])} problems, installed {len(done)}")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    if argv[0] == "list":
        return cmd_list("--check" in argv)
    if argv[0] == "update" and len(argv) >= 2:
        keys = [] if argv[1] == "--builtin" else argv[1].split(",")
        return cmd_update(keys, "--builtin" in argv)
    if argv[0] == "auto":
        if os.geteuid() != 0:
            print("auto runs as admin at boot (gosaab-drivers.service)", file=sys.stderr)
            return 2
        return cmd_auto("--install" in argv)
    if argv[0] == "history":
        print(json.dumps(drv.load_history()))
        return 0
    if argv[0] == "rollback" and len(argv) == 2:
        return cmd_rollback(argv[1])
    if argv[0] == "search" and len(argv) >= 2:
        return cmd_search(" ".join(argv[1:]))
    if argv[0] == "index" and len(argv) == 2:
        return cmd_index(argv[1])
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
