#!/usr/bin/env python3
"""Gill-OSaab screen-off mode.

Turns off only the display while downloads, file copies and installs keep
running. The device stays awake; when the work finishes the screen turns back
on with a "Done" notification. Run it again to turn the screen back on early.

  gosaab-screen-off              screen off until tasks finish
  gosaab-screen-off --overnight  show "Done" for 10 s, then suspend
  gosaab-screen-off --pid 1234   also wait for this process
  gosaab-screen-off --force      turn off even if no task is detected
"""
import argparse
import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, "/usr/libexec/gill-osaab")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "../libexec/gill-osaab"))
from gosaab_common import ETC, is_on, log, notify, read_conf  # noqa: E402

PARTIAL_SUFFIXES = (".part", ".crdownload", ".download", ".partial", ".opdownload", ".!qb", ".aria2")
BUSY_PROCESSES = {"cp", "mv", "rsync", "dd", "scp", "wget", "curl", "aria2c", "rclone",
                  "rpm-ostree", "flatpak", "bootc", "tar", "unzip", "7z", "7za"}
FRESH_SECONDS = 90  # a partial file counts as active if it changed this recently
WRITE_THRESHOLD = 2 * 1024 * 1024  # bytes written per check that count as "busy"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/gosaab-{os.getuid()}"))
PIDFILE = RUNTIME / "gosaab-screen-off.pid"


# ------------------------------------------------------------ task detection
def default_watch_dirs(home=None):
    home = Path(home or Path.home())
    return [home / "Downloads", home / ".local/share/Steam/steamapps/downloading"]


def partial_downloads(dirs, now=None):
    """Recently-changed partial download files in the watched folders."""
    now = now or time.time()
    found = []
    for d in dirs:
        d = Path(d)
        if not d.is_dir():
            continue
        steam = d.name == "downloading"
        for p in d.rglob("*") if steam else d.iterdir():
            try:
                if not p.is_file():
                    continue
                if (steam or p.name.lower().endswith(PARTIAL_SUFFIXES)) and now - p.stat().st_mtime < FRESH_SECONDS:
                    found.append(p)
            except OSError:
                continue
    return found


def busy_processes(proc=Path("/proc"), uid=None):
    """Names of the current user's copy/download/update processes."""
    uid = os.getuid() if uid is None else uid
    names = []
    for entry in proc.iterdir() if proc.is_dir() else []:
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid not in (uid, 0):
                continue
            comm = (entry / "comm").read_text().strip()
        except OSError:
            continue
        if comm in BUSY_PROCESSES:
            names.append(comm)
    return names


def pid_alive(pid):
    if pid is None:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


class IoMonitor:
    """Spots any of your processes writing lots of data (file managers, browsers,
    launchers), by comparing /proc/<pid>/io between checks."""

    def __init__(self, proc=Path("/proc"), threshold=WRITE_THRESHOLD):
        self.proc, self.threshold, self.last = Path(proc), threshold, {}

    def _read(self):
        totals = {}
        for entry in self.proc.iterdir() if self.proc.is_dir() else []:
            if not entry.name.isdigit() or int(entry.name) == os.getpid():
                continue
            try:
                for line in (entry / "io").read_text().splitlines():
                    if line.startswith("write_bytes:"):
                        totals[entry.name] = int(line.split()[1])
            except (OSError, ValueError, IndexError):
                continue
        return totals

    def busy(self):
        now = self._read()
        active = [pid for pid, total in now.items() if total - self.last.get(pid, total) >= self.threshold]
        self.last = now
        return active


def tasks_running(dirs, pid=None, proc=Path("/proc"), io=None):
    io_busy = io.busy() if io else []
    return bool(partial_downloads(dirs) or busy_processes(proc) or pid_alive(pid) or io_busy)


# ------------------------------------------------------------ display control
class Display:
    """KDE desktop: real panel power-off (DPMS). Game Mode/other: backlight to 0."""

    def __init__(self):
        self.mode = "dpms" if shutil.which("kscreen-doctor") and "KDE" in os.environ.get("XDG_CURRENT_DESKTOP", "") \
            else "backlight"
        self.saved = None

    def off(self):
        if self.mode == "dpms":
            subprocess.run(["kscreen-doctor", "--dpms", "off"], check=False)
        elif shutil.which("brightnessctl"):
            out = subprocess.run(["brightnessctl", "get"], capture_output=True, text=True, check=False)
            self.saved = out.stdout.strip() or None
            subprocess.run(["brightnessctl", "-q", "set", "0"], check=False)

    def on(self):
        if self.mode == "dpms":
            subprocess.run(["kscreen-doctor", "--dpms", "on"], check=False)
        elif shutil.which("brightnessctl"):
            subprocess.run(["brightnessctl", "-q", "set", self.saved or "50%"], check=False)


# ------------------------------------------------------------ main loop
def toggle_existing():
    """If screen-off is already running, stop it (screen back on) and return True."""
    try:
        pid = int(PIDFILE.read_text())
    except (OSError, ValueError):
        return False
    if pid != os.getpid() and pid_alive(pid):
        os.kill(pid, signal.SIGTERM)
        return True
    return False


def run(args):
    conf = read_conf(ETC / "features.conf")
    idle_needed = int(conf.get("screen_off_idle_seconds", "15") or 15)
    overnight = args.overnight or is_on(conf, "screen_off_overnight")
    dirs = default_watch_dirs()

    io = IoMonitor()
    io.busy()  # first sample
    time.sleep(2)
    if not args.force and not tasks_running(dirs, args.pid, io=io):
        notify("Nothing running", "No download or copy found, so the screen stays on.")
        return 1

    RUNTIME.mkdir(parents=True, exist_ok=True)
    PIDFILE.write_text(str(os.getpid()))
    inhibit = subprocess.Popen(
        ["systemd-inhibit", "--what=sleep:idle", "--who=Gill-OSaab", "--why=Screen-off task running",
         "sleep", "infinity"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) \
        if shutil.which("systemd-inhibit") else None

    display = Display()
    stopped = {"early": False}

    def stop(*_):
        stopped["early"] = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    log("screen-off", f"screen off (mode={display.mode}, overnight={overnight})")
    display.off()
    idle = 0
    try:
        while not stopped["early"]:
            time.sleep(5)
            idle = 0 if tasks_running(dirs, args.pid, io=io) else idle + 5
            if idle >= idle_needed:
                break
    finally:
        display.on()
        if inhibit:
            inhibit.terminate()
        PIDFILE.unlink(missing_ok=True)

    if stopped["early"]:
        log("screen-off", "stopped early")
        return 0
    notify("Done", "Your download or copy has finished.")
    log("screen-off", "tasks finished")
    if overnight:
        time.sleep(10)
        subprocess.run(["systemctl", "suspend"], check=False)
    return 0


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--overnight", action="store_true")
    parser.add_argument("--pid", type=int)
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args(argv)
    if toggle_existing():
        return 0
    return run(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
